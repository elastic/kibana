{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__github.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/warn-github-mcp.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/strip-review-event.mjs"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/reviewer_time_budget.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-size-guard.mjs"
          }
        ]
      }
    ]
  },
  "env": {
    "PR_SIZE_SOFT_LINES": "500",
    "PR_SIZE_SOFT_FILES": "15",
    "PR_SIZE_DEBOUNCE_SECS": "30"
  }
}
