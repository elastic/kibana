{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "target/types",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "kibana.d.ts",
    "package.json",
    "oxlint.config.mts",
    ".oxlint/**/*.mts",
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/babel-preset",
  ],
  "exclude": [
    "target/**/*",
  ]
}
