{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.js"
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/logging",
    "@kbn/logging-mocks",
    "@kbn/repo-info",
    "@kbn/setup-node-env"
  ]
}
