{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/i18n",
    "@kbn/use-observable",
    "@kbn/ui-chrome-layout",
    "@kbn/core-chrome-sidebar",
    "@kbn/core-chrome-sidebar-context",
    "@kbn/zod",
    "@kbn/core-chrome-sidebar-internal",
    "@kbn/core-chrome-browser-context",
    "@kbn/core-chrome-browser-mocks",
    "@kbn/core-chrome-browser-hooks",
  ]
}
