{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "kbn_references": [
    "@kbn/safer-lodash-set",
    "@kbn/logging",
    "@kbn/config-schema",
    "@kbn/core-base-server-internal",
    "@kbn/core-logging-common-internal",
    "@kbn/logging-ecs",
    "@kbn/core-logging-server",
    "@kbn/logging-mocks",
    "@kbn/std",
    "@kbn/utility-types-jest",
    "@kbn/utility-types",
    "@kbn/security-hardening",
    "@kbn/telemetry",
    "@kbn/vitest",
  ],
  "exclude": [
    "target/**/*",
  ]
}
