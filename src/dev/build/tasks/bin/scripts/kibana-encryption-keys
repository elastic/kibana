#!/bin/sh
SCRIPT=$0

# SCRIPT may be an arbitrarily deep series of symlinks. Loop until we have the concrete path.
while [ -h "$SCRIPT" ] ; do
  ls=$(ls -ld "$SCRIPT")
  # Drop everything prior to ->
  link=$(expr "$ls" : '.*-> \(.*\)$')
  if expr "$link" : '/.*' > /dev/null; then
    SCRIPT="$link"
  else
    SCRIPT=$(dirname "$SCRIPT")/"$link"
  fi
done

DIR="$(dirname "${SCRIPT}")/.."
. "$DIR/bin/kibana_env"
{{#darwin}}
NODE="${DIR}/node/default/bin/node"
{{/darwin}}
{{#linux}}
if [ -n "$KBN_NODE_HOME" ]; then
  NODE="${KBN_NODE_HOME}/bin/node"
else
  NODE="${DIR}/node/glibc-217/bin/node"
fi
{{/linux}}
test -x "$NODE"
if [ ! -x "$NODE" ]; then
  echo "unable to find usable node.js executable."
  exit 1
fi

NODE_OPTIONS="$KBN_NODE_OPTS $NODE_OPTIONS" NODE_ENV=production "${NODE}" "${DIR}/node_modules/@kbn/cli/encryption_keys/dist" "$@"
