# The provider and its integrity configuration are copied unchanged from the
# pinned Chainguard FIPS image. Paths are resolved by the Kibana launch scripts.
nodejs_conf = nodejs_init
config_diagnostics = 1

.include $ENV::OPENSSL_CONF_INCLUDE/fipsmodule.cnf

[nodejs_init]
providers = provider_sect
alg_section = algorithm_sect
random = random_sect

[provider_sect]
fips = fips_sect
base = base_sect

[base_sect]
activate = 1

[algorithm_sect]
default_properties = fips=yes

[random_sect]
seed = JITTER
properties = fips=yes
