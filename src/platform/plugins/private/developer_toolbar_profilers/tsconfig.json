{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": ["jest", "node", "react", "@testing-library/jest-dom"]
  },
  "include": ["common/**/*.ts", "public/**/*.ts", "public/**/*.tsx", "server/**/*.ts"],
  "exclude": ["target/**/*"],
  "kbn_references": [
    "@kbn/core",
    "@kbn/core-http-browser",
    "@kbn/config-schema",
    "@kbn/developer-toolbar-plugin",
    "@kbn/i18n"
  ]
}
