{
  "type": "plugin",
  "id": "@kbn/dev-comments-plugin",
  "owner": "@elastic/appex-sharedux",
  "group": "platform",
  "description": "Development-only in-page comments for reviewing UI: pinned to elements, stored in Elasticsearch, launched from the developer toolbar.",
  "visibility": "private",
