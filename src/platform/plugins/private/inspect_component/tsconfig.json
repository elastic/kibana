{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node",
      "react",
      "@testing-library/jest-dom",
      "@testing-library/react"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/config-schema",
    "@kbn/repo-info",
    "@kbn/core-http-router-server-mocks",
    "@kbn/developer-toolbar-plugin",
    "@kbn/ui-developer-toolbar"
  ]
}
