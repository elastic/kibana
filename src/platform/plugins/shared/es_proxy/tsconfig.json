{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "common/**/*",
    "public/**/*",
    "server/**/*",
    "test/**/*",
    "../../../../../typings/**/*"
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/config-schema",
    "@kbn/core-http-router-server-internal",
    "@kbn/core-http-browser",
    "@kbn/core-http-router-server-mocks",
    "@kbn/core-elasticsearch-client-server-mocks",
    "@kbn/scout"
  ]
}
