{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    // Tests run on Vitest; public/mocks.ts, server/mocks.ts and data_view.stub.ts are still
    // consumed by packages on Jest, so both sets of globals are needed until those migrate.
    "types": [
      "node",
      "vitest/globals",
      "jest",
      "flot",
      "@emotion/jest",
      "@testing-library/jest-dom/vitest",
      "@testing-library/jest-dom",
      "@kbn/ambient-ui-types",
      "@kbn/ambient-common-types",
      "@kbn/ambient-storybook-types"
    ]
  },
  "include": [
    "common/**/*",
    "public/**/*",
    "server/**/*",
    "config.ts",
    "common/**/*.json",
    "public/**/*.json",
    "server/**/*.json"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/data-views-types",
    "@kbn/data-view-validation",
    "@kbn/usage-collection-plugin",
    "@kbn/kibana-utils-plugin",
    "@kbn/field-formats-plugin",
    "@kbn/expressions-plugin",
    "@kbn/core-notifications-browser",
    "@kbn/es-query",
    "@kbn/field-types",
    "@kbn/i18n",
    "@kbn/utility-types",
    "@kbn/core-test-helpers-http-setup-browser",
    "@kbn/config-schema",
    "@kbn/utility-types-jest",
    "@kbn/safer-lodash-set",
    "@kbn/core-http-server",
    "@kbn/content-management-plugin",
    "@kbn/content-management-utils",
    "@kbn/object-versioning",
    "@kbn/core-saved-objects-server",
    "@kbn/logging",
    "@kbn/crypto-browser",
    "@kbn/core-http-browser",
    "@kbn/logging-mocks",
    "@kbn/doc-links",
    "@kbn/core-deprecations-common",
    "@kbn/cps",
    "@kbn/cps-utils",
    "@kbn/as-code-data-views-schema",
    "@kbn/core-http-browser-mocks",
  ],
  "exclude": [
    "target/**/*",
    "vitest.config.ts"
  ]
}
