{
  "inference.document_extraction": {
    "url_params": {
      "error_trace": "__flag__",
      "filter_path": [],
      "human": "__flag__",
      "pretty": "__flag__",
      "timeout": [
        "120s",
        "-1",
        "0"
      ]
    },
    "data_autocomplete_rules": {
      "input": {
        "__one_of": [
          {
            "content": {
              "type": {
                "__one_of": [
                  "image",
                  "pdf"
                ]
              },
              "format": {
                "__one_of": [
                  "base64",
                  "url"
                ]
              },
              "value": ""
            }
          },
          [
            {
              "content": {
                "type": {
                  "__one_of": [
                    "image",
                    "pdf"
                  ]
                },
                "format": {
                  "__one_of": [
                    "base64",
                    "url"
                  ]
                },
                "value": ""
              }
            }
          ]
        ]
      },
      "task_settings": ""
    },
    "methods": [
      "POST"
    ],
    "patterns": [
      "_inference/document_extraction/{inference_id}"
    ],
    "documentation": "https://www.elastic.co/docs/api/doc/elasticsearch/operation/operation-inference-inference",
    "documentation_serverless": "https://www.elastic.co/docs/api/doc/elasticsearch-serverless/operation/operation-inference-inference",
    "availability": {
      "stack": true,
      "serverless": true
    }
  }
}
