{
  "post-fleet-epm-packages-bulk": {
    "methods": [
      "POST"
    ],
    "patterns": [
      "api/fleet/epm/packages/_bulk"
    ],
    "documentation": "https://www.elastic.co/docs/api/doc/kibana/operation/operation-post-fleet-epm-packages-bulk",
    "url_params": {
      "prerelease": "__flag__"
    },
    "data_autocomplete_rules": {
      "allow_outdated_version": {
        "__one_of": [
          true,
          false
        ]
      },
      "force": {
        "__one_of": [
          true,
          false
        ]
      },
      "packages": [
        {
          "name": "",
          "prerelease": {
            "__one_of": [
              true,
              false
            ]
          },
          "version": ""
        }
      ]
    }
  }
}
