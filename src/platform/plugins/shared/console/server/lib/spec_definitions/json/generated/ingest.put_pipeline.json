{
  "ingest.put_pipeline": {
    "url_params": {
      "error_trace": "__flag__",
      "filter_path": [],
      "human": "__flag__",
      "pretty": "__flag__",
      "master_timeout": [
        "30s",
        "-1",
        "0"
      ],
      "timeout": [
        "30s",
        "-1",
        "0"
      ],
      "if_version": ""
    },
    "data_autocomplete_rules": {
      "_meta": {},
      "description": "",
      "on_failure": [
        {
          "__scope_link": "_processor"
        }
      ],
      "processors": [
        {
          "__scope_link": "_processor"
        }
      ],
      "version": "",
      "deprecated": {
        "__one_of": [
          true,
          false
        ]
      },
      "field_access_pattern": {
        "__one_of": [
          "classic",
          "flexible"
        ]
      }
    },
    "methods": [
      "PUT"
    ],
    "patterns": [
      "_ingest/pipeline/{id}"
    ],
    "documentation": "https://www.elastic.co/docs/manage-data/ingest/transform-enrich/ingest-pipelines",
    "documentation_serverless": "https://www.elastic.co/docs/manage-data/ingest/transform-enrich/ingest-pipelines",
    "availability": {
      "stack": true,
      "serverless": true
    }
  }
}
