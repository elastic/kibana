{
  "reindex": {
    "url_params": {
      "error_trace": "__flag__",
      "filter_path": [],
      "human": "__flag__",
      "pretty": "__flag__",
      "refresh": "__flag__",
      "requests_per_second": [
        "-1"
      ],
      "scroll": [
        "5m",
        "-1",
        "0"
      ],
      "slices": [
        "1",
        "auto"
      ],
      "max_docs": "",
      "timeout": [
        "1m",
        "-1",
        "0"
      ],
      "wait_for_active_shards": [
        "1",
        "all",
        "index-setting"
      ],
      "wait_for_completion": "__flag__",
      "require_alias": "__flag__"
    },
    "data_autocomplete_rules": {
      "conflicts": {
        "__one_of": [
          "abort",
          "proceed"
        ]
      },
      "dest": {
        "index": "",
        "op_type": {
          "__one_of": [
            "index",
            "create"
          ]
        },
        "pipeline": "",
        "routing": "",
        "version_type": {
          "__one_of": [
            "internal",
            "external",
            "external_gte"
          ]
        }
      },
      "max_docs": "",
      "script": {
        "__one_of": [
          {
            "source": "",
            "id": "",
            "params": {},
            "lang": {
              "__one_of": [
                "painless",
                "expression",
                "mustache",
                "java"
              ]
            },
            "options": {
              "*": ""
            }
          },
          ""
        ]
      },
      "source": {
        "index": "",
        "query": {
          "__scope_link": "GLOBAL.query"
        },
        "remote": {
          "connect_timeout": "",
          "headers": {
            "*": ""
          },
          "host": "",
          "username": "",
          "password": "",
          "api_key": "",
          "socket_timeout": ""
        },
        "size": "",
        "slice": {
          "field": "",
          "id": "",
          "max": ""
        },
        "sort": "",
        "_source": {
          "__one_of": [
            true,
            false,
            {
              "exclude_vectors": {
                "__one_of": [
                  true,
                  false
                ]
              },
              "excludes": "",
              "includes": ""
            },
            ""
          ]
        },
        "runtime_mappings": {
          "*": {
            "fields": {
              "*": {
                "type": {
                  "__one_of": [
                    "boolean",
                    "composite",
                    "date",
                    "double",
                    "geo_point",
                    "geo_shape",
                    "ip",
                    "keyword",
                    "long",
                    "lookup"
                  ]
                }
              }
            },
            "fetch_fields": {
              "__any_of": [
                {
                  "field": "",
                  "format": ""
                },
                ""
              ]
            },
            "format": "",
            "input_field": "",
            "target_field": "",
            "target_index": "",
            "script": {
              "__one_of": [
                {
                  "source": "",
                  "id": "",
                  "params": {},
                  "lang": {
                    "__one_of": [
                      "painless",
                      "expression",
                      "mustache",
                      "java"
                    ]
                  },
                  "options": {
                    "*": ""
                  }
                },
                ""
              ]
            },
            "on_script_error": {
              "__one_of": [
                "fail",
                "continue"
              ]
            },
            "type": {
              "__one_of": [
                "boolean",
                "composite",
                "date",
                "double",
                "geo_point",
                "geo_shape",
                "ip",
                "keyword",
                "long",
                "lookup"
              ]
            }
          }
        }
      }
    },
    "methods": [
      "POST"
    ],
    "patterns": [
      "_reindex"
    ],
    "documentation": "https://www.elastic.co/docs/api/doc/elasticsearch/operation/operation-reindex",
    "documentation_serverless": "https://www.elastic.co/docs/api/doc/elasticsearch-serverless/operation/operation-reindex",
    "availability": {
      "stack": true,
      "serverless": true
