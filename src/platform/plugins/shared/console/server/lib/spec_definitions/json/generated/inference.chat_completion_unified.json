{
  "inference.chat_completion_unified": {
    "url_params": {
      "error_trace": "__flag__",
      "filter_path": [],
      "human": "__flag__",
      "pretty": "__flag__",
      "timeout": [
        "120s",
        "-1",
        "0"
      ]
    },
    "data_autocomplete_rules": {
      "messages": [
        {
          "content": "",
          "role": "",
          "tool_call_id": "",
          "tool_calls": [
            {
              "id": "",
              "function": {
                "arguments": "",
                "name": ""
              },
              "type": ""
            }
          ],
          "reasoning": "",
          "reasoning_details": [
            {
              "format": "",
              "id": "",
              "index": ""
            }
          ]
        }
      ],
      "model": "",
      "max_completion_tokens": "",
      "reasoning": {
        "effort": {
          "__one_of": [
            "xhigh",
            "high",
            "medium",
            "low",
            "minimal",
            "none"
          ]
        },
        "enabled": {
          "__one_of": [
            true,
            false
          ]
        },
        "exclude": {
          "__one_of": [
            true,
            false
          ]
        },
        "summary": {
          "__one_of": [
            "auto",
            "concise",
            "detailed"
          ]
        }
      },
      "stop": [],
      "temperature": "",
      "tool_choice": "",
      "tools": [
        {
          "type": "",
          "function": {
            "description": "",
            "name": "",
            "parameters": "",
            "strict": {
              "__one_of": [
                true,
                false
              ]
            }
          }
        }
      ],
      "top_p": ""
    },
    "methods": [
      "POST"
    ],
    "patterns": [
      "_inference/chat_completion/{inference_id}/_stream"
    ],
    "documentation": "https://www.elastic.co/docs/api/doc/elasticsearch/operation/operation-inference-unified-inference",
    "availability": {
      "stack": true,
      "serverless": true
    }
  }
}
