{
  "post-fleet-epm-packages-pkgname-pkgversion": {
    "methods": [
      "POST"
    ],
    "patterns": [
      "api/fleet/epm/packages/{pkgName}/{pkgVersion}"
    ],
    "documentation": "https://www.elastic.co/docs/api/doc/kibana/operation/operation-post-fleet-epm-packages-pkgname-pkgversion",
    "url_params": {
      "prerelease": "__flag__",
      "ignoreMappingUpdateErrors": "__flag__",
      "skipDataStreamRollover": "__flag__",
      "skipDependencyCheck": "__flag__"
    },
    "data_autocomplete_rules": {
      "allow_outdated_version": {
        "__one_of": [
          true,
          false
        ]
      },
      "force": {
        "__one_of": [
          true,
          false
        ]
      },
      "ignore_constraints": {
        "__one_of": [
          true,
          false
        ]
      }
    }
  }
}
