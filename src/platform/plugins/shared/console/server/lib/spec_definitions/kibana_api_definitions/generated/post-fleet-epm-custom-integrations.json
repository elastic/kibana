{
  "post-fleet-epm-custom-integrations": {
    "methods": [
      "POST"
    ],
    "patterns": [
      "api/fleet/epm/custom_integrations"
    ],
    "documentation": "https://www.elastic.co/docs/api/doc/kibana/operation/operation-post-fleet-epm-custom-integrations",
    "data_autocomplete_rules": {
      "datasets": [
        {
          "name": "",
          "type": {
            "__one_of": [
              "logs",
              "metrics",
              "traces",
              "synthetics",
              "profiles"
            ]
          }
        }
      ],
      "force": {
        "__one_of": [
          true,
          false
        ]
      },
      "integrationName": ""
    }
  }
}
