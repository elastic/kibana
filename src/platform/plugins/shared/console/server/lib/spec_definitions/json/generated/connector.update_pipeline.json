{
  "connector.update_pipeline": {
    "url_params": {
      "error_trace": "__flag__",
      "filter_path": [],
      "human": "__flag__",
      "pretty": "__flag__"
    },
    "data_autocomplete_rules": {
      "pipeline": {
        "extract_binary_content": {
          "__one_of": [
            true,
            false
          ]
        },
        "name": "",
        "reduce_whitespace": {
          "__one_of": [
            true,
            false
          ]
        },
        "run_ml_inference": {
          "__one_of": [
            true,
            false
          ]
        }
      }
    },
    "methods": [
      "PUT"
    ],
    "patterns": [
      "_connector/{connector_id}/_pipeline"
    ],
    "documentation": "https://www.elastic.co/docs/api/doc/elasticsearch/operation/operation-connector-update-pipeline",
    "documentation_serverless": "https://www.elastic.co/docs/api/doc/elasticsearch-serverless/operation/operation-connector-update-pipeline",
    "availability": {
      "stack": true,
      "serverless": true
    }
  }
}
