{
  "CreateAssetCriticalityRecord": {
    "methods": [
      "POST"
    ],
    "patterns": [
      "api/asset_criticality"
    ],
    "documentation": "https://www.elastic.co/docs/api/doc/kibana/operation/operation-CreateAssetCriticalityRecord",
    "data_autocomplete_rules": {
      "refresh": {
        "__one_of": [
          "wait_for"
        ]
      },
      "criticality_level": {
        "__one_of": [
          "low_impact",
          "medium_impact",
          "high_impact",
          "extreme_impact"
        ]
      },
      "id_field": {
        "__one_of": [
          "host.name",
          "user.name",
          "service.name",
          "entity.id"
        ]
      },
      "id_value": ""
    }
  }
}
