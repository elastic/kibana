{
  "ml.validate_detector": {
    "url_params": {
      "error_trace": "__flag__",
      "filter_path": [],
      "human": "__flag__",
      "pretty": "__flag__"
    },
    "data_autocomplete_rules": {
      "by_field_name": "",
      "custom_rules": [
        {
          "actions": {
            "__any_of": [
              "skip_result",
              "skip_model_update"
            ]
          },
          "conditions": [
            {
              "applies_to": {
                "__one_of": [
                  "actual",
                  "typical",
                  "diff_from_typical",
                  "time"
                ]
              },
              "operator": {
                "__one_of": [
                  "gt",
                  "gte",
                  "lt",
                  "lte"
                ]
              },
              "value": ""
            }
          ],
          "scope": {
            "*": {
              "filter_id": "",
              "filter_type": {
                "__one_of": [
                  "include",
                  "exclude"
                ]
              }
            }
          }
        }
      ],
      "detector_description": "",
      "detector_index": "",
      "exclude_frequent": {
        "__one_of": [
          "all",
          "none",
          "by",
          "over"
        ]
      },
      "field_name": "",
      "function": "",
      "over_field_name": "",
      "partition_field_name": "",
      "use_null": {
        "__one_of": [
          true,
          false
        ]
      }
    },
    "methods": [
      "POST"
    ],
    "patterns": [
      "_ml/anomaly_detectors/_validate/detector"
    ],
    "documentation": null,
    "availability": {
      "stack": false,
      "serverless": false
    }
  }
}
