{
  "esql.query": {
    "url_params": {
      "error_trace": "__flag__",
      "filter_path": [],
      "human": "__flag__",
      "pretty": "__flag__",
      "format": [
        "csv",
        "json",
        "tsv",
        "txt",
        "yaml",
        "cbor",
        "smile",
        "arrow"
      ],
      "delimiter": [
        ","
      ],
      "drop_null_columns": "__flag__",
      "allow_partial_results": "__flag__"
    },
    "data_autocomplete_rules": {
      "columnar": {
        "__one_of": [
          true,
          false
        ]
      },
      "filter": {
        "__scope_link": "GLOBAL.query"
      },
      "time_zone": "",
      "locale": "",
      "params": {
        "__one_of": [
          [],
          [
            {
              "*": ""
            }
          ]
        ]
      },
      "profile": {
        "__one_of": [
          true,
          false
        ]
      },
      "query": "",
      "tables": {
        "*": {
          "*": {
            "integer": [],
            "keyword": [],
            "long": [],
            "double": []
          }
        }
      },
      "include_ccs_metadata": {
        "__one_of": [
          true,
          false
        ]
      },
      "include_execution_metadata": {
        "__one_of": [
          true,
          false
        ]
      },
      "settings": {
        "time_zone": "",
        "approximation": {
          "__one_of": [
            {
              "rows": "",
              "confidence_level": ""
            },
            true,
            false
          ]
        },
        "column_metadata": ""
      }
    },
    "methods": [
      "POST"
    ],
    "patterns": [
      "_query"
    ],
    "documentation": "https://www.elastic.co/docs/explore-analyze/query-filter/languages/esql-rest",
    "documentation_serverless": "https://www.elastic.co/docs/explore-analyze/query-filter/languages/esql-rest",
    "availability": {
      "stack": true,
      "serverless": true
    }
  }
}
