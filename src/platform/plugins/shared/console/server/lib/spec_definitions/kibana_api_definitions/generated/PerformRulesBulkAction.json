          "__one_of": [
            "unfilled",
            "in_progress",
            "filled",
            "error"
          ]
        }
      ],
      "gaps_range_end": "",
      "gaps_range_start": "",
      "ids": [],
      "query": "",
      "fill_gaps": {
        "end_date": "",
        "start_date": ""
      },
      "run": {
        "end_date": "",
        "start_date": ""
      },
      "duplicate": {
