        "__one_of": [
          "delete"
        ]
      },
      "edit": [
        {
          "type": {
            "__one_of": [
              "add_tags",
              "delete_tags",
              "set_tags"
            ]
          },
          "value": [],
          "overwrite_data_views": {
            "__one_of": [
              true,
              false
            ]
          }
        }
      ],
      "gap_auto_fill_scheduler_id": "",
      "gap_fill_statuses": [
