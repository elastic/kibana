{
  "post-fleet-cloud-connectors": {
    "methods": [
      "POST"
    ],
    "patterns": [
      "api/fleet/cloud_connectors"
    ],
    "documentation": "https://www.elastic.co/docs/api/doc/kibana/operation/operation-post-fleet-cloud-connectors",
    "data_autocomplete_rules": {
      "accountType": {
        "__one_of": [
          "single-account",
          "organization-account"
        ]
      },
      "cloudProvider": {
        "__one_of": [
          "aws",
          "azure",
          "gcp"
        ]
      },
      "iac_blueprint_id": "",
      "iac_blueprint_version": "",
      "iac_deployment_id": "",
      "iac_key": "",
      "name": "",
      "vars": {}
    }
  }
}
