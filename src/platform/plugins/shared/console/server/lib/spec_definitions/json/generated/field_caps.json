{
  "field_caps": {
    "url_params": {
      "error_trace": "__flag__",
      "filter_path": [],
      "human": "__flag__",
      "pretty": "__flag__",
      "allow_no_indices": "__flag__",
      "expand_wildcards": [
        "all",
        "open",
        "closed",
        "hidden",
        "none"
      ],
      "fields": [],
      "ignore_unavailable": "__flag__",
      "include_unmapped": "__flag__",
      "filters": [],
      "types": "",
      "include_empty_fields": "__flag__"
    },
    "data_autocomplete_rules": {
      "fields": "",
      "index_filter": {
        "__scope_link": "GLOBAL.query"
      },
      "runtime_mappings": {
        "*": {
          "fields": {
            "*": {
              "type": {
                "__one_of": [
                  "boolean",
                  "composite",
                  "date",
                  "double",
                  "geo_point",
                  "geo_shape",
                  "ip",
                  "keyword",
                  "long",
                  "lookup"
                ]
              }
            }
          },
          "fetch_fields": {
            "__any_of": [
              {
                "field": "",
                "format": ""
              },
              ""
            ]
          },
          "format": "",
          "input_field": "",
          "target_field": "",
          "target_index": "",
          "script": {
            "__one_of": [
              {
                "source": "",
                "id": "",
                "params": {},
                "lang": {
                  "__one_of": [
                    "painless",
                    "expression",
                    "mustache",
                    "java"
                  ]
                },
                "options": {
                  "*": ""
                }
              },
              ""
            ]
          },
          "on_script_error": {
            "__one_of": [
              "fail",
              "continue"
            ]
          },
          "type": {
            "__one_of": [
              "boolean",
              "composite",
              "date",
              "double",
              "geo_point",
              "geo_shape",
              "ip",
              "keyword",
              "long",
              "lookup"
            ]
          }
        }
      }
    },
    "methods": [
      "GET",
      "POST"
    ],
    "patterns": [
      "_field_caps",
      "{index}/_field_caps"
    ],
    "documentation": "https://www.elastic.co/docs/api/doc/elasticsearch/operation/operation-field-caps",
    "documentation_serverless": "https://www.elastic.co/docs/api/doc/elasticsearch-serverless/operation/operation-field-caps",
    "availability": {
      "stack": true,
      "serverless": true
    }
  }
}
