{
  "type": "plugin",
  "id": "@kbn/telemetry-plugin",
  "owner": [
    "@elastic/kibana-core"
  ],
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "telemetry",
    "browser": true,
    "server": true,
    "requiredPlugins": [
      "telemetryCollectionManager"
    ],
    "optionalPlugins": [
      "home",
      "screenshotMode",
      "security",
      "usageCollection"
    ],
    "requiredBundles": [
      "kibanaUtils"
    ],
    "enabledOnAnonymousPages": true,
    "extraPublicDirs": [
      "common/constants"
    ]
  }
}