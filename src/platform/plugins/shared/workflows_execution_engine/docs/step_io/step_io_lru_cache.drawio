<?xml version="1.0" encoding="UTF-8"?>
<mxGraphModel dx="1200" dy="850" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- ══════════════════════════════════════════════════════
         TITLE
    ══════════════════════════════════════════════════════ -->
    <mxCell id="title" value="Step IO — LRU Cache Approach"
      style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=17;fontStyle=1;"
      vertex="1" parent="1">
      <mxGeometry x="220" y="6" width="360" height="28" as="geometry"/>
    </mxCell>

    <!-- ══════════════════════════════════════════════════════
         COMPONENTS
    ══════════════════════════════════════════════════════ -->

    <!-- WorkflowExecutionRuntimeManager -->
    <mxCell id="rmgr" value="WorkflowExecutionRuntimeManager&#xa;(orchestrates the execution loop)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;"
      vertex="1" parent="1">
      <mxGeometry x="280" y="45" width="240" height="55" as="geometry"/>
    </mxCell>

    <!-- WorkflowContextManager -->
    <mxCell id="wcm" value="WorkflowContextManager&#xa;resolves needed IDs · builds step context"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=10;"
      vertex="1" parent="1">
      <mxGeometry x="45" y="170" width="215" height="60" as="geometry"/>
    </mxCell>

    <!-- StepExecutionRuntime -->
    <mxCell id="srt" value="StepExecutionRuntime&#xa;(executes one step)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=10;"
      vertex="1" parent="1">
      <mxGeometry x="545" y="170" width="215" height="60" as="geometry"/>
    </mxCell>

    <!-- StepIoService -->
    <mxCell id="svc" value="StepIoService"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;"
      vertex="1" parent="1">
      <mxGeometry x="280" y="305" width="240" height="55" as="geometry"/>
    </mxCell>

    <!-- StepIoCache (LRU) -->
    <mxCell id="cache" value="StepIoCache (LRU)&#xa;byte-bounded in-memory cache&#xa;auto-evicts least-recently-used on overflow"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=10;"
      vertex="1" parent="1">
      <mxGeometry x="25" y="445" width="230" height="80" as="geometry"/>
    </mxCell>

    <!-- WorkflowExecutionState -->
    <mxCell id="state" value="WorkflowExecutionState&#xa;in-memory · per execution&#xa;source of truth for metadata + IO"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=10;"
      vertex="1" parent="1">
      <mxGeometry x="550" y="445" width="215" height="80" as="geometry"/>
    </mxCell>

    <!-- Elasticsearch -->
    <mxCell id="es" value="Elasticsearch&#xa;(step_executions index)"
      style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=11;boundedLbl=1;backgroundOutline=1;size=12;"
      vertex="1" parent="1">
      <mxGeometry x="280" y="608" width="240" height="78" as="geometry"/>
    </mxCell>

    <!-- ══════════════════════════════════════════════════════
         EDGES
         ①–⑤ mark the execution order for one step cycle.
    ══════════════════════════════════════════════════════ -->

    <!-- ① rmgr → wcm: ensureContextReady()
         Pre-warms the LRU before the step runs. -->
    <mxCell id="e1" value="① ensureContextReady()"
      style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;
             exitX=0.15;exitY=1;exitFixed=1;entryX=0.8;entryY=0;entryFixed=1;"
      edge="1" source="rmgr" target="wcm" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ② wcm → svc: rehydrate(ids)
         WCM resolves which predecessor outputs are needed (static analysis
         or all-predecessors fallback), then asks StepIoService to ensure
         they are in the LRU before getContext() runs. -->
    <mxCell id="e2" value="② rehydrate(ids)"
      style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;
             exitX=1;exitY=0.6;exitFixed=1;entryX=0;entryY=0.3;entryFixed=1;"
      edge="1" source="wcm" target="svc" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ③ rmgr → srt: execute step
         Called after ensureContextReady() resolves. -->
    <mxCell id="e3" value="③ execute step"
      style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;
             exitX=0.85;exitY=1;exitFixed=1;entryX=0.5;entryY=0;entryFixed=1;"
      edge="1" source="rmgr" target="srt" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ④ srt → wcm: getContext()  [synchronous]
         All needed outputs are already in the LRU (pre-warmed in ①–②),
         so this call is purely synchronous — no async IO on the hot path. -->
    <mxCell id="e4" value="④ getContext()  [sync — LRU hit]"
      style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;
             exitX=0;exitY=0.5;exitFixed=1;entryX=1;entryY=0.5;entryFixed=1;"
      edge="1" source="srt" target="wcm" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ⑤ srt → svc: write(id, 'output', value)
         Step emits its output; StepIoService fans it out to both the LRU
         and WorkflowExecutionState. -->
    <mxCell id="e5" value="⑤ write(id, &apos;output&apos;, value)"
      style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;
             exitX=0.2;exitY=1;exitFixed=1;entryX=0.85;entryY=0;entryFixed=1;"
      edge="1" source="srt" target="svc" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- svc ↔ cache: get(id) on read; set(id, bytes) on write
         Bidirectional: StepIoService reads from and writes to the LRU.
         On write, LRU may immediately evict the oldest entry if over budget. -->
    <mxCell id="e6" value="get(id) / set(id, bytes)"
      style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;
             exitX=0;exitY=0.4;exitFixed=1;entryX=1;entryY=0.2;entryFixed=1;
             endArrow=open;startArrow=open;"
      edge="1" source="svc" target="cache" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- svc ↔ state: setStepIo() on write; state fallback on LRU miss
         Every output is written to WorkflowExecutionState for durability.
         State is also the fallback source when an output has been evicted
         from the LRU (safety net — should not happen on the hot path). -->
    <mxCell id="e7" value="setStepIo() / state fallback on miss"
      style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;
             exitX=1;exitY=0.4;exitFixed=1;entryX=0;entryY=0.2;entryFixed=1;
             endArrow=open;startArrow=open;"
      edge="1" source="svc" target="state" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- svc → es: mget(missing ids)  [dashed — only when LRU has a cache miss]
         rehydrate() finds IDs absent from the LRU and fetches them via
         ES mget (through StepExecutionRepository). Results are inserted
         back into the LRU before the step runs. -->
    <mxCell id="e8" value="mget(missing ids) → populate cache"
      style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;
             dashed=1;exitX=0.4;exitY=1;exitFixed=1;entryX=0.4;entryY=0;entryFixed=1;"
      edge="1" source="svc" target="es" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- state → es: flush() — persist pending outputs to Elasticsearch -->
    <mxCell id="e9" value="flush() — persist outputs"
      style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;
             exitX=0.5;exitY=1;exitFixed=1;entryX=0.75;entryY=0;entryFixed=1;"
      edge="1" source="state" target="es" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ══════════════════════════════════════════════════════
         LEGEND
    ══════════════════════════════════════════════════════ -->
    <mxCell id="legend" value="① – ⑤  execution order per step&#xa;────   normal data flow&#xa;╌╌╌╌   only on LRU cache miss"
      style="text;html=1;strokeColor=#cccccc;fillColor=#f9f9f9;align=left;
             verticalAlign=top;spacingLeft=6;fontSize=9;rounded=1;"
      vertex="1" parent="1">
      <mxGeometry x="600" y="610" width="185" height="55" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
