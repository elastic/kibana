{
  "type": "plugin",
  "id": "@kbn/workflows-execution-engine",
  "owner": ["@elastic/workflows-eng"],
  "group": "platform",
  "visibility": "shared",
  "description": "Stateless execution engine for workflows.",
  "plugin": {
    "configPath": ["workflowsExecutionEngine"],
    "id": "workflowsExecutionEngine",
    "browser": false,
    "server": true,
    "tasks": { "requiredPlugins": ["taskManager", "workflowsExtensions", "licensing", "spaces"] },
    "requiredPlugins": [
      "taskManager",
      "actions",
      "workflowsExtensions",
      "licensing"
    ],
    "optionalPlugins": [
      "usageApi",
      "cloud",
      "spaces",
    ],
  }
}
