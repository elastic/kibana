{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
  },
  "include": [
    "common/**/*",
    "demos/**/*",
    "public/**/*",
    "server/**/*",
    "index.ts",
    "../../../../../typings/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/kibana-utils-common",
    "@kbn/kibana-utils-server",
    "@kbn/kibana-utils-browser",
    "@kbn/test-jest-helpers",
  ],
  "exclude": [
    "target/**/*",
  ]
}
