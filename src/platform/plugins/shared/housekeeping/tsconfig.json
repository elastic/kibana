{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "common/**/*",
    "public/**/*",
    "server/**/*",
    "../../../../../typings/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/config-schema",
    "@kbn/features-plugin",
    "@kbn/i18n",
    "@kbn/management-plugin",
    "@kbn/app-header",
    "@kbn/flyout-meta-blocks",
    "@kbn/content-list",
    "@kbn/content-list-provider",
    "@kbn/content-list-provider-client",
    "@kbn/content-management-table-list-view-common",
    "@kbn/react-kibana-mount",
    "@kbn/react-kibana-context-render",
    "@kbn/ui-callout",
    "@kbn/share-plugin",
    "@kbn/console-plugin",
    "@kbn/agent-builder-browser"
  ],
  "exclude": [
    "target/**/*"
  ]
}
