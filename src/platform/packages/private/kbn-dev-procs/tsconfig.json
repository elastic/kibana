{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "target/**/*",
  ],
  "kbn_references": [
    "@kbn/check-kibana-settings-cli",
    "@kbn/config",
    "@kbn/dev-cli-runner",
    "@kbn/dev-cli-errors",
    "@kbn/repo-info",
    "@kbn/tooling-log",
  ]
}
