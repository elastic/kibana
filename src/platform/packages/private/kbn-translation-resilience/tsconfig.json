{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node",
      "@kbn/ambient-ui-types"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.js"
  ],
  "exclude": [
    "**/*.config.js",
    "target/**/*",
    "target_translation_resilience/**/*"
  ],
  "kbn_references": [
    "@kbn/repo-info"
  ]
}
