{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "stripInternal": true,
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "src/jest_flags.json"
  ],
  "exclude": [
    "types/**/*",
    "**/__fixtures__/**/*",
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/dev-validation-runner",
    "@kbn/std",
    "@kbn/tooling-log",
    "@kbn/get-repo-files",
    "@kbn/peggy",
    "@kbn/dev-cli-runner",
    "@kbn/dev-cli-errors",
    "@kbn/ci-stats-reporter",
    "@kbn/repo-info",
    "@kbn/dev-proc-runner",
    "@kbn/swc-register",
    "@kbn/swc-config",
    "@kbn/repo-packages",
    "@kbn/scout-info",
    "@kbn/react-mute-legacy-root-warning",
    "@kbn/dot-text",
    "@kbn/moon",
    "@kbn/test-es-server"
  ]
}
