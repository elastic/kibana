{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.js"
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/repo-info",
    "@kbn/jest",
    "@kbn/peggy",
    "@kbn/i18n",
    "@kbn/react-mute-legacy-root-warning",
    "@kbn/json-ast",
    "@kbn/swc-config",
  ]
}
