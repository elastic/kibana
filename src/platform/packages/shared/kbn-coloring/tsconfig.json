{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node",
      "react",
      "@kbn/ambient-ui-types",
      "@kbn/ambient-common-types",
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
  ],
  "kbn_references": [
    "@kbn/i18n",
    "@kbn/interpreter",
    "@kbn/utility-types",
    "@kbn/data-plugin",
    "@kbn/palettes",
    "@kbn/field-formats-common",
    "@kbn/expressions-plugin",
  ],
  "exclude": [
    "target/**/*",
  ]
}
