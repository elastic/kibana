{
  "title": "Root filters",
  "filters": [
    {
      "type": "condition",
      "condition": {
        "field": "status",
        "operator": "is",
        "value": "active"
      }
    },
    {
      "type": "condition",
      "condition": {
        "field": "host.name",
        "operator": "is",
        "value": "web-01"
      }
    },
    {
      "type": "group",
      "group": {
        "operator": "and",
        "conditions": [
          {
            "field": "status",
            "operator": "is",
            "value": "active"
          },
          {
            "field": "type",
            "operator": "is",
            "value": "user"
          }
        ]
      }
    },
    {
      "type": "dsl",
      "dsl": {
        "query": {
          "script": {
            "source": "doc.field.value > 0"
          }
        }
      }
    },
    {
      "disabled": false,
      "label": "intersects shape",
      "is_multi_index": true,
      "type": "spatial",
      "dsl": {
        "query": {
          "bool": {
            "should": [
              {
                "bool": {
                  "must": [
                    {
                      "exists": {
                        "field": "DestLocation"
