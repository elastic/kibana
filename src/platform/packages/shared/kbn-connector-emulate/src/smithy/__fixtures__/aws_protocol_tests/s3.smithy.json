      "method": "DELETE",
      "uri": "/my%20key.txt",
      "host": "s3.us-west-2.amazonaws.com",
      "resolvedHost": "mybucket.s3.us-west-2.amazonaws.com",
      "body": "",
      "queryParams": [
       "tagging"
