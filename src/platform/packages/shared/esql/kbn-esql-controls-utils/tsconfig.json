{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/es-query",
    "@kbn/esql-types",
    "@kbn/esql-utils",
    "@kbn/controls-schemas",
    "@kbn/controls-constants",
    "@kbn/presentation-publishing"
  ]
}
