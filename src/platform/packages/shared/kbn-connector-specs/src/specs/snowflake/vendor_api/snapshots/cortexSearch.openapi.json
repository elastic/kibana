{
  "components": {
    "headers": {
      "Link": {
        "schema": {
          "type": "string"
        }
      },
      "X-Snowflake-Request-ID": {
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "parameters": {
      "database": {
        "in": "path",
        "name": "database",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Identifier"
        }
      },
      "fromName": {
        "in": "query",
        "name": "fromName",
        "schema": {
          "type": "string"
        }
      },
      "like": {
        "in": "query",
        "name": "like",
        "schema": {
          "type": "string"
        }
      },
      "schema": {
        "in": "path",
        "name": "schema",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Identifier"
        }
      },
      "showLimit": {
        "in": "query",
        "name": "showLimit",
        "schema": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "responses": {
      "202SuccessAcceptedResponse": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SuccessAcceptedResponse"
            }
          }
        },
        "headers": {
          "Location": {
            "schema": {
              "type": "string"
            }
          },
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "400BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "401Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "403Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "404NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "405MethodNotAllowed": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "408RequestTimeout": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "409Conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "410Gone": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "429LimitExceeded": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "500InternalServerError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "503ServiceUnavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "504GatewayTimeout": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      }
    },
    "schemas": {
      "Column": {
        "type": "string"
      },
      "CortexSearchService": {
        "properties": {
          "attribute_columns": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "comment": {
            "type": "string"
          },
          "created_on": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "data_timestamp": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "database_name": {
            "readOnly": true,
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "indexing_error": {
            "readOnly": true,
            "type": "string"
          },
          "indexing_state": {
            "$ref": "#/components/schemas/SchedulingState"
          },
          "name": {
            "type": "string"
          },
          "schema_name": {
            "readOnly": true,
            "type": "string"
          },
          "search_column": {
            "type": "string"
          },
          "serving_data_bytes": {
            "format": "int64",
            "readOnly": true,
            "type": "integer"
          },
          "serving_state": {
            "$ref": "#/components/schemas/SchedulingState"
          },
          "source_data_num_rows": {
            "format": "int64",
            "readOnly": true,
            "type": "integer"
          },
          "target_lag": {
            "$ref": "#/components/schemas/TargetLag"
          },
          "warehouse": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Diversity": {
        "properties": {
          "group_by": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "max_results": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Functions": {
        "properties": {
          "numeric_boosts": {
            "items": {
              "$ref": "#/components/schemas/NumericBoost"
            },
            "type": "array"
          },
          "query_similarity_boosts": {
            "items": {
              "$ref": "#/components/schemas/QuerySimilarityBoost"
            },
            "type": "array"
          },
          "text_boosts": {
            "items": {
              "$ref": "#/components/schemas/TextBoost"
            },
            "type": "array"
          },
          "time_decays": {
            "items": {
              "$ref": "#/components/schemas/TimeDecay"
            },
            "type": "array"
          },
          "vector_boosts": {
            "items": {
              "$ref": "#/components/schemas/VectorBoost"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Identifier": {
        "pattern": "^\"([^\"]|\"\")+\"|[a-zA-Z_][a-zA-Z0-9_$]*$|^[$][0-9]+$",
        "type": "string"
      },
      "NumericBoost": {
        "properties": {
          "column": {
            "$ref": "#/components/schemas/Column"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "column"
        ],
        "type": "object"
      },
      "QueryRequest": {
        "properties": {
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "experimental": {
            "additionalProperties": true,
            "type": "object"
          },
          "filter": {
            "type": "object"
          },
          "limit": {
            "default": 10,
            "type": "integer"
          },
          "multi_index_query": {
            "additionalProperties": true,
            "type": "object"
          },
          "query": {
            "type": "string"
          },
          "scoring_config": {
            "$ref": "#/components/schemas/ScoringConfig"
          },
          "scoring_profile": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "QueryResponse": {
        "properties": {
          "request_id": {
            "type": "string"
          },
          "results": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "results",
          "request_id"
        ],
        "type": "object"
      },
      "QuerySimilarityBoost": {
        "properties": {
          "cortex_search_service": {
            "type": "string"
          },
          "documents_column": {
            "type": "string"
          },
          "previous_query_column": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RankingWeights": {
        "properties": {
          "reranker": {
            "type": "number"
          },
          "texts": {
            "type": "number"
          },
          "vectors": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "Reranker": {
        "type": "string"
      },
      "RetrievalWeights": {
        "properties": {
          "texts": {
            "type": "number"
          },
          "vectors": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "SchedulingState": {
        "enum": [
          "ACTIVE",
          "SUSPENDED",
          "INITIALIZING"
        ],
        "type": "string"
      },
      "ScoringConfig": {
        "properties": {
          "disable_vector_embedding_query_prefix": {
            "default": false,
            "type": "boolean"
          },
          "diversity": {
            "$ref": "#/components/schemas/Diversity"
          },
          "functions": {
            "$ref": "#/components/schemas/Functions"
          },
          "ranking_weights": {
            "$ref": "#/components/schemas/RankingWeights"
          },
          "reranker": {
            "$ref": "#/components/schemas/Reranker"
          },
          "retrieval_weights": {
            "$ref": "#/components/schemas/RetrievalWeights"
          },
          "weights": {
            "$ref": "#/components/schemas/Weights"
          }
        },
        "type": "object"
      },
      "SuccessAcceptedResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "resultHandler": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TargetLag": {
        "discriminator": {
          "mapping": {
            "DOWNSTREAM": "DownstreamLag",
            "USER_DEFINED": "UserDefinedLag"
          },
          "propertyName": "type"
        },
        "properties": {
          "type": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TextBoost": {
        "properties": {
          "column": {
            "$ref": "#/components/schemas/Column"
          },
          "weight": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "TimeDecay": {
        "properties": {
          "column": {
            "$ref": "#/components/schemas/Column"
          },
          "limit_hours": {
            "type": "number"
          },
          "now": {
            "format": "date-time",
            "type": "string"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "column"
        ],
        "type": "object"
      },
      "VectorBoost": {
        "properties": {
          "column": {
            "$ref": "#/components/schemas/Column"
          },
          "disable_vector_embedding_query_prefix": {
            "default": false,
            "type": "boolean"
          },
          "weight": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "Weights": {
        "properties": {
          "reranker": {
            "type": "number"
          },
          "texts": {
            "type": "number"
          },
          "vectors": {
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "ExternalOAuth": {
        "$ref": "#/components/securitySchemes/specifications_common_ExternalOAuth"
      },
      "KeyPair": {
        "$ref": "#/components/securitySchemes/specifications_common_KeyPair"
      },
      "ProgrammaticAccessToken": {
        "$ref": "#/components/securitySchemes/specifications_common_ProgrammaticAccessToken"
      },
      "SnowflakeOAuth": {
        "$ref": "#/components/securitySchemes/specifications_common_SnowflakeOAuth"
      },
      "specifications_common_ExternalOAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "specifications_common_KeyPair": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "specifications_common_ProgrammaticAccessToken": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "specifications_common_SnowflakeOAuth": {
        "flows": {
          "implicit": {
            "authorizationUrl": "/oauth/authorize",
            "scopes": {}
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "Cortex Search REST API"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/v2/databases/{database}/schemas/{schema}/cortex-search-services": {
      "get": {
        "operationId": "listCortexSearchServices",
        "parameters": [
          {
            "$ref": "#/components/parameters/database"
          },
          {
            "$ref": "#/components/parameters/schema"
          },
          {
            "$ref": "#/components/parameters/like"
          },
          {
            "$ref": "#/components/parameters/fromName"
          },
          {
            "$ref": "#/components/parameters/showLimit"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CortexSearchService"
                  },
                  "type": "array"
                }
              }
            },
            "headers": {
              "Link": {
                "$ref": "#/components/headers/Link"
              },
              "X-Snowflake-Request-ID": {
                "$ref": "#/components/headers/X-Snowflake-Request-ID"
              }
            }
          },
          "202": {
            "$ref": "#/components/responses/202SuccessAcceptedResponse"
          },
          "400": {
            "$ref": "#/components/responses/400BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404NotFound"
          },
          "405": {
            "$ref": "#/components/responses/405MethodNotAllowed"
          },
          "408": {
            "$ref": "#/components/responses/408RequestTimeout"
          },
          "409": {
            "$ref": "#/components/responses/409Conflict"
          },
          "410": {
            "$ref": "#/components/responses/410Gone"
          },
          "429": {
            "$ref": "#/components/responses/429LimitExceeded"
          },
          "500": {
            "$ref": "#/components/responses/500InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/503ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/504GatewayTimeout"
          }
        }
      }
    },
    "/api/v2/databases/{database}/schemas/{schema}/cortex-search-services/{service_name}:query": {
      "post": {
        "operationId": "queryCortexSearchService",
        "parameters": [
          {
            "$ref": "#/components/parameters/database"
          },
          {
            "$ref": "#/components/parameters/schema"
          },
          {
            "in": "path",
            "name": "service_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404NotFound"
          },
          "405": {
            "$ref": "#/components/responses/405MethodNotAllowed"
          },
          "408": {
            "$ref": "#/components/responses/408RequestTimeout"
          },
          "409": {
            "$ref": "#/components/responses/409Conflict"
          },
          "500": {
            "$ref": "#/components/responses/500InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/503ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/504GatewayTimeout"
          }
        }
      }
    }
  },
  "security": [
    {
      "KeyPair": []
    },
    {
      "ExternalOAuth": []
    },
    {
      "SnowflakeOAuth": []
    },
    {
      "ProgrammaticAccessToken": []
    }
  ]
}
