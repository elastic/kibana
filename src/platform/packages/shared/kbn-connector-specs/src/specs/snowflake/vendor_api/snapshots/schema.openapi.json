{
  "components": {
    "headers": {
      "Link": {
        "schema": {
          "type": "string"
        }
      },
      "X-Snowflake-Request-ID": {
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "parameters": {
      "database": {
        "in": "path",
        "name": "database",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Identifier"
        }
      },
      "fromName": {
        "in": "query",
        "name": "fromName",
        "schema": {
          "type": "string"
        }
      },
      "like": {
        "in": "query",
        "name": "like",
        "schema": {
          "type": "string"
        }
      },
      "showLimit": {
        "in": "query",
        "name": "showLimit",
        "schema": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "startsWith": {
        "in": "query",
        "name": "startsWith",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "202SuccessAcceptedResponse": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SuccessAcceptedResponse"
            }
          }
        },
        "headers": {
          "Location": {
            "schema": {
              "type": "string"
            }
          },
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "400BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "401Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "403Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "404NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "405MethodNotAllowed": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "408RequestTimeout": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "409Conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "410Gone": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "429LimitExceeded": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "500InternalServerError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "503ServiceUnavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      },
      "504GatewayTimeout": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "X-Snowflake-Request-ID": {
            "$ref": "#/components/headers/X-Snowflake-Request-ID"
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Identifier": {
        "pattern": "^\"([^\"]|\"\")+\"|[a-zA-Z_][a-zA-Z0-9_$]*$|^[$][0-9]+$",
        "type": "string"
      },
      "Schema": {
        "properties": {
          "budget": {
            "readOnly": true,
            "type": "string"
          },
          "catalog": {
            "nullable": true,
            "type": "string"
          },
          "catalog_sync": {
            "nullable": true,
            "type": "string"
          },
          "classification_profile": {
            "nullable": true,
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "created_on": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "data_retention_time_in_days": {
            "type": "integer"
          },
          "database_name": {
            "readOnly": true,
            "type": "string"
          },
          "default_ddl_collation": {
            "type": "string"
          },
          "dropped_on": {
            "format": "date-time",
            "nullable": true,
            "readOnly": true,
            "type": "string"
          },
          "enable_data_compaction": {
            "nullable": true,
            "type": "boolean"
          },
          "external_volume": {
            "nullable": true,
            "type": "string"
          },
          "iceberg_merge_on_read_behavior": {
            "nullable": true,
            "type": "string"
          },
          "iceberg_version_default": {
            "nullable": true,
            "type": "integer"
          },
          "is_current": {
            "readOnly": true,
            "type": "boolean"
          },
          "is_default": {
            "readOnly": true,
            "type": "boolean"
          },
          "kind": {
            "default": "PERMANENT",
            "enum": [
              "PERMANENT",
              "TRANSIENT"
            ],
            "type": "string"
          },
          "log_level": {
            "type": "string"
          },
          "managed_access": {
            "default": false,
            "type": "boolean"
          },
          "max_data_extension_time_in_days": {
            "type": "integer"
          },
          "name": {
            "$ref": "#/components/schemas/Identifier"
          },
          "object_visibility": {
            "nullable": true,
            "properties": {
              "privileged_visibility": {
                "nullable": true,
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "options": {
            "readOnly": true,
            "type": "string"
          },
          "owner": {
            "readOnly": true,
            "type": "string"
          },
          "owner_role_type": {
            "readOnly": true,
            "type": "string"
          },
          "pipe_execution_paused": {
            "type": "boolean"
          },
          "replace_invalid_characters": {
            "nullable": true,
            "type": "boolean"
          },
          "retention_time": {
            "readOnly": true,
            "type": "integer"
          },
          "serverless_task_max_statement_size": {
            "type": "string"
          },
          "serverless_task_min_statement_size": {
            "type": "string"
          },
          "storage_serialization_policy": {
            "nullable": true,
            "type": "string"
          },
          "suspend_task_after_num_failures": {
            "type": "integer"
          },
          "trace_level": {
            "type": "string"
          },
          "user_task_managed_initial_warehouse_size": {
            "type": "string"
          },
          "user_task_timeout_ms": {
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "SuccessAcceptedResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "resultHandler": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "ExternalOAuth": {
        "$ref": "#/components/securitySchemes/specifications_common_ExternalOAuth"
      },
      "KeyPair": {
        "$ref": "#/components/securitySchemes/specifications_common_KeyPair"
      },
      "ProgrammaticAccessToken": {
        "$ref": "#/components/securitySchemes/specifications_common_ProgrammaticAccessToken"
      },
      "SnowflakeOAuth": {
        "$ref": "#/components/securitySchemes/specifications_common_SnowflakeOAuth"
      },
      "specifications_common_ExternalOAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "specifications_common_KeyPair": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "specifications_common_ProgrammaticAccessToken": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "specifications_common_SnowflakeOAuth": {
        "flows": {
          "implicit": {
            "authorizationUrl": "/oauth/authorize",
            "scopes": {}
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "Snowflake Schema API"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v2/databases/{database}/schemas": {
      "get": {
        "operationId": "listSchemas",
        "parameters": [
          {
            "$ref": "#/components/parameters/database"
          },
          {
            "$ref": "#/components/parameters/like"
          },
          {
            "$ref": "#/components/parameters/startsWith"
          },
          {
            "$ref": "#/components/parameters/showLimit"
          },
          {
            "$ref": "#/components/parameters/fromName"
          },
          {
            "in": "query",
            "name": "history",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Schema"
                  },
                  "type": "array"
                }
              }
            },
            "headers": {
              "Link": {
                "$ref": "#/components/headers/Link"
              },
              "X-Snowflake-Request-ID": {
                "$ref": "#/components/headers/X-Snowflake-Request-ID"
              }
            }
          },
          "202": {
            "$ref": "#/components/responses/202SuccessAcceptedResponse"
          },
          "400": {
            "$ref": "#/components/responses/400BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404NotFound"
          },
          "405": {
            "$ref": "#/components/responses/405MethodNotAllowed"
          },
          "408": {
            "$ref": "#/components/responses/408RequestTimeout"
          },
          "409": {
            "$ref": "#/components/responses/409Conflict"
          },
          "410": {
            "$ref": "#/components/responses/410Gone"
          },
          "429": {
            "$ref": "#/components/responses/429LimitExceeded"
          },
          "500": {
            "$ref": "#/components/responses/500InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/503ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/504GatewayTimeout"
          }
        }
      }
    }
  },
  "security": [
    {
      "KeyPair": []
    },
    {
      "ExternalOAuth": []
    },
    {
      "SnowflakeOAuth": []
    },
    {
      "ProgrammaticAccessToken": []
    }
  ],
  "servers": [
    {
      "url": "https://org-account.snowflakecomputing.com"
    }
  ]
}
