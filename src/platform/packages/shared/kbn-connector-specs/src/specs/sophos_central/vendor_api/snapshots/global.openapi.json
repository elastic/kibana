                        }
                      },
                      "type": "object"
                    },
                    "id": {
                      "type": "string"
                    },
                    "idType": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "401": {}
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://api.central.sophos.com"
    }
