{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Detections API"
  },
  "openapi": "3.0.0",
  "paths": {
    "/queries/detections": {
      "post": {
        "operationId": "startDetectionsRun",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "category": {
                    "items": {
                      "enum": [
                        "cloud",
                        "endpoint",
                        "email",
                        "firewall",
                        "iam",
                        "network",
                        "compound",
                        "backupAndRecovery"
                      ],
                      "type": "string"
                    },
                    "type": "array",
                    "uniqueItems": true
                  },
                  "detectionRule": {
                    "maxLength": 300,
                    "minLength": 0,
                    "pattern": "^[\\p{L}0-9\\s_-]*$",
                    "type": "string"
                  },
                  "deviceName": {
                    "maxLength": 200,
                    "minLength": 0,
                    "pattern": "^[\\p{L}0-9\\s_-]*$",
                    "type": "string"
                  },
                  "entityType": {
                    "maxLength": 200,
                    "minLength": 0,
                    "pattern": "^[\\p{L}\\s]*$",
                    "type": "string"
                  },
                  "from": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "ids": {
                    "items": {
                      "maxLength": 150,
                      "pattern": "^[A-Fa-f0-9_-]+$",
                      "type": "string"
                    },
                    "maxItems": 10,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "location": {
                    "maxLength": 200,
                    "minLength": 0,
                    "pattern": "^[\\p{L}\\s.-]*$",
                    "type": "string"
                  },
                  "mitreAttack": {
                    "type": "string"
                  },
                  "mitreAttackTactics": {
                    "items": {
                      "enum": [
                        "collection",
                        "commandControl",
                        "credentialAccess",
                        "defenseEvasion",
                        "discovery",
                        "execution",
                        "exfiltration",
                        "impact",
                        "initialAccess",
                        "lateralMovement",
                        "persistence",
                        "privilegeEscalation",
                        "reconnaissance",
                        "resourceDevelopment",
                        "undefined"
                      ],
                      "type": "string"
                    },
                    "type": "array",
                    "uniqueItems": true
                  },
                  "observable": {
                    "type": "string"
                  },
                  "operatingSystem": {
                    "items": {
                      "maxLength": 100,
                      "minLength": 0,
                      "pattern": "^[\\p{L}\\s]*$",
                      "type": "string"
                    },
                    "maxItems": 10,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "operatingSystemName": {
                    "maxLength": 200,
                    "minLength": 0,
                    "pattern": "^[\\p{L}0-9\\s._-]*$",
                    "type": "string"
                  },
                  "severity": {
                    "items": {
                      "maximum": 10,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": "array",
                    "uniqueItems": true
                  },
                  "showSuppressed": {
                    "default": false,
                    "type": "boolean"
                  },
                  "sort": {
                    "items": {
                      "properties": {
                        "direction": {
                          "enum": [
                            "asc",
                            "desc"
                          ],
                          "type": "string"
                        },
                        "field": {
                          "enum": [
                            "category",
                            "detectionRule",
                            "entity",
                            "severity",
                            "source",
                            "time",
                            "type",
                            "mitreAttack",
                            "id",
                            "sensorGeneratedAt"
                          ],
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "source": {
                    "maxLength": 200,
                    "minLength": 0,
                    "pattern": "^[\\p{L}0-9\\s]*$",
                    "type": "string"
                  },
                  "to": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "type": {
                    "items": {
                      "enum": [
                        "process",
                        "threat",
                        "vulnerability"
                      ],
                      "type": "string"
                    },
                    "type": "array",
                    "uniqueItems": true
                  },
                  "userName": {
                    "items": {
                      "maxLength": 300,
                      "minLength": 0,
                      "pattern": "^[\\p{L}\\s_-]*$",
                      "type": "string"
                    },
                    "maxItems": 10,
                    "type": "array",
                    "uniqueItems": true
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "createdAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "expiresAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "finishedAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "id": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "result": {
                      "enum": [
                        "succeeded",
                        "canceled",
                        "failed",
                        "notAvailable",
                        "timedOut"
                      ],
                      "type": "string"
                    },
                    "resultCount": {
                      "type": "integer"
                    },
                    "status": {
                      "enum": [
                        "finished",
                        "pending",
                        "started"
                      ],
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "correlationId": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "createdAt": {
                      "format": "datetime",
                      "type": "string"
                    },
                    "docUrl": {
                      "format": "uri",
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "correlationId": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "createdAt": {
                      "format": "datetime",
                      "type": "string"
                    },
                    "docUrl": {
                      "format": "uri",
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "403": {
