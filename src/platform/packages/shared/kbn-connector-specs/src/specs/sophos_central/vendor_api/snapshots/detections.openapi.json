                              },
                              "type": {
                                "enum": [
                                  "computer",
                                  "sensor",
                                  "server"
                                ],
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "entities": {
                            "items": {
                              "properties": {
                                "attributes": {
                                  "type": "object"
                                },
                                "category": {
                                  "enum": [
                                    "impacted",
                                    "observed"
                                  ],
                                  "type": "string"
                                },
                                "id": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "type": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id",
                                "type",
                                "category"
                              ],
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "geolocation": {
