                      "type": "string"
                    },
                    "docUrl": {
                      "format": "uri",
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "correlationId": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "createdAt": {
                      "format": "datetime",
                      "type": "string"
                    },
                    "docUrl": {
                      "format": "uri",
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "correlationId": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "createdAt": {
                      "format": "datetime",
                      "type": "string"
                    },
                    "docUrl": {
                      "format": "uri",
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
