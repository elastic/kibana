  "info": {
    "title": "Issues APIs"
  },
  "openapi": "3.0.0",
  "paths": {
    "/public_api/v1/issue/search": {
      "post": {
        "operationId": "getIssues",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-xdr-auth-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "request_data": {
                    "properties": {
                      "filters": {
                        "items": {
                          "properties": {
                            "field": {
                              "enum": [
                                "id",
                                "external_id",
                                "detection.method",
                                "issue_domain",
                                "severity",
                                "_insert_time",
                                "last_modified",
                                "status.progress",
                                "assigned_to",
                                "assigned_to_pretty",
                                "observation_time",
                                "category",
                                "detection.rule_id",
                                "asset_ids",
                                "asset_names",
                                "asset_classes",
                                "asset_group_ids",
                                "asset_categories",
                                "asset_regions",
                                "asset_providers",
                                "asset_accounts",
                                "asset_types",
                                "asset_external_provider_ids",
                                "asset_cloud_account_names",
                                "xdm.compliance.standard_id",
                                "xdm.compliance.category_id",
                                "xdm.compliance.control_id",
                                "xdm.policy_id",
                                "asset_group_names",
                                "asset_tags",
                                "xdm.resolution_sla",
                                "xdm.resolution_timer"
                              ],
                              "type": "string"
                            },
                            "operator": {
                              "enum": [
                                "in",
                                "gte",
                                "lte",
                                "gt",
                                "lt"
                              ],
                              "type": "string"
                            },
                            "value": {
                              "oneOf": [
                                {
                                  "items": {
                                    "type": "integer"
                                  },
                                  "type": "array"
                                },
                                {
                                  "items": {
                                    "type": "string"
                                  },
                                  "type": "array"
                                },
                                {
                                  "type": "integer"
                                },
                                {
                                  "type": "string"
                                }
                              ]
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "include_actions": {
                        "default": false,
                        "type": "boolean"
                      },
                      "include_evidences": {
                        "default": false,
                        "type": "boolean"
                      },
                      "include_fields": {
                        "default": [],
                        "items": {
                          "enum": [
                            "normalized_fields",
                            "custom_fields"
                          ],
                          "type": "string"
