  "openapi": "3.0.0",
  "paths": {
    "/public_api/v1/case/artifacts/{case-id}/": {
      "get": {
        "operationId": "getCaseArtifacts",
        "parameters": [
          {
            "in": "path",
            "name": "case-id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-xdr-auth-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CaseArtifact"
                  },
                  "type": "array"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/public_api/v1/case/search": {
      "post": {
        "operationId": "getCases",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-xdr-auth-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "request_data": {
                    "properties": {
                      "filters": {
                        "items": {
                          "properties": {
                            "field": {
                              "enum": [
                                "case_id",
                                "starred",
                                "case_domain",
                                "severity",
                                "creation_time",
                                "last_update_time",
                                "modification_time",
                                "status_progress",
                                "assigned_user",
                                "assigned_user_pretty",
                                "asset_ids",
                                "asset_names",
                                "asset_classes",
                                "asset_group_ids",
                                "asset_categories",
                                "asset_regions",
                                "asset_providers",
                                "asset_accounts",
                                "asset_types",
                                "asset_cloud_account_names",
                                "asset_external_provider_ids",
                                "asset_group_names",
                                "asset_tags",
                                "resolution_timer",
                                "resolution_sla"
                              ],
                              "type": "string"
                            },
                            "operator": {
                              "enum": [
                                "in",
                                "nin",
                                "gte",
                                "lte",
                                "eq",
                                "contains",
                                "not_contains",
                                "neq",
                                "json_eq",
                                "json_neq",
                                "gt",
                                "lt"
                              ],
                              "type": "string"
                            },
                            "value": {
                              "oneOf": [
                                {
                                  "items": {
                                    "type": "integer"
                                  },
                                  "type": "array"
                                },
                                {
                                  "items": {
                                    "type": "string"
                                  },
                                  "type": "array"
                                },
                                {
                                  "type": "integer"
                                },
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "boolean"
                                },
                                {
                                  "properties": {
                                    "key": {
                                      "type": "string"
                                    },
                                    "value": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "key",
                                    "value"
                                  ],
                                  "type": "object"
                                }
                              ]
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "search_from": {
                        "default": 0,
                        "type": "integer"
                      },
                      "search_to": {
                        "default": 100,
                        "type": "integer"
                      },
                      "sort": {
                        "properties": {
                          "field": {
                            "enum": [
                              "case_id",
                              "severity",
                              "creation_time",
                              "modification_time",
                              "resolution_timer",
                              "resolution_sla"
                            ],
                            "type": "string"
                          },
                          "keyword": {
                            "enum": [
                              "asc",
                              "desc"
                            ],
                            "type": "string"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "reply": {
                      "properties": {
                        "DATA": {
                          "items": {
                            "$ref": "#/components/schemas/Case"
                          },
                          "type": "array"
                        },
                        "FILTER_COUNT": {
                          "type": "integer"
                        },
                        "TOTAL_COUNT": {
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/public_api/v1/case/update/{case-id}": {
      "post": {
        "operationId": "updateCase",
        "parameters": [
          {
            "in": "path",
            "name": "case-id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-xdr-auth-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "request_data": {
                    "properties": {
                      "update_data": {
                        "$ref": "#/components/schemas/UpdateCase"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {},
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
