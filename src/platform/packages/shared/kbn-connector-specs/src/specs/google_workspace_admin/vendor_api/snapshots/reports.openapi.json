  "info": {
    "title": "Admin SDK API"
  },
  "openapi": "3.0.3",
  "paths": {
    "/admin/reports/v1/activity/users/{userKey}/applications/{applicationName}": {
      "get": {
        "operationId": "reports.activities.list",
        "parameters": [
          {
            "in": "path",
            "name": "userKey",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "applicationName",
            "required": true,
            "schema": {
              "enum": [
                "access_transparency",
                "admin",
                "calendar",
                "chat",
                "drive",
                "gcp",
                "gmail",
                "gplus",
                "groups",
                "groups_enterprise",
                "jamboard",
                "login",
                "meet",
                "mobile",
                "rules",
                "saml",
                "token",
                "user_accounts",
                "context_aware_access",
                "chrome",
                "data_studio",
                "keep",
                "vault",
                "gemini_in_workspace_apps",
                "classroom",
                "assignments",
                "cloud_search",
                "tasks",
                "data_migration",
                "meet_hardware",
                "directory_sync",
                "ldap",
                "profile",
                "access_evaluation",
                "admin_data_action",
                "contacts",
                "takeout",
                "graduation",
                "voice",
                "chrome_sync",
                "workspace_studio",
                "gemini_notebook"
              ],
              "pattern": "(access_evaluation)|(access_transparency)|(admin)|(admin_data_action)|(assignments)|(calendar)|(chat)|(chrome)|(classroom)|(cloud_search)|(contacts)|(context_aware_access)|(data_studio)|(data_migration)|(directory_sync)|(drive)|(gcp)|(gmail)|(gplus)|(graduation)|(groups)|(groups_enterprise)|(jamboard)|(keep)|(ldap)|(login)|(meet)|(meet_hardware)|(mobile)|(profile)|(rules)|(saml)|(token)|(user_accounts)|(vault)|(gemini_in_workspace_apps)|(tasks)|(takeout)|(voice)|(chrome_sync)|(workspace_studio)|(gemini_notebook)",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "access_token",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "callback",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "alt",
            "schema": {
              "default": "json",
              "enum": [
                "json",
                "media",
                "proto"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "oauth_token",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "quotaUser",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "upload_protocol",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "key",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "prettyPrint",
            "schema": {
              "default": "true",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "$.xgafv",
            "schema": {
              "enum": [
                "1",
                "2"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "fields",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "uploadType",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "maxResults",
            "schema": {
              "default": "1000",
              "format": "int32",
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "eventName",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "orgUnitID",
            "schema": {
              "default": "",
              "pattern": "(id:[a-z0-9]+)",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "actorIpAddress",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "agentInfoFilter",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "statusFilter",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "applicationInfoFilter",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "startTime",
            "schema": {
              "pattern": "(\\d\\d\\d\\d)-(\\d\\d)-(\\d\\d)T(\\d\\d):(\\d\\d):(\\d\\d)(?:\\.(\\d+))?(?:(Z)|([-+])(\\d\\d):(\\d\\d))",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "filters",
            "schema": {
              "pattern": "(.+[<,<=,==,>=,>,<>].+,)*(.+[<,<=,==,>=,>,<>].+)",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "customerId",
            "schema": {
              "pattern": "C.+|my_customer",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "groupIdFilter",
            "schema": {
              "pattern": "(id:[a-z0-9]+(,id:[a-z0-9]+)*)",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "networkInfoFilter",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "includeSensitiveData",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "endTime",
            "schema": {
              "pattern": "(\\d\\d\\d\\d)-(\\d\\d)-(\\d\\d)T(\\d\\d):(\\d\\d):(\\d\\d)(?:\\.(\\d+))?(?:(Z)|([-+])(\\d\\d):(\\d\\d))",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "pageToken",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "resourceDetailsFilter",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "deviceFilter",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activities"
                }
              }
            }
          }
        },
        "security": [
          {
            "Oauth2": [
              "https://www.googleapis.com/auth/admin.reports.audit.readonly"
            ]
          }
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://admin.googleapis.com"
    }
  ]
}
