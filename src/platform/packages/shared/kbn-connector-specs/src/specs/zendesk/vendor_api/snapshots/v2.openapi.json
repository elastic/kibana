  "info": {
    "title": "Support API"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v2/search": {
      "get": {
        "operationId": "ListSearchResults",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort_by",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort_order",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/SearchInclude"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/tickets": {
      "get": {
        "operationId": "ListTickets",
        "parameters": [
          {
            "in": "query",
            "name": "external_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/TicketSortBy"
          },
          {
            "$ref": "#/components/parameters/TicketSortOrder"
          },
          {
            "$ref": "#/components/parameters/TicketSupportTypeScope"
          },
          {
            "$ref": "#/components/parameters/DualPaginationPage"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/CursorPaginationSort"
          },
          {
            "$ref": "#/components/parameters/TicketsInclude"
          },
          {
            "in": "query",
            "name": "start_time",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/tickets/{ticket_id}": {
      "get": {
        "operationId": "ShowTicket",
        "parameters": [
          {
            "$ref": "#/components/parameters/TicketId"
          },
          {
            "$ref": "#/components/parameters/TicketsInclude"
          },
          {
            "in": "query",
            "name": "reduced_payload_size",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "remove_duplicate_fields",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/tickets/{ticket_id}/comments": {
      "get": {
        "operationId": "ListTicketComments",
        "parameters": [
          {
            "in": "query",
            "name": "include_inline_images",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "include",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "in": "query",
            "name": "sort_order",
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/CursorPaginationPage"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketCommentsResponse"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/TicketId"
        }
      ]
    },
    "/api/v2/users/me": {
      "get": {
        "operationId": "ShowCurrentUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/UsersInclude"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://{subdomain}.{domain}.com",
      "variables": {
        "domain": {
          "default": "zendesk"
        },
        "subdomain": {
          "default": "example"
        }
      }
    }
  ]
}
