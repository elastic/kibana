          {
            "in": "query",
            "name": "type",
            "schema": {
              "enum": [
                "alert",
                "annotation"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "matchAny",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/getAnnotationsResponse"
          },
          "400": {
