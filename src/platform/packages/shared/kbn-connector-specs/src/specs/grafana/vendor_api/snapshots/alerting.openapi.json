  "info": {
    "title": "Grafana Alerting API."
  },
  "openapi": "3.0.3",
  "paths": {
    "/alertmanager/grafana/api/v2/alerts": {
      "get": {
        "operationId": "RouteGetGrafanaAMAlerts",
        "parameters": [
          {
            "in": "query",
            "name": "active",
            "schema": {
              "default": true,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "silenced",
            "schema": {
              "default": true,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "inhibited",
            "schema": {
              "default": true,
              "type": "boolean"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "filter",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "receiver",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/gettableAlerts"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/alertmanager/grafana/api/v2/silence/{SilenceId}": {
      "delete": {
        "operationId": "RouteDeleteGrafanaSilence",
        "parameters": [
          {
            "in": "path",
            "name": "SilenceId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "RouteGetGrafanaSilence",
        "parameters": [
          {
            "in": "path",
            "name": "SilenceId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/gettableGrafanaSilence"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/alertmanager/grafana/api/v2/silences": {
      "get": {
        "operationId": "RouteGetGrafanaSilences",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "filter",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "ruleMetadata",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "accesscontrol",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/gettableGrafanaSilences"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "RouteCreateGrafanaSilence",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/postableSilence"
              }
            }
          },
          "required": false
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/postSilencesOKBody"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
