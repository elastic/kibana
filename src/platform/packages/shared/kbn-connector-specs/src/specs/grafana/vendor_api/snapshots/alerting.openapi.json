{
  "components": {
    "schemas": {
      "Ack": {
        "type": "object"
      },
      "AlertQuery": {
        "properties": {
          "datasourceUid": {
            "type": "string"
          },
          "model": {
            "type": "object"
          },
          "queryType": {
            "type": "string"
          },
          "refId": {
            "type": "string"
          },
          "relativeTimeRange": {
            "$ref": "#/components/schemas/RelativeTimeRange"
          }
