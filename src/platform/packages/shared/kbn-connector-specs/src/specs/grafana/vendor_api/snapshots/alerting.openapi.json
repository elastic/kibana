              "$ref": "#/components/schemas/TimeInterval"
            },
            "type": "array"
          }
        },
        "title": "TimeInterval represents a named set of time intervals for which a route should be muted.",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "alertStatus": {
        "properties": {
          "inhibitedBy": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "silencedBy": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "state": {
            "enum": [
              "[unprocessed active suppressed]"
            ],
            "type": "string"
          }
        },
        "required": [
          "inhibitedBy",
          "silencedBy",
          "state"
        ],
        "type": "object"
      },
      "gettableAlert": {
        "properties": {
          "annotations": {
            "$ref": "#/components/schemas/labelSet"
          },
          "endsAt": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "generatorURL": {
            "type": "string"
          },
          "labels": {
            "$ref": "#/components/schemas/labelSet"
          },
          "receivers": {
            "items": {
              "$ref": "#/components/schemas/receiver"
            },
            "type": "array"
          },
          "startsAt": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/alertStatus"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "labels",
          "annotations",
          "endsAt",
          "fingerprint",
          "receivers",
          "startsAt",
          "status",
          "updatedAt"
        ],
        "type": "object"
      },
      "gettableAlerts": {
        "items": {
          "$ref": "#/components/schemas/gettableAlert",
          "type": "object"
        },
        "type": "array"
      },
      "gettableGrafanaSilence": {
        "properties": {
          "accessControl": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object"
          },
          "comment": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "matchers": {
            "$ref": "#/components/schemas/matchers"
          },
          "metadata": {
            "$ref": "#/components/schemas/SilenceMetadata"
          },
          "startsAt": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/silenceStatus"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "comment",
          "createdBy",
          "endsAt",
          "matchers",
          "startsAt",
          "id",
          "status",
          "updatedAt"
        ],
        "type": "object"
      },
      "gettableGrafanaSilences": {
        "items": {
          "$ref": "#/components/schemas/gettableGrafanaSilence"
        },
        "type": "array"
      },
      "labelSet": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "matcher": {
        "properties": {
          "isEqual": {
            "type": "boolean"
          },
          "isRegex": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "isRegex",
          "name",
          "value"
        ],
        "type": "object"
      },
      "matchers": {
        "items": {
          "$ref": "#/components/schemas/matcher"
        },
        "type": "array"
      },
      "postSilencesOKBody": {
        "properties": {
          "silenceID": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "postableSilence": {
        "properties": {
          "comment": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "matchers": {
            "$ref": "#/components/schemas/matchers"
          },
          "startsAt": {
            "type": "string"
          }
        },
        "required": [
          "comment",
          "createdBy",
          "endsAt",
          "matchers",
          "startsAt"
