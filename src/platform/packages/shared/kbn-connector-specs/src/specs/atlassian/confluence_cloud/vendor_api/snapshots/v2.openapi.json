  "paths": {
    "/pages": {
      "get": {
        "operationId": "getPages",
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "required": false,
            "schema": {
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "maxItems": 250,
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "space-id",
            "required": false,
            "schema": {
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "maxItems": 100,
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/PageSortOrder"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "items": {
                "enum": [
                  "current",
                  "archived",
                  "deleted",
                  "trashed"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "title",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "body-format",
            "schema": {
              "$ref": "#/components/schemas/PrimaryBodyRepresentation"
            }
          },
          {
            "in": "query",
            "name": "subtype",
            "required": false,
            "schema": {
              "enum": [
                "live",
                "page"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 25,
              "format": "int32",
              "maximum": 250,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "_links": {
                      "$ref": "#/components/schemas/MultiEntityLinks"
                    },
                    "results": {
                      "items": {
                        "$ref": "#/components/schemas/PageBulk"
                      },
                      "type": "array"
                    }
                  },
                  "title": "MultiEntityResult<Page>",
                  "type": "object"
                }
              }
            },
            "headers": {
              "Link": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {}
          },
          "401": {
            "content": {}
          }
        },
        "security": [
          {
            "basicAuth": []
          },
          {
            "oAuthDefinitions": [
              "read:page:confluence"
            ]
          }
        ]
      }
    },
