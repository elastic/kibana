{
  "createMonitor": {
    "input": {
      "schedule": {
        "period": {
          "interval": 5,
          "unit": "MINUTES"
        }
      },
      "inputs": [
        {
          "search": {
            "indices": ["logs-*"],
            "query": {
              "size": 0,
              "query": {
                "match_all": {}
              }
            }
          }
        }
      ],
      "triggers": [
        {
          "name": "Any hits",
          "severity": "1",
          "condition": {
            "script": {
              "source": "ctx.results[0].hits.total.value > 0",
              "lang": "painless"
            }
          },
          "actions": []
        }
      ]
    }
  },
  "runQuery": {
    "queries": [
      {
        "source": "core",
        "method": "POST",
        "path": "/{index}/_search"
      }
    ]
  },
  "searchDetectors": {
    "queries": [
      {
        "source": "core",
        "method": "POST",
        "path": "/_plugins/_security_analytics/detectors/_search"
      }
    ]
  },
  "searchMonitors": {
    "queries": [
      {
        "source": "alerting",
        "method": "POST",
        "path": "/_plugins/_alerting/monitors/_search"
      }
    ]
  },
  "updateMonitor": {
    "input": {
      "schedule": {
        "period": {
          "interval": 5,
          "unit": "MINUTES"
        }
      }
    }
  }
}
