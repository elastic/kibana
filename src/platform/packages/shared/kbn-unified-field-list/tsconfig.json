{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "node",
      "vitest/globals",
      "jest",
      "flot",
      "@emotion/jest",
      "@testing-library/jest-dom/vitest",
      "@testing-library/jest-dom",
      "@kbn/ambient-ui-types",
      "@kbn/ambient-common-types",
      "@kbn/ambient-storybook-types"
    ]
  },
  "include": ["*.ts", "src/**/*", "test/**/*", "__mocks__/**/*.ts"],
  "kbn_references": [
    "@kbn/i18n",
    "@kbn/data-views-plugin",
    "@kbn/ui-actions-plugin",
    "@kbn/test-jest-helpers",
    "@kbn/analytics",
    "@kbn/i18n-react",
    "@kbn/react-field",
    "@kbn/expressions-plugin",
    "@kbn/core",
    "@kbn/core-lifecycle-browser",
    "@kbn/data-plugin",
    "@kbn/field-formats-plugin",
    "@kbn/charts-plugin",
    "@kbn/datemath",
    "@kbn/es-query",
    "@kbn/es-types",
    "@kbn/field-types",
    "@kbn/data-service",
    "@kbn/data-view-field-editor-plugin",
    "@kbn/dom-drag-drop",
    "@kbn/shared-ux-utility",
    "@kbn/discover-utils",
    "@kbn/ebt-tools",
    "@kbn/shared-ux-button-toolbar",
    "@kbn/field-utils",
    "@kbn/visualization-utils",
    "@kbn/search-types",
    "@kbn/fields-metadata-plugin",
    "@kbn/esql-utils",
    "@kbn/restorable-state",
    "@kbn/css-utils",
    "@kbn/field-formats-common",
    "@kbn/ebt-click",
    "@kbn/scout",
  ],
  "exclude": [
    "target/**/*",
    "vitest.config.ts"
  ]
}
