    "@kbn/field-formats-plugin",
    "@kbn/field-utils",
    "@kbn/i18n",
    "@kbn/kibana-utils-plugin",
    "@kbn/test-jest-helpers",
    "@kbn/unified-data-table",
    "@kbn/unified-doc-viewer",
    "@kbn/utility-types"
  ]
}
