{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // This config mirrors the Oxlint-supported, behaviorally compatible subset of @kbn/eslint-config.
  // Rules are scoped to the same JS, TypeScript, and Jest file patterns as ESLint.
  // @kbn/eslint-config remains the source of truth.
  "env": {"builtin": false, "es6": true},

  "overrides": [
    {
      "files": [
        "**/*.js",
        "**/*.mjs"
      ],
      "env": {
        "es6": true,
        "node": true,
        "mocha": true,
        "browser": true
      },
      "rules": {
        "block-scoped-var": "error",
        "dot-notation": [
          "error",
          {
            "allowKeywords": true
          }
        ],
        "eqeqeq": [
          "error",
          "always",
          {
            "null": "ignore"
          }
        ],
        "guard-for-in": "error",
        "no-caller": "error",
        "no-const-assign": "error",
        "no-debugger": "error",
        "no-empty": "error",
        "no-eval": "error",
        "no-extend-native": "error",
        "no-global-assign": "error",
        "no-irregular-whitespace": "error",
        "no-iterator": "error",
        "no-proto": "error",
        "no-redeclare": "error",
        "no-restricted-globals": [
          "error",
          "addEventListener",
          "blur",
          "close",
          "closed",
          "confirm",
          "defaultStatus",
          "defaultstatus",
          "event",
          "external",
          "find",
          "focus",
          "frameElement",
          "frames",
          "history",
          "innerHeight",
          "innerWidth",
          "length",
          "location",
          "locationbar",
          "menubar",
          "moveBy",
          "moveTo",
          "name",
          "onblur",
          "onerror",
          "onfocus",
          "onload",
          "onresize",
          "onunload",
          "open",
          "opener",
          "opera",
          "outerHeight",
          "outerWidth",
          "pageXOffset",
          "pageYOffset",
          "parent",
          "print",
          "removeEventListener",
          "resizeBy",
          "resizeTo",
          "screen",
          "screenLeft",
          "screenTop",
          "screenX",
          "screenY",
          "scroll",
          "scrollbars",
          "scrollBy",
          "scrollTo",
          "scrollX",
          "scrollY",
          "self",
          "status",
          "statusbar",
          "stop",
          "toolbar",
          "top"
        ],
        "no-restricted-imports": [
          2,
          {
            "paths": [
              "gulp-util"
            ]
          }
        ],
        "no-script-url": "error",
        "no-sequences": "error",
        "no-use-before-define": [
          "error",
          "nofunc"
        ],
        "no-with": "error",
        "valid-typeof": "error",
        "import/default": "error",
        "import/export": "error",
        "import/no-named-as-default": "error",
        "import/no-duplicates": "error",
        "import/no-dynamic-require": "error",
        "no-undef": "error",
        "no-unused-vars": [
          "error",
          {
            "caughtErrors": "none"
          }
        ],
        "no-var": "error",
        "one-var": [
          "error",
          "never"
        ],
        "prefer-const": "error",
        "prefer-object-spread": "error"
      }
    },
    {
      "files": [
        "**/*.{ts,tsx}"
      ],
      "env": {
        "es6": true,
        "node": true,
        "mocha": true,
        "browser": true
      },
      "rules": {
        "@typescript-eslint/adjacent-overload-signatures": "error",
        "@typescript-eslint/no-restricted-types": [
          "error",
          {
            "types": {
              "SFC": "Use FC or FunctionComponent instead.",
              "React.SFC": "Use React.FC instead.",
              "StatelessComponent": "Use FunctionComponent instead.",
              "React.StatelessComponent": "Use React.FunctionComponent instead."
            }
          }
        ],
        "@typescript-eslint/consistent-type-imports": [
          "error",
          {
            "prefer": "type-imports",
            "disallowTypeAnnotations": false,
            "fixStyle": "separate-type-imports"
          }
        ],
        "@typescript-eslint/explicit-member-accessibility": [
          "error",
          {
            "accessibility": "off",
            "overrides": {
              "accessors": "explicit",
              "constructors": "no-public",
              "parameterProperties": "explicit"
            }
          }
        ],
        "@typescript-eslint/prefer-function-type": "error",
        "@typescript-eslint/consistent-type-assertions": "error",
        "@typescript-eslint/no-empty-interface": "error",
        "@typescript-eslint/no-extra-non-null-assertion": "error",
        "@typescript-eslint/no-misused-new": "error",
        "@typescript-eslint/no-namespace": "error",
        "@typescript-eslint/no-shadow": "off",
        "@typescript-eslint/unified-signatures": "error",
        "constructor-super": "error",
        "dot-notation": [
          "error",
          {
            "allowKeywords": true
          }
        ],
        "eqeqeq": [
          "error",
          "always",
          {
            "null": "ignore"
          }
        ],
        "guard-for-in": "error",
        "no-caller": "error",
        "no-cond-assign": "error",
        "no-debugger": "error",
        "no-empty": "error",
        "no-extend-native": "error",
        "no-eval": "error",
        "no-new-wrappers": "error",
        "no-script-url": "error",
        "no-throw-literal": "error",
        "no-unsafe-finally": "error",
        "@typescript-eslint/no-unused-expressions": [
          "error",
          {
            "allowTaggedTemplates": true
          }
        ],
        "no-unused-labels": "error",
        "object-shorthand": "error",
        "prefer-rest-params": "error",
        "radix": "error",
        "use-isnan": "error",
        "no-var": "error",
        "one-var": [
          "error",
          "never"
        ],
        "prefer-const": "error"
      }
    },
    {
      "files": [
        "**/*.d.ts"
      ],
      "rules": {
        "@typescript-eslint/consistent-type-imports": "off"
      }
    },
    {
      "files": [
        "**/*.{test,test.mocks,mock}.{js,mjs,ts,tsx}",
        "**/__mocks__/**/*.{js,mjs,ts,tsx}"
      ],
      "env": {
        "jest": true
      },
      "rules": {
        "jest/no-focused-tests": "error",
        "jest/no-identical-title": "error"
      }
    },
    {
      "files": [
        "scripts/**/*.js",
        "src/setup_node_env/**/*.js"
      ],
      "rules": {
        "no-var": "off",
        "prefer-const": "off",
        "prefer-object-spread": "off"
      }
    },
    {
      "files": [
        "src/platform/packages/shared/kbn-ftr-common-functional-ui-services/services/web_element_wrapper/scroll_into_view_if_necessary.js",
        "**/browser_exec_scripts/**/*.js"
      ],
      "rules": {
        "no-var": "off",
        "prefer-const": "off",
        "prefer-object-spread": "off"
      }
    },
    {
      "files": [
        "src/platform/packages/shared/kbn-safer-lodash-set/**/*.{js,mjs,ts,tsx}"
      ],
      "globals": {
        "hasOwnProperty": "readonly"
      },
      "rules": {
        "no-var": "off",
        "one-var": "off"
      }
    },
    {
      "files": [
        "src/platform/packages/shared/kbn-test/src/jest/setup/**/*.js"
      ],
      "env": {
        "jest": true
      }
    },
    {
      "files": [
        "packages/kbn-rspack-optimizer/src/hmr/hmr_client.js"
      ],
      "globals": {
        "__KBN_HMR_PORT__": "readonly",
        "__webpack_hash__": "readonly"
      },
      "rules": {
        "no-var": "off",
        "no-console": "off"
      }
    },
    {
      "files": [
        "x-pack/solutions/observability/plugins/synthetics/server/synthetics_service/formatters/variable_parser.js",
        "src/platform/plugins/shared/share/public/components/tabs/embed/embed_content.test.tsx",
        "src/platform/plugins/shared/share/public/components/tabs/link/link_content.test.tsx",
        "src/platform/plugins/shared/data_views/common/data_views/data_views.test.ts"
      ],
      "rules": {
        "prefer-const": "off"
      }
    },
    {
      "files": [
        "x-pack/platform/plugins/private/monitoring/public/components/no_data/no_data.js",
        "x-pack/platform/plugins/private/rollup/public/crud_app/sections/job_list/job_list.js"
      ],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ],

  "plugins": ["react", "typescript", "import", "jsx-a11y", "react-perf", "node", "jest"],

  "categories": {"correctness": "off"},

  // Mirrors .eslintignore. Cypress remains ignored because Oxlint has no Cypress environment.
  "ignorePatterns": [
    "**/*.js.snap",
    "**/__tmp__/**",
    ".es/**",
    ".chromium/**",
    "build/**",
    "built_assets/**",
    "config/apm.dev.js",
    "data/**",
    "html_docs/**",
    "optimize/**",
    "plugins/**",
    "test/fixtures/scenarios/**",
    "x-pack/build/**",
    "**/node_modules/**",
    "**/target/**",
    "**/snapshots.js",
    "src/platform/plugins/shared/data/common/es_query/kuery/ast/_generated_/**",
    "x-pack/platform/plugins/private/canvas/canvas_plugin/**",
    "x-pack/platform/plugins/private/reporting/server/export_types/printable_pdf/server/lib/pdf/assets/**",
    "x-pack/platform/plugins/private/reporting/server/export_types/printable_pdf_v2/server/lib/pdf/assets/**",
    "x-pack/platform/plugins/private/cloud_integrations/cloud_full_story/public/assets/**",
    "x-pack/solutions/security/plugins/security_solution/server/endpoint/lib/libyara/wasm/dist/**",
    "packages/kbn-eslint-config/**",
    "packages/kbn-plugin-generator/template/**",
    "packages/kbn-generate/templates/**",
    "src/platform/packages/shared/kbn-test/src/functional_test_runner/__tests__/fixtures/**",
    "src/platform/packages/shared/kbn-test/src/functional_test_runner/lib/config/__tests__/fixtures/**",
    "src/platform/packages/shared/kbn-test/src/jest/negative/__fixtures__/**",
    "src/platform/packages/shared/kbn-flot-charts/lib/**",
    "src/platform/packages/shared/kbn-monaco/src/**/antlr/**",
    "src/platform/packages/shared/kbn-workflows/spec/elasticsearch/generated/**",
    "src/platform/packages/shared/kbn-workflows/spec/kibana/generated/**",
    "x-pack/platform/packages/shared/kbn-elastic-agent-condition-language/src/parser/**",
    "x-pack/platform/plugins/shared/screenshotting/chromium/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/cypress/**"
  ],

  "rules": {
    "no-implied-eval": "error",
    "no-prototype-builtins": "error",
    "react/jsx-no-undef": "error",
    "react/jsx-pascal-case": "error",
    "react/jsx-no-duplicate-props": ["error"],
    "react/no-danger": "error",
    "react/self-closing-comp": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "react/no-will-update-set-state": "error",
    "react/no-is-mounted": "error",
    "react/no-multi-comp": ["error", {"ignoreStateless": true}],
    "react/no-unknown-property": ["error", {"ignore": ["css"]}],
    "react/prefer-es6-class": ["error", "always"],
    "react/no-unescaped-entities": "error",

    // Oxlint differs from ESLint for the following enabled ESLint rules.
    // They stay disabled until the implementations have behavioral parity.
    // @typescript-eslint/consistent-type-definitions
    // @typescript-eslint/no-var-requires
    // import/named
    // import/namespace
    // import/no-default-export
    // import/no-named-as-default-member
    // jsx-a11y/click-events-have-key-events
    // jsx-a11y/no-noninteractive-element-interactions
    // jsx-a11y/role-has-required-aria-props
    // jsx-a11y/role-supports-aria-props
    // max-classes-per-file
    // new-cap
    // no-bitwise
    // no-console
    // no-loop-func
    // no-nested-ternary
    // no-new-func
    // no-shadow
    // react-hooks/exhaustive-deps
    // react-hooks/rules-of-hooks
    // react/react-in-jsx-scope

