{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "index.ts",
    "common/**/*.ts",
    "public/**/*.ts",
    "public/**/*.tsx",
    "server/**/*.ts",
    "../../typings/**/*",
    "test/scout_service_accounts/**/*"
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/spaces-plugin",
    "@kbn/workflows-extensions",
    "@kbn/zod",
    "@kbn/i18n",
    "@kbn/config-schema",
    "@kbn/workflows",
    "@kbn/scout",
    "@kbn/core-security-common",
    "@kbn/mock-idp-utils",
    "@kbn/es",
    "@kbn/test-es-server"
  ]
}
