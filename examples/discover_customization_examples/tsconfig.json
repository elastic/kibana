{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "common/**/*",
    "public/**/*",
    "server/**/*",
    "test/scout_examples/**/*",
    "../../typings/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/discover-plugin",
    "@kbn/developer-examples-plugin",
    "@kbn/shared-ux-router",
    "@kbn/i18n-react",
    "@kbn/react-kibana-context-theme",
    "@kbn/data-plugin",
    "@kbn/saved-search-plugin",
    "@kbn/content-management-utils",
    "@kbn/control-group-renderer",
    "@kbn/i18n",
    "@kbn/scout",
  ],
  "exclude": ["target/**/*"]
}
