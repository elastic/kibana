{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
  },
  "include": [
    "public/**/*",
    "server/**/*",
    ".storybook/**/*",
    "test/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/cloud-plugin",
    "@kbn/i18n",
    "@kbn/storybook",
    "@kbn/scout",
    "@kbn/licensing-types",
    "@kbn/config-schema",
    "@kbn/licensing-plugin"
  ],
  "exclude": [
    "target/**/*",
  ]
}
