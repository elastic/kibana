// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`NoData should show a default message if reason is unknown 1`] = `
<div
  class="euiPage emotion-euiPage-row-transparent-grow"
  data-test-subj="noDataContainer"
>
  <h1
    class="emotion-euiScreenReaderOnly"
  >
    No monitoring data found.
  </h1>
  <div
    class="euiPageBody emotion-euiPageBody-restrictWidth"
    style="max-width:600px"
  >
    <div
      class="euiPanel euiPanel--plain euiPanel--paddingMedium emotion-euiPanel-grow-m-m-plain-hasBorder"
      data-test-subj="autoOpsPromotionCallout"
      style="position:relative;padding-inline-end:calc(8px * 5);background-color:#F6F9FC;margin:0 24px"
    >
      <div
        class="euiFlexGroup emotion-euiFlexGroup-m-flexStart-flexStart-row"
      >
        <div
          class="euiFlexItem emotion-euiFlexItem-growZero"
          style="width:calc(16px * 5);height:calc(16px * 5)"
        >
          <span
            aria-hidden="true"
            class="euiIllustration emotion-euiIllustration-fullWidth"
          >
            <svg />
          </span>
        </div>
        <div
          class="euiFlexItem emotion-euiFlexItem-grow-1"
          style="min-width:0"
        >
          <div
            class="euiFlexGroup emotion-euiFlexGroup-m-flexStart-flexStart-column"
          >
            <div
              class="euiFlexItem emotion-euiFlexItem-growZero"
            >
              <div
                class="euiText emotion-euiText-s"
              >
                <p
                  style="margin-bottom:4px"
                >
                  <strong>
                    New! Connect this cluster to AutoOps
                  </strong>
                </p>
                <p>
                  Unlock advanced monitoring of ECE, ECK, and self-managed clusters with AutoOps, now available for free across all license types. Set it up today using 
                  <a
                    class="euiLink emotion-euiLink-primary"
                    data-test-subj="autoOpsPromotionCalloutDocsLink"
                    href="https://www.elastic.co/docs/deploy-manage/cloud-connect"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    Cloud Connect
                    <span
                      class="css-1j75qc1"
                      data-euiicon-type="external"
                      role="presentation"
                    />
                    <span
                      class="emotion-euiScreenReaderOnly"
                    >
                      (external, opens in a new tab or window)
                    </span>
                  </a>
                  .
                </p>
              </div>
            </div>
            <div
              class="euiFlexItem emotion-euiFlexItem-growZero"
            >
              <a
                class="euiButton emotion-euiButtonDisplay-s-defaultMinWidth-base-primary"
                data-test-subj="autoOpsPromotionCalloutConnectBtn"
                href="/app/cloud_connect"
                rel="noreferrer"
              >
                <span
                  class="emotion-euiButtonDisplayContent"
                >
                  <span
                    class="eui-textTruncate css-1ryezsz-s"
                  >
                    Get Started
                  </span>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
      <span
        class="euiToolTipAnchor emotion-euiToolTipAnchor-inlineBlock"
        id="generated-id_euiToolTipAnchor"
        style="position:absolute;top:8px;inset-inline-end:8px"
      >
        <button
          aria-label="Dismiss AutoOps promotion"
          class="euiButtonIcon emotion-euiButtonIcon-xs-empty-text"
          data-test-subj="autoOpsPromotionCallout-dismiss"
          type="button"
        >
          <span
            aria-hidden="true"
            class="euiButtonIcon__icon"
            color="inherit"
            data-euiicon-type="cross"
          />
        </button>
      </span>
    </div>
    <div
      class="euiSpacer euiSpacer--m emotion-euiSpacer-m"
    />
    <section
      class="emotion-euiPageSection-grow-l-center-transparent"
    >
      <div
        class="emotion-euiPageSection__content-l-center"
      >
        <div
          class="euiPanel euiPanel--plain euiEmptyPrompt emotion-euiPanel-m-plain-hasShadow-euiEmptyPrompt-vertical"
        >
          <div
            class="euiEmptyPrompt__main emotion-euiEmptyPrompt__main-vertical-l"
          >
            <div
              class="euiEmptyPrompt__icon emotion-euiEmptyPrompt__icon-vertical"
            >
              <span
                aria-hidden="true"
                data-euiicon-type="monitoringApp"
              />
            </div>
            <div
              class="euiEmptyPrompt__content emotion-euiEmptyPrompt__content-vertical"
            >
              <h2
                class="euiTitle emotion-euiTitle-m"
              >
                No monitoring data found
              </h2>
              <div
                class="euiSpacer euiSpacer--s emotion-euiSpacer-s"
              />
              <div
                class="euiText emotion-euiText-m-euiTextColor-subdued"
              >
                <div
                  class="euiText emotion-euiText-m"
                >
                  <p>
                    Have you set up monitoring yet? If so, make sure that the selected time period in the upper right includes monitoring data.
                  </p>
                  <p>
                    If you have configured monitoring data to be sent to a dedicated monitoring cluster you should access that data with the Kibana instance attached to the monitoring cluster.
                  </p>
                </div>
              </div>
              <div
                class="euiSpacer euiSpacer--l emotion-euiSpacer-l"
              />
              <div
                class="euiFlexGroup emotion-euiFlexGroup-responsive-s-spaceAround-center-row"
              >
                <div
                  class="euiFlexItem emotion-euiFlexItem-growZero"
                >
                  <button
                    class="euiButton emotion-euiButtonDisplay-m-defaultMinWidth-fill-primary"
                    data-test-subj="enableCollectionInterval"
                    type="button"
                  >
                    <span
                      class="emotion-euiButtonDisplayContent"
                    >
                      Set up monitoring with Metricbeat
                    </span>
                  </button>
                </div>
              </div>
              <hr
                class="euiHorizontalRule emotion-euiHorizontalRule-half-m"
              />
              <button
                class="euiButtonEmpty emotion-euiButtonDisplay-euiButtonEmpty-m-empty-primary"
                data-test-subj="useInternalCollection"
                type="button"
              >
                <span
                  class="euiButtonEmpty__content emotion-euiButtonDisplayContent"
                >
                  <span
                    class="eui-textTruncate euiButtonEmpty__text css-13ifi6d-m"
                  >
                    <span
                      class="emotion-euiTextColor-subdued"
                    >
                      Or, set up with self monitoring
                    </span>
                  </span>
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
`;

