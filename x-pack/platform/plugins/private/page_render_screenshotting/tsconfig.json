{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "server/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/config-schema",
    "@kbn/core-security-server",
    "@kbn/screenshotting-plugin",
    "@kbn/screenshot-mode-plugin",
    "@kbn/logging",
    "@kbn/core-http-server-mocks",
    "@kbn/core-security-server-mocks",
    "@kbn/logging-mocks"
  ],
  "exclude": [
    "target/**/*"
  ]
}
