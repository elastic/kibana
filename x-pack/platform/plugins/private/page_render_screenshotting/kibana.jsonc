{
  "type": "plugin",
  "id": "@kbn/page-render-screenshotting-plugin",
  "owner": [
    "@elastic/response-ops"
  ],
  "group": "platform",
  "visibility": "private",
  "description": "POC: a remote ScreenshottingStart implementation backed by the page-render-service, used by the reporting plugin in place of local Chromium on serverless.",
  "plugin": {
    "id": "pageRenderScreenshotting",
    "server": true,
    "browser": false,
    "configPath": [
      "xpack",
      "pageRenderScreenshotting"
    ],
    "requiredPlugins": [],
    "optionalPlugins": [],
    "requiredBundles": [],
    "extraPublicDirs": []
  }
}
