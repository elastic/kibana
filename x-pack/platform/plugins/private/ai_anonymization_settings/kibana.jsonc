{
  "type": "plugin",
  "id": "@kbn/ai-anonymization-settings-plugin",
  "owner": ["@elastic/security-investigations"],
  "group": "platform",
  "visibility": "private",
  "description": "Management page for configuring AI anonymization rules (regex and NER), available to every offering.",
  "plugin": {
    "id": "aiAnonymizationSettings",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "aiAnonymizationSettings"],
    "requiredPlugins": ["management"],
    "requiredBundles": ["kibanaReact"]
  }
}
