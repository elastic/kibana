{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "common/**/*",
    "public/**/*",
    "server/**/*"
  ],
  "kbn_references": [
    "@kbn/app-header",
    "@kbn/config-schema",
    "@kbn/core",
    "@kbn/deeplinks-analytics",
    "@kbn/esql-types",
    "@kbn/esql-utils",
    "@kbn/features-plugin",
    "@kbn/i18n",
    "@kbn/management-plugin",
    "@kbn/share-plugin",
    "@kbn/utility-types"
  ],
  "exclude": [
    "target/**/*"
  ]
}
