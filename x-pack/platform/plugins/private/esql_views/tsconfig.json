{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": ["common/**/*", "public/**/*", "server/**/*"],
  "kbn_references": [
    "@kbn/core",
    "@kbn/management-plugin",
    "@kbn/i18n",
    "@kbn/i18n-react",
    "@kbn/app-header",
    "@kbn/config-schema",
    "@kbn/esql",
    "@kbn/esql-editor",
    "@kbn/esql-utils",
    "@kbn/esql-datagrid",
    "@kbn/es-query",
    "@kbn/es-types",
    "@kbn/data-plugin",
    "@kbn/data-views-plugin",
    "@kbn/expressions-plugin",
    "@kbn/field-types"
  ],
  "exclude": ["target/**/*"]
}
