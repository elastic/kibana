{
  "type": "plugin",
  "id": "@kbn/esql-views-plugin",
  "owner": [
    "@elastic/kibana-management"
  ],
  "group": "platform",
  "visibility": "private",
  "description": "Manage ES|QL views in Stack Management",
  "plugin": {
    "id": "esqlViews",
    "browser": true,
    "server": true,
    "requiredPlugins": [
      "data",
      "esql",
      "features",
      "management",
      "share"
    ],
    "requiredBundles": [
      "esqlDataGrid"
    ]
  }
}
