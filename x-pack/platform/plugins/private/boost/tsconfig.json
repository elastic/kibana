{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "common/**/*",
    "public/**/*",
    "server/**/*",
    "../../../../../typings/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/i18n",
    "@kbn/i18n-react",
    "@kbn/config-schema",
    "@kbn/features-plugin",
    "@kbn/management-plugin",
    "@kbn/kibana-react-plugin",
    "@kbn/react-query",
    "@kbn/react-kibana-context-render",
    "@kbn/shared-ux-router",
    "@kbn/app-header",
    "@kbn/core-chrome-browser-components",
    "@kbn/share-plugin",
    "@kbn/index-management-shared-types",
    "@kbn/es-errors",
    "@kbn/index-management-plugin"
  ],
  "exclude": ["target/**/*"]
}
