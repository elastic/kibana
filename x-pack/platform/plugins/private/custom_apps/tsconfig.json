{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node",
      "react",
      "@testing-library/jest-dom",
      "@emotion/react/types/css-prop"
    ]
  },
  "include": [
    "common/**/*",
    "public/**/*",
    "server/**/*"
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/config-schema",
    "@kbn/zod",
    "@kbn/grid-layout",
    "@kbn/a2ui-renderer",
    "@kbn/a2ui-eui-catalog",
    "@kbn/code-editor",
    "@kbn/react-kibana-context-render"
  ]
}
