{
  "type": "plugin",
  "id": "@kbn/secrets-plugin",
  "owner": ["@elastic/workflows-eng"],
  "group": "platform",
  "visibility": "shared",
  "description": "Stores named secrets that Kibana features can reference without exposing their values.",
  "plugin": {
    "id": "secrets",
    "browser": false,
    "server": true,
    "requiredPlugins": ["encryptedSavedObjects"],
    "optionalPlugins": ["spaces"]
  }
}
