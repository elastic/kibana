// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[
  `online eval workflow yaml builds a workflow yaml snapshot and validates against WorkflowSchema 1`
] = `
"version: \\"1\\"
name: \\"[online-eval] My online monitor\\"
description: Online evaluation created by the Evals UI
enabled: true
tags:
  - evals-online
consts:
  connector_id: connector-123
triggers:
  - type: scheduled
    with:
      every: 1h
steps:
  - name: sample_traces
    type: elasticsearch.esql.query
    with:
      query: |-
        FROM traces-agent_builder.otel-default
        | WHERE @timestamp >= NOW() - 60m AND @timestamp < NOW() - 15m
        | WHERE parent_span_id IS NULL AND KQL(\\"attributes.gen_ai.operation.name:*\\") AND NOT KQL(\\"attributes.evaluator.name:*\\")
        | WHERE attributes.agent_id == 'agent-1'
        | STATS latest = MAX(@timestamp) BY trace_id
        | KEEP latest, trace_id
        | SORT latest DESC
        | LIMIT 25
  - name: evaluate_each
    type: foreach
    foreach: \\"{{ steps.sample_traces.output.values }}\\"
    iteration-on-failure:
      continue: true
    steps:
      - name: evaluate
        type: ai.evals.evaluateTrace
        with:
          trace_id: \\"{{ foreach.item[1] }}\\"
          evaluators:
            - name: correctness
              version: v1
              connector_id: \\"{{ consts.connector_id }}\\"
            - name: trace_readiness
              connector_id: \\"{{ consts.connector_id }}\\"
        on-failure:
          retry:
            max-attempts: 3
            delay: 5s
            strategy: exponential
            max-delay: 1m
            jitter: true
      - name: persist
        type: ai.evals.persistOnlineScores
        with:
          monitor:
            id: \\"{{ workflow.id }}\\"
            name: \\"{{ workflow.name }}\\"
          trace_id: \\"{{ foreach.item[1] }}\\"
          connector_id: \\"{{ consts.connector_id }}\\"
          results: \${{ steps.evaluate.output.results }}
          errors: \${{ steps.evaluate.output.errors }}
        on-failure:
          retry:
            max-attempts: 3
            delay: 5s
            strategy: exponential
            max-delay: 1m
            jitter: true
"
`;
