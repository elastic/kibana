{
  "type": "plugin",
  "id": "@kbn/isomer-plugin",
  "owner": ["@elastic/appex-sharedux"],
  "group": "platform",
  "visibility": "shared",
  "description": "Hosts an Isomer runtime with Kibana's primitive packs, and materializes saved objects into Isomer nodes.",
  "plugin": {
    "id": "isomer",
    "browser": false,
    "server": true,
    "requiredPlugins": ["data", "fieldFormats"],
    "optionalPlugins": ["embeddable"],
    "runtimePluginDependencies": ["dashboard"]
  }
}
