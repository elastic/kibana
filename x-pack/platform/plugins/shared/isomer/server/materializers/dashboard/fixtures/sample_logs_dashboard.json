      {
        "grid": {
          "x": 36,
          "y": 7,
          "w": 12,
          "h": 7
        },
        "config": {
          "type": "metric",
          "title": "Metric",
          "sampling": 1,
          "ignore_global_filters": false,
          "data_source": {
            "type": "esql",
            "query": "FROM kibana_sample_data_logs\n| EVAL type = CASE(TO_INTEGER(response.keyword) >= 500, \"5xx\", \"Other\")\n| STATS count = COUNT(*) by type\n| EVAL count_5xx = CASE(type == \"5xx\", count), count_rest = CASE(type == \"Other\", count)\n| DROP count, type\n| STATS count_5xx = MAX(count_5xx), count_rest = MAX(count_rest)\n| EVAL percentage = ROUND(count_5xx / TO_DOUBLE(count_5xx + count_rest), 3)\n| RENAME percentage as `HTTP 5xx (%)`\n| DROP count_5xx, count_rest"
          },
          "styling": {
            "density": "compact",
            "primary": {
              "position": "bottom",
              "labels": {
                "alignment": "left"
              },
              "value": {
                "alignment": "right",
                "sizing": "auto"
              }
            }
          },
          "metrics": [
            {
              "column": "HTTP 5xx (%)",
              "format": {
                "type": "percent",
                "decimals": 2,
                "compact": false
              },
              "type": "primary",
              "color": {
                "type": "auto"
              }
            }
          ],
