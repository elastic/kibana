      {
        "grid": {
          "x": 0,
          "y": 60,
          "w": 48,
          "h": 19
        },
        "config": {
          "type": "data_table",
          "title": "[Logs] Errors by host",
          "sampling": 1,
          "ignore_global_filters": false,
          "data_source": {
            "type": "esql",
            "query": "FROM kibana_sample_data_logs\n| KEEP bytes, clientip, url.keyword, response.keyword\n| EVAL type = CASE(TO_INTEGER(response.keyword) >= 400 and TO_INTEGER(response.keyword) < 500, \"4xx\", TO_INTEGER(response.keyword) >= 500, \"5xx\", \"Other\")\n| STATS Visits = COUNT(), Unique = COUNT_DISTINCT(clientip), p95 = percentile(bytes, 95), median = median(bytes) by type, url.keyword\n| EVAL count_4xx = CASE(type == \"4xx\", Visits), count_5xx = CASE(type == \"5xx\", Visits), count_rest =  CASE(type == \"Other\", Visits)\n| STATS count_4xx = SUM(count_4xx), count_5xx  = SUM(count_5xx), count_rest = SUM(count_rest), Unique = SUM(Unique),`95th percentile of bytes` = MAX(p95), `Median of bytes` = MAX(median), Visits = SUM(Visits) BY url.keyword\n| EVAL count_4xx = COALESCE(count_4xx, 0::LONG), count_5xx = COALESCE(count_5xx, 0::LONG), count_rest = COALESCE(count_rest, 0::LONG)\n| EVAL total_records = TO_DOUBLE(count_4xx + count_5xx + count_rest)\n| EVAL percentage_4xx = count_4xx / total_records, percentage_5xx = count_5xx / total_records\n| EVAL percentage_4xx = ROUND(percentage_4xx, 3)\n| EVAL percentage_5xx = ROUND(percentage_5xx, 3)\n| DROP count_4xx, count_rest, total_records\n| SORT percentage_5xx DESC\n| RENAME percentage_4xx as `HTTP 4xx`, percentage_5xx as `HTTP 5xx`"
          },
