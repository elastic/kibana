{
  "type": "plugin",
  "id": "@kbn/context-engine-plugin",
  "owner": "@elastic/context-eng",
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "contextEngine",
    "server": true,
    "browser": true,
    "requiredPlugins": ["actions", "features", "share", "esql", "triggersActionsUi"],
    "optionalPlugins": ["console", "security", "workflowsManagement"],
    "runtimePluginDependencies": ["agentBuilder"],
    "requiredBundles": ["kibanaReact", "actions"]
  }
}
