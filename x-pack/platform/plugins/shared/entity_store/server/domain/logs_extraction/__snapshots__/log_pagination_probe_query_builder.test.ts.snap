// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`buildLogPaginationCursorProbeEsql samples, sorts ASC, limits to the scaled sample size, then aggregates MAX(timestamp) and COUNT(*) 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM logs-*
  | WHERE
      @timestamp >= TO_DATETIME(\\"2024-01-01T00:00:00.000Z\\")
      AND @timestamp <= TO_DATETIME(\\"2024-01-02T00:00:00.000Z\\")
      AND ((TO_STRING(event.outcome) IS NULL OR TO_STRING(event.outcome) != \\"failure\\") AND (CASE(MV_MIN(TO_STRING(user.email)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.email))), 1, 1)), MV_MIN(TO_STRING(user.email))) IS NOT NULL OR CASE(MV_MIN(TO_STRING(user.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.id))), 1, 1)), MV_MIN(TO_STRING(user.id))) IS NOT NULL OR CASE(MV_MIN(TO_STRING(user.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.name))), 1, 1)), MV_MIN(TO_STRING(user.name))) IS NOT NULL))
  | SAMPLE 0.1
  | SORT @timestamp ASC
  | LIMIT 10
  | STATS @timestamp = MAX(@timestamp), total_logs = COUNT(*)"
`;
