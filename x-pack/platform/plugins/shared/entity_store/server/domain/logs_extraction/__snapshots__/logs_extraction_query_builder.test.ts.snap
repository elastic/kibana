 recent.asset.business_unit = LAST(TO_STRING(asset.business_unit), @timestamp) WHERE TO_STRING(asset.business_unit) IS NOT NULL,
 recent.event.module = VALUES(TO_STRING(event.module)),
 recent.event.dataset = VALUES(TO_STRING(event.dataset)),
 recent.data_stream.dataset = VALUES(TO_STRING(data_stream.dataset)),
 recent.entity.source = VALUES(TO_STRING(entity.source)),
 recent.entity.type = LAST(TO_STRING(service.entity.type), @timestamp) WHERE TO_STRING(service.entity.type) IS NOT NULL,
 recent.entity.sub_type = LAST(TO_STRING(service.entity.sub_type), @timestamp) WHERE TO_STRING(service.entity.sub_type) IS NOT NULL,
 recent.entity.url = LAST(TO_STRING(service.entity.url), @timestamp) WHERE TO_STRING(service.entity.url) IS NOT NULL,
 recent.entity.attributes.asset = LAST(TO_BOOLEAN(service.entity.attributes.asset), @timestamp) WHERE TO_BOOLEAN(service.entity.attributes.asset) IS NOT NULL,
