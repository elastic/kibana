 recent.entity.sub_type = LAST(TO_STRING(entity.sub_type), @timestamp) WHERE TO_STRING(entity.sub_type) IS NOT NULL,
 recent.entity.url = LAST(TO_STRING(entity.url), @timestamp) WHERE TO_STRING(entity.url) IS NOT NULL,
 recent.entity.attributes.asset = LAST(TO_BOOLEAN(entity.attributes.asset), @timestamp) WHERE TO_BOOLEAN(entity.attributes.asset) IS NOT NULL,
