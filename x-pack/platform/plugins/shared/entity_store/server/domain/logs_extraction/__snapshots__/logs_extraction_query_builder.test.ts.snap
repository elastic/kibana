exports[`buildLogsExtractionEsqlQuery generates the expected query for perf.entity.079 entity description 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM test-index-*
  | WHERE
      @timestamp >= TO_DATETIME(\\"2022-01-01T00:00:00.000Z\\")
      AND @timestamp <= TO_DATETIME(\\"2022-01-01T23:59:59.999Z\\")
      AND ((TO_STRING(perf_entity_079_id) IS NOT NULL AND TO_STRING(perf_entity_079_id) != \\"\\"))
| EVAL _src_entity_source0 = MV_FIRST(TO_STRING(event.module)),
 _src_entity_source1 = MV_FIRST(TO_STRING(event.dataset)),
 _src_entity_source2 = MV_FIRST(TO_STRING(data_stream.dataset)),
 _src_entity_source = COALESCE(CASE(_src_entity_source0 IS NOT NULL AND _src_entity_source0 != \\"\\", _src_entity_source0), CASE(_src_entity_source1 IS NOT NULL AND _src_entity_source1 != \\"\\", _src_entity_source1), CASE(_src_entity_source2 IS NOT NULL AND _src_entity_source2 != \\"\\", _src_entity_source2)),
 entity.source = CASE(_src_entity_source IS NULL OR _src_entity_source == \\"\\", NULL, _src_entity_source),
 recent.entity.EngineMetadata.UntypedId = TO_STRING(perf_entity_079_id)
| STATS
    entity.EngineMetadata.FirstSeenLogInPage = MIN(@timestamp),
    recent.timestamp = MAX(@timestamp),
    recent.entity.name = LAST(TO_STRING(perf_entity_079_name), @timestamp) WHERE TO_STRING(perf_entity_079_name) IS NOT NULL,
 recent.perf_entity_079_name = LAST(TO_STRING(perf_entity_079_name), @timestamp) WHERE TO_STRING(perf_entity_079_name) IS NOT NULL,
 recent.perf_entity_079_id = LAST(TO_STRING(perf_entity_079_id), @timestamp) WHERE TO_STRING(perf_entity_079_id) IS NOT NULL,
 recent.perf_entity_079_attr_0 = VALUES(TO_STRING(perf_entity_079_attr_0)),
 recent.perf_entity_079_attr_1 = VALUES(TO_STRING(perf_entity_079_attr_1)),
