exports[`buildLogsExtractionEsqlQuery generates the expected query for k8s.deployment entity description 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM test-index-*
  | WHERE
      @timestamp >= TO_DATETIME(\\"2022-01-01T00:00:00.000Z\\")
      AND @timestamp <= TO_DATETIME(\\"2022-01-01T23:59:59.999Z\\")
      AND (TO_STRING(k8s.namespace.name) IS NOT NULL AND TO_STRING(k8s.namespace.name) != \\"\\" AND TO_STRING(k8s.deployment.name) IS NOT NULL AND TO_STRING(k8s.deployment.name) != \\"\\" OR TO_STRING(kubernetes.namespace) IS NOT NULL AND TO_STRING(kubernetes.namespace) != \\"\\" AND TO_STRING(kubernetes.deployment.name) IS NOT NULL AND TO_STRING(kubernetes.deployment.name) != \\"\\")
| EVAL _src_entity_source0 = MV_FIRST(TO_STRING(event.module)),
 _src_entity_source1 = MV_FIRST(TO_STRING(event.dataset)),
 _src_entity_source2 = MV_FIRST(TO_STRING(data_stream.dataset)),
 _src_entity_source = COALESCE(CASE(_src_entity_source0 IS NOT NULL AND _src_entity_source0 != \\"\\", _src_entity_source0), CASE(_src_entity_source1 IS NOT NULL AND _src_entity_source1 != \\"\\", _src_entity_source1), CASE(_src_entity_source2 IS NOT NULL AND _src_entity_source2 != \\"\\", _src_entity_source2)),
 entity.source = CASE(_src_entity_source IS NULL OR _src_entity_source == \\"\\", NULL, _src_entity_source),
 _src_k8s_namespace_name0 = MV_FIRST(TO_STRING(k8s.namespace.name)),
 _src_k8s_namespace_name1 = MV_FIRST(TO_STRING(kubernetes.namespace)),
 _src_k8s_namespace_name = COALESCE(CASE(_src_k8s_namespace_name0 IS NOT NULL AND _src_k8s_namespace_name0 != \\"\\", _src_k8s_namespace_name0), CASE(_src_k8s_namespace_name1 IS NOT NULL AND _src_k8s_namespace_name1 != \\"\\", _src_k8s_namespace_name1)),
 k8s.namespace.name = CASE(_src_k8s_namespace_name IS NULL OR _src_k8s_namespace_name == \\"\\", NULL, _src_k8s_namespace_name),
 _src_k8s_deployment_name0 = MV_FIRST(TO_STRING(k8s.deployment.name)),
 _src_k8s_deployment_name1 = MV_FIRST(TO_STRING(kubernetes.deployment.name)),
 _src_k8s_deployment_name = COALESCE(CASE(_src_k8s_deployment_name0 IS NOT NULL AND _src_k8s_deployment_name0 != \\"\\", _src_k8s_deployment_name0), CASE(_src_k8s_deployment_name1 IS NOT NULL AND _src_k8s_deployment_name1 != \\"\\", _src_k8s_deployment_name1)),
 k8s.deployment.name = CASE(_src_k8s_deployment_name IS NULL OR _src_k8s_deployment_name == \\"\\", NULL, _src_k8s_deployment_name),
 k8s_namespace_name_present = TO_STRING(k8s.namespace.name) IS NOT NULL AND TO_STRING(k8s.namespace.name) != \\"\\",
 k8s_deployment_name_present = TO_STRING(k8s.deployment.name) IS NOT NULL AND TO_STRING(k8s.deployment.name) != \\"\\",
 kubernetes_namespace_present = TO_STRING(kubernetes.namespace) IS NOT NULL AND TO_STRING(kubernetes.namespace) != \\"\\",
 kubernetes_deployment_name_present = TO_STRING(kubernetes.deployment.name) IS NOT NULL AND TO_STRING(kubernetes.deployment.name) != \\"\\",
 k8s_namespace_name_present_or_null = CASE(k8s_namespace_name_present, TO_STRING(k8s.namespace.name)),
 k8s_deployment_name_present_or_null = CASE(k8s_deployment_name_present, TO_STRING(k8s.deployment.name)),
 kubernetes_namespace_present_or_null = CASE(kubernetes_namespace_present, TO_STRING(kubernetes.namespace)),
 kubernetes_deployment_name_present_or_null = CASE(kubernetes_deployment_name_present, TO_STRING(kubernetes.deployment.name)),
 _euid_branch_0_formula = CONCAT(k8s_namespace_name_present_or_null, \\"/\\", k8s_deployment_name_present_or_null),
 _euid_branch_0_cond = (TO_STRING(k8s.namespace.name) IS NOT NULL AND TO_STRING(k8s.namespace.name) != \\"\\" AND TO_STRING(k8s.deployment.name) IS NOT NULL AND TO_STRING(k8s.deployment.name) != \\"\\"),
 _euid_branch_1_formula = CONCAT(kubernetes_namespace_present_or_null, \\"/\\", kubernetes_deployment_name_present_or_null),
 recent.entity.EngineMetadata.UntypedId = CASE(_euid_branch_0_cond, _euid_branch_0_formula,
TRUE, _euid_branch_1_formula, NULL)
| STATS
    entity.EngineMetadata.FirstSeenLogInPage = MIN(@timestamp),
    recent.timestamp = MAX(@timestamp),
    recent.entity.name = LAST(TO_STRING(k8s.deployment.name), @timestamp) WHERE TO_STRING(k8s.deployment.name) IS NOT NULL,
