exports[`buildLogsExtractionEsqlQuery generates the expected query for k8s.container entity description 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM test-index-*
  | WHERE
      @timestamp >= TO_DATETIME(\\"2022-01-01T00:00:00.000Z\\")
      AND @timestamp <= TO_DATETIME(\\"2022-01-01T23:59:59.999Z\\")
      AND (TO_STRING(k8s.pod.uid) IS NOT NULL AND TO_STRING(k8s.pod.uid) != \\"\\" AND TO_STRING(k8s.container.name) IS NOT NULL AND TO_STRING(k8s.container.name) != \\"\\" OR TO_STRING(kubernetes.pod.uid) IS NOT NULL AND TO_STRING(kubernetes.pod.uid) != \\"\\" AND TO_STRING(kubernetes.container.name) IS NOT NULL AND TO_STRING(kubernetes.container.name) != \\"\\")
| EVAL _src_entity_source0 = MV_FIRST(TO_STRING(event.module)),
 _src_entity_source1 = MV_FIRST(TO_STRING(event.dataset)),
 _src_entity_source2 = MV_FIRST(TO_STRING(data_stream.dataset)),
 _src_entity_source = COALESCE(CASE(_src_entity_source0 IS NOT NULL AND _src_entity_source0 != \\"\\", _src_entity_source0), CASE(_src_entity_source1 IS NOT NULL AND _src_entity_source1 != \\"\\", _src_entity_source1), CASE(_src_entity_source2 IS NOT NULL AND _src_entity_source2 != \\"\\", _src_entity_source2)),
 entity.source = CASE(_src_entity_source IS NULL OR _src_entity_source == \\"\\", NULL, _src_entity_source),
 _src_k8s_pod_uid0 = MV_FIRST(TO_STRING(k8s.pod.uid)),
 _src_k8s_pod_uid1 = MV_FIRST(TO_STRING(kubernetes.pod.uid)),
 _src_k8s_pod_uid = COALESCE(CASE(_src_k8s_pod_uid0 IS NOT NULL AND _src_k8s_pod_uid0 != \\"\\", _src_k8s_pod_uid0), CASE(_src_k8s_pod_uid1 IS NOT NULL AND _src_k8s_pod_uid1 != \\"\\", _src_k8s_pod_uid1)),
 k8s.pod.uid = CASE(_src_k8s_pod_uid IS NULL OR _src_k8s_pod_uid == \\"\\", NULL, _src_k8s_pod_uid),
 _src_k8s_container_name0 = MV_FIRST(TO_STRING(k8s.container.name)),
 _src_k8s_container_name1 = MV_FIRST(TO_STRING(kubernetes.container.name)),
 _src_k8s_container_name = COALESCE(CASE(_src_k8s_container_name0 IS NOT NULL AND _src_k8s_container_name0 != \\"\\", _src_k8s_container_name0), CASE(_src_k8s_container_name1 IS NOT NULL AND _src_k8s_container_name1 != \\"\\", _src_k8s_container_name1)),
 k8s.container.name = CASE(_src_k8s_container_name IS NULL OR _src_k8s_container_name == \\"\\", NULL, _src_k8s_container_name),
 _src_k8s_pod_name0 = MV_FIRST(TO_STRING(k8s.pod.name)),
 _src_k8s_pod_name1 = MV_FIRST(TO_STRING(kubernetes.pod.name)),
 _src_k8s_pod_name = COALESCE(CASE(_src_k8s_pod_name0 IS NOT NULL AND _src_k8s_pod_name0 != \\"\\", _src_k8s_pod_name0), CASE(_src_k8s_pod_name1 IS NOT NULL AND _src_k8s_pod_name1 != \\"\\", _src_k8s_pod_name1)),
 k8s.pod.name = CASE(_src_k8s_pod_name IS NULL OR _src_k8s_pod_name == \\"\\", NULL, _src_k8s_pod_name),
 _src_k8s_namespace_name0 = MV_FIRST(TO_STRING(k8s.namespace.name)),
 _src_k8s_namespace_name1 = MV_FIRST(TO_STRING(kubernetes.namespace)),
