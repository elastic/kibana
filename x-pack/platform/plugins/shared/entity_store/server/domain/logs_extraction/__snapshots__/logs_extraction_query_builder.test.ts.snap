exports[`buildLogsExtractionEsqlQuery generates the expected query for perf.entity.002 entity description 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM test-index-*
  | WHERE
      @timestamp >= TO_DATETIME(\\"2022-01-01T00:00:00.000Z\\")
      AND @timestamp <= TO_DATETIME(\\"2022-01-01T23:59:59.999Z\\")
      AND ((TO_STRING(perf_entity_002_id) IS NOT NULL AND TO_STRING(perf_entity_002_id) != \\"\\"))
