      AND @timestamp <= TO_DATETIME(\\"2022-01-01T23:59:59.999Z\\")
      AND (TO_STRING(perf_entity_020_id) IS NOT NULL AND TO_STRING(perf_entity_020_id) != \\"\\" OR TO_STRING(perf_entity_020_id_alt) IS NOT NULL AND TO_STRING(perf_entity_020_id_alt) != \\"\\")
