 entity.source = CASE(_src_entity_source IS NULL OR _src_entity_source == \\"\\", NULL, _src_entity_source),
 recent.entity.EngineMetadata.UntypedId = TO_STRING(perf_entity_071_id)
| STATS
    entity.EngineMetadata.FirstSeenLogInPage = MIN(@timestamp),
    recent.timestamp = MAX(@timestamp),
    recent.entity.name = LAST(TO_STRING(perf_entity_071_name), @timestamp) WHERE TO_STRING(perf_entity_071_name) IS NOT NULL,
