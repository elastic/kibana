exports[`buildLogsExtractionEsqlQuery generates the expected query for perf.entity.050 entity description 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM test-index-*
  | WHERE
      @timestamp >= TO_DATETIME(\\"2022-01-01T00:00:00.000Z\\")
      AND @timestamp <= TO_DATETIME(\\"2022-01-01T23:59:59.999Z\\")
      AND (TO_STRING(perf_entity_050_id) IS NOT NULL AND TO_STRING(perf_entity_050_id) != \\"\\" OR TO_STRING(perf_entity_050_id_alt) IS NOT NULL AND TO_STRING(perf_entity_050_id_alt) != \\"\\")
| EVAL _src_entity_source0 = MV_FIRST(TO_STRING(event.module)),
 _src_entity_source1 = MV_FIRST(TO_STRING(event.dataset)),
