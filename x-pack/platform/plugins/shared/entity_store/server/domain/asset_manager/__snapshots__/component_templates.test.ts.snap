exports[`built-in definition Elasticsearch assets (backward compatibility) latest index template 1`] = `
Object {
  "_meta": Object {
    "description": "Index template for indices managed by the Elastic Entity Model's entity discovery framework for the latest dataset",
    "ecs_version": "8.0.0",
    "managed": true,
    "managed_by": "security_context_core_analysis",
  },
  "composed_of": Array [
    "ecs@mappings",
    "entities-v2-user_default-latest@platform",
    "entities-v2-host_default-latest@platform",
    "entities-v2-service_default-latest@platform",
    "entities-v2-generic_default-latest@platform",
  ],
  "ignore_missing_component_templates": Array [
    "entities-v2-user_default-latest@platform",
    "entities-v2-host_default-latest@platform",
    "entities-v2-service_default-latest@platform",
    "entities-v2-generic_default-latest@platform",
  ],
  "index_patterns": Array [
    ".entities.v2.latest.default-*",
  ],
  "name": "entities_v2_latest_default_index_template",
  "priority": 200,
  "template": Object {
    "mappings": Object {
      "_meta": Object {
        "mappingsVersion": 1,
      },
      "date_detection": false,
      "dynamic_templates": Array [
        Object {
          "strings_as_keyword": Object {
            "mapping": Object {
              "fields": Object {
                "text": Object {
                  "type": "text",
                },
              },
              "ignore_above": 1024,
              "type": "keyword",
            },
            "match_mapping_type": "string",
          },
        },
      ],
    },
    "settings": Object {
      "index": Object {
        "codec": "best_compression",
        "default_pipeline": ".entities.v2.latest.default_ingest_pipeline",
        "mapping": Object {
          "total_fields": Object {
            "limit": 2000,
          },
        },
        "mode": "lookup",
      },
    },
  },
}
`;

