exports[`built-in definition Elasticsearch assets (backward compatibility) history snapshot index template 1`] = `
Object {
  "_meta": Object {
    "description": "Index template for history snapshot indices managed by the Elastic Entity Store",
    "ecs_version": "9.3.0",
    "managed": true,
    "managed_by": "contextual_security_core_analysis",
  },
  "composed_of": Array [
    "ecs@mappings",
    "entities-v2-user_default-latest@platform",
    "entities-v2-host_default-latest@platform",
    "entities-v2-service_default-latest@platform",
    "entities-v2-generic_default-latest@platform",
  ],
  "ignore_missing_component_templates": Array [
    "entities-v2-user_default-latest@platform",
    "entities-v2-host_default-latest@platform",
    "entities-v2-service_default-latest@platform",
    "entities-v2-generic_default-latest@platform",
  ],
  "index_patterns": Array [
    ".entities.v2.history.default.*",
  ],
  "name": "entities_v2_history_default_index_template",
  "priority": 200,
  "template": Object {
    "mappings": Object {
      "_meta": Object {
        "mappingsVersion": 1,
      },
      "date_detection": false,
      "dynamic_templates": Array [
        Object {
