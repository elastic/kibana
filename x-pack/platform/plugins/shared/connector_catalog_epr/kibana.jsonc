{
  "type": "plugin",
  "id": "@kbn/connector-catalog-epr-plugin",
  "owner": [
    "@elastic/response-ops"
  ],
  "group": "platform",
  "visibility": "private",
  "description": "PoC: fetches connector spec YAML files from the Elastic Package Registry with plain HTTP, without the Fleet plugin.",
  "plugin": {
    "id": "connectorCatalogEpr",
    "browser": false,
    "server": true,
    "configPath": [
      "xpack",
      "connectorCatalogEpr"
    ]
  }
}
