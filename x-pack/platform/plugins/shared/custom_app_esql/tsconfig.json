{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": ["*.ts", "common/**/*", "public/**/*", "server/**/*"],
  "kbn_references": [
    "@kbn/core",
    "@kbn/i18n",
    "@kbn/zod",
    "@kbn/custom-app-registry",
    "@kbn/custom-app-common",
    "@kbn/custom-app-plugin",
    "@kbn/esql",
    "@kbn/esql-types",
    "@kbn/ui-callout"
  ],
  "exclude": ["target/**/*"]
}
