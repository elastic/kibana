    "@kbn/logging",
    "@kbn/react-kibana-context-render",
    "@kbn/doc-links",
    "@kbn/console-plugin",
    "@kbn/kibana-utils-plugin",
    "@kbn/features-plugin",
    "@kbn/ui-theme",
    "@kbn/deeplinks-management",
    "@kbn/management-plugin",
    "@kbn/serverless",
    "@kbn/utility-types",
    "@kbn/shared-ux-page-kibana-template",
