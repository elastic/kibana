{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": ["*.ts", "common/**/*", "public/**/*", "server/**/*"],
  "kbn_references": [
    "@kbn/core",
    "@kbn/embeddable-plugin",
    "@kbn/presentation-publishing",
    "@kbn/presentation-publishing-schemas",
    "@kbn/i18n",
    "@kbn/zod",
    "@kbn/custom-app-common",
    "@kbn/ui-actions-plugin",
    "@kbn/ui-callout",
    "@kbn/data-plugin",
    "@kbn/search-types",
    "@kbn/core-http-browser",
    "@kbn/custom-content-renderer"
  ],
  "exclude": ["target/**/*"]
}
