{
  "type": "plugin",
  "id": "@kbn/custom-app-plugin",
  "owner": ["@elastic/kibana-dashboards"],
  "group": "platform",
  "visibility": "shared",
  "description": "Custom app embeddable: interactive, document-driven panels for dashboards",
  "plugin": {
    "id": "customApp",
    "browser": true,
    "server": true,
    "requiredPlugins": ["embeddable", "data", "dataViews", "esql", "features", "lens", "uiActions"],
    "optionalPlugins": ["agentBuilder", "share"]
  }
}
