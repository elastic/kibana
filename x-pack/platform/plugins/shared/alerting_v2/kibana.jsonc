{
  "type": "plugin",
  "id": "@kbn/alerting-v2-plugin",
  "owner": ["@elastic/rna-project-team"],
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "alertingVTwo",
    "browser": true,
    "server": true,
    "tasks": {
      "requiredPlugins": [
        "taskManager",
        "spaces",
        "security",
        "encryptedSavedObjects",
        "workflowsManagement",
        "workflowsExtensions",
        "maintenanceWindows",
        "eventLog",
        "licensing"
      ]
    },
    "configPath": ["xpack", "alerting_v2"],
    "requiredPlugins": [
      "taskManager",
      "features",
      "spaces",
      "data",
      "dataViews",
      "esql",
      "kql",
      "lens",
      "security",
      "encryptedSavedObjects",
      "workflowsManagement",
      "workflowsExtensions",
      "expressions",
      "uiActions",
      "fieldFormats",
      "charts",
      "management",
      "kibanaUtils",
      "share",
      "unifiedDocViewer",
      "maintenanceWindows",
      "eventLog",
      "triggersActionsUi",
      "licensing"
    ],
    "optionalPlugins": [
      "usageCollection",
      "agentBuilder",
      "agentBuilderSml",
      "dashboard",
      "cps",
      "cloud"
    ],
    "requiredBundles": ["alerting", "kibanaReact", "agentBuilder", "esql"],
    "extraPublicDirs": []
  }
}
