{
  "exposure": "open",
  "id": "security.updateNote",
  "input": {
    "properties": {
      "document_id": {
        "description": "The Elasticsearch `_id` of the alert, attack, or document the note is attached to. Used to locate the note and preserve its associations.",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "note_id": {
        "description": "The `savedObjectId` of the note to update.",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "text": {
        "description": "The new text content of the note. Markdown is supported.",
        "maxLength": 60000,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "document_id",
      "note_id",
      "text"
    ],
    "type": "object"
  },
  "output": {
    "additionalProperties": false,
    "definitions": {
      "__schema0": {
        "type": "string"
      }
    },
    "properties": {
      "message": {
        "maxLength": 1000,
        "type": "string"
      },
      "note_id": {
        "allOf": [
          {
            "$ref": "#/definitions/__schema0"
          }
        ],
        "description": "The `savedObjectId` of the updated note."
      },
      "success": {
        "type": "boolean"
      }
    },
    "required": [
      "success"
    ],
    "type": "object"
  },
  "stability": "tech_preview"
}
