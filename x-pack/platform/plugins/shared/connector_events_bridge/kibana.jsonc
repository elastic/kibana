{
  "type": "plugin",
  "id": "@kbn/connector-events-bridge-plugin",
  "owner": ["@elastic/workflows-eng"],
  "group": "platform",
  "visibility": "shared",
  "description": "Forwards Actions inbound connector events to Workflows until a workflow definition can carry an identity.",
  "plugin": {
    "id": "connectorEventsBridge",
    "browser": false,
    "server": true,
    "configPath": ["xpack", "connectorEventsBridge"],
    "requiredPlugins": ["actions"],
    "optionalPlugins": ["workflowsExtensions"]
  }
}
