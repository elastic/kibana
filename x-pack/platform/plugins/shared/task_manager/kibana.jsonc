{
  "type": "plugin",
  "id": "@kbn/task-manager-plugin",
  "owner": [
    "@elastic/response-ops"
  ],
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "taskManager",
    "browser": false,
    "server": true,
    "tasks": { "requiredPlugins": ["encryptedSavedObjects"] },
    "configPath": [
      "xpack",
      "task_manager"
    ],
    "requiredPlugins": [
      "licensing"
    ],
    "optionalPlugins": [
      "cloud",
      "encryptedSavedObjects",
      "usageCollection",
    ]
  }
}
