{
  "type": "plugin",
  "id": "@kbn/task-manager-plugin",
  "owner": [
    "@elastic/response-ops"
  ],
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "taskManager",
    "browser": false,
    "server": true,
    "taskTypes": [
      "server/task_types/delete_inactive_nodes.task.ts",
      "server/task_types/mark_removed_tasks_as_unrecognized.task.ts"
    ],
    "configPath": [
      "xpack",
      "task_manager"
    ],
    "requiredPlugins": [
      "licensing"
    ],
    "optionalPlugins": [
      "cloud",
      "usageCollection",
    ]
  }
}
