{
  "type": "plugin",
  "id": "@kbn/agentic-investigations-plugin",
  "owner": ["@elastic/security-solution"],
  "group": "platform",
  "visibility": "shared",
  "description": "Solution-agnostic base layer for agentic investigations. Owns the entities an agent and a human collaborate on: impact and escalations today, investigations next. Proposals live in the `proposals` plugin.",
  "plugin": {
    "id": "agenticInvestigations",
    "configPath": ["xpack", "agenticInvestigations"],
    "browser": true,
    "server": true,
    "requiredPlugins": ["agentBuilder", "agentBuilderPlatform", "features", "workflowsExtensions"],
    "requiredBundles": ["kibanaReact"],
    "optionalPlugins": ["security", "spaces", "proposals"],
    "extraPublicDirs": ["common"]
  }
}
