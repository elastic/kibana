{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "index.ts",
    "common/**/*",
    "public/**/*",
    "server/**/*",
    "../../../../../typings/**/*"
  ],
  "kbn_references": [
    "@kbn/agent-builder-browser",
    "@kbn/agent-builder-common",
    "@kbn/agent-builder-server",
    "@kbn/core",
    "@kbn/config-schema",
    "@kbn/core-security-server",
    "@kbn/features-plugin",
    "@kbn/i18n",
    "@kbn/logging-mocks",
    "@kbn/significant-events-schema",
    "@kbn/spaces-plugin",
    "@kbn/storage-adapter",
    "@kbn/workflows",
    "@kbn/workflows-extensions",
    "@kbn/workflows-management-plugin",
    "@kbn/zod",
    "@kbn/core-http-server-mocks",
    "@kbn/zod-helpers",
    "@kbn/std"
  ],
  "exclude": ["target/**/*"]
}
