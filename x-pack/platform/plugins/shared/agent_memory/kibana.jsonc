{
  "type": "plugin",
  "id": "@kbn/agent-memory-plugin",
  "owner": "@elastic/context-eng",
  "description": "Agent memory: a persistent, agent-writable knowledge base exposed as Agent Builder tools, skills, curation workflows, and an internal HTTP API.",
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "agentMemory",
    "server": true,
    "browser": false,
    "configPath": ["xpack", "agentMemory"],
    "requiredPlugins": ["agentBuilder", "features"],
    "optionalPlugins": [
      "licensing",
      "searchInferenceEndpoints",
      "spaces",
      "workflowsExtensions",
      "workflowsManagement"
    ],
    "requiredBundles": [],
    "extraPublicDirs": []
  }
}
