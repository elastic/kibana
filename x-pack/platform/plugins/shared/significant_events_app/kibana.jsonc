{
  "type": "plugin",
  "id": "@kbn/significant-events-app-plugin",
  "owner": "@elastic/obs-sig-events-team",
  "description": "Significant Events UI",
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "significantEventsApp",
    "browser": true,
    "server": false,
    "requiredPlugins": [
      "charts",
      "data",
      "licensing",
      "share",
      "significantEvents",
      "streams",
      "unifiedSearch"
    ],
    "optionalPlugins": ["agentBuilder", "cloud", "spaces"],
    "requiredBundles": ["kibanaReact", "observabilityAIAssistant", "stackConnectors"],
    "extraPublicDirs": ["common"]
  }
}
