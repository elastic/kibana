# capture-incident — credentials for the --incident-id auto mode
# =============================================================================
# Copy this file to `secrets.env` (gitignored) and fill in the values, then
# source it before running:
#
#   source x-pack/platform/packages/shared/kbn-evals-suite-significant-events/scripts/capture_incident/secrets.env
#
# Never commit real keys. The cluster URLs (Agent Builder, Overview source, local
# ES) are pinned in constants.ts, so only the API keys live here.
# =============================================================================

# --- Incident cluster: platform-logging rootly_incidents / pagerduty_incidents --
# Kibana API key on the INCIDENT cluster with Elasticsearch read on
# rootly_incidents / pagerduty_incidents + Console access. No Agent Builder needed
# (metadata is read directly). See the README "Creating the API keys" section.
export INCIDENT_KIBANA_API_KEY="<base64 incident-cluster kibana api key>"

# --- Overview cluster: Agent Builder (log-grounded symptom derivation) ----------
# Kibana API key with the agentBuilder:read privilege on the OVERVIEW cluster.
export OVERVIEW_KIBANA_API_KEY="<base64 overview-cluster kibana api key>"

# --- Overview source cluster: where the logs live (remote reindex + probe) -----
# Probe/reindex API key: cluster:["monitor"] + read on the log index pattern.
export OVERVIEW_ES_API_KEY="<base64 overview api key>"
# The remote reindex reads this — set it to the same Overview key.
export OVERVIEW_API_KEY="<base64 overview api key>"

# --- GCS service-account credentials -------------------------------------------
# ABSOLUTE path — loaded into the local ES keystore at ES startup via
# --secure-files gcs.client.default.credentials_file=$GCS_CREDENTIALS_FILE
export GCS_CREDENTIALS_FILE="/absolute/path/to/gcs-credentials.json"
