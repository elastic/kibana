{
  "dashboard_id": "isomer-corpus-buckets",
  "in_as_code": true,
  "panel": {
    "config": {
      "axis": {
        "x": {
          "domain": {
            "rounding": false,
            "type": "fit"
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "ordinal",
          "ticks": {
            "visible": true
          },
          "title": {
            "visible": true
          }
        },
        "y": {
          "domain": {
            "rounding": true,
            "type": "full"
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "linear",
          "ticks": {
            "visible": true
          },
          "title": {
            "visible": true
          }
        }
      },
      "layers": [
        {
          "data_source": {
            "query": "FROM isomer-corpus-edge-cases | MV_EXPAND tags | STATS count = COUNT(*) BY tags | SORT count DESC, tags",
            "type": "esql"
          },
          "ignore_global_filters": false,
          "sampling": 1,
          "type": "bar_horizontal",
          "x": {
            "column": "tags"
          },
          "y": [
            {
              "axis": "y",
              "color": {
                "type": "auto"
              },
              "column": "count"
            }
          ]
        }
      ],
      "legend": {
        "layout": {
          "truncate": {
            "max_lines": 1
          },
          "type": "grid"
        },
        "placement": "outside",
        "position": "right",
        "visibility": "hidden"
      },
      "styling": {
        "bars": {
          "data_labels": {
            "visible": false
          },
          "minimum_height": 1
        },
        "overlays": {
          "current_time_marker": {
            "visible": false
          },
          "partial_buckets": {
            "visible": false
          }
        }
      },
      "title": "Documents per tag (ES|QL, multivalue expanded)",
      "type": "xy"
    },
    "grid": {
      "h": 12,
      "w": 24,
      "x": 24,
      "y": 12
    },
    "id": "buckets-xy-multivalue-esql",
    "inCollapsedSection": false,
    "type": "vis"
  }
}
