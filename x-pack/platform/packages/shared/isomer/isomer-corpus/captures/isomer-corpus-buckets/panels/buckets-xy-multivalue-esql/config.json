{
  "dashboard_id": "isomer-corpus-buckets",
  "in_as_code": true,
  "panel": {
    "id": "buckets-xy-multivalue-esql",
    "type": "vis",
    "grid": {
      "x": 24,
      "y": 12,
      "w": 24,
      "h": 12
    },
    "config": {
      "type": "xy",
      "title": "Documents per tag (ES|QL, multivalue expanded)",
      "legend": {
        "visibility": "hidden",
        "placement": "outside",
        "layout": {
          "type": "grid",
          "truncate": {
            "max_lines": 1
          }
        },
        "position": "right"
      },
      "axis": {
        "x": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "ordinal",
          "domain": {
            "type": "fit",
            "rounding": false
          }
        },
        "y": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "linear",
          "domain": {
            "type": "full",
            "rounding": true
          }
        }
      },
      "styling": {
        "overlays": {
          "partial_buckets": {
            "visible": false
          },
          "current_time_marker": {
            "visible": false
          }
        },
        "bars": {
          "minimum_height": 1,
          "data_labels": {
            "visible": false
          }
        }
      },
      "layers": [
        {
          "sampling": 1,
          "ignore_global_filters": false,
          "data_source": {
            "type": "esql",
            "query": "FROM isomer-corpus-edge-cases | MV_EXPAND tags | STATS count = COUNT(*) BY tags | SORT count DESC"
          },
          "type": "bar_horizontal",
          "y": [
            {
              "column": "count",
              "axis": "y",
              "color": {
                "type": "auto"
              }
            }
          ],
          "x": {
            "column": "tags"
          }
        }
      ]
    },
    "inCollapsedSection": false
  }
}
