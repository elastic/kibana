{
  "dashboard_id": "isomer-corpus-buckets",
  "in_as_code": true,
  "panel": {
    "config": {
      "data_source": {
        "query": "FROM isomer-corpus-edge-cases | STATS count = COUNT(*), signed = SUM(signed) BY category | SORT count DESC, category",
        "type": "esql"
      },
      "ignore_global_filters": false,
      "metrics": [
        {
          "alignment": "right",
          "color": {
            "type": "auto"
          },
          "column": "count",
          "visible": true
        },
        {
          "alignment": "right",
          "color": {
            "type": "auto"
          },
          "column": "signed",
          "visible": true
        }
      ],
      "rows": [
        {
          "alignment": "left",
          "click_filter": false,
          "color": {
            "type": "auto"
          },
          "column": "category",
          "visible": true
        }
      ],
      "sampling": 1,
      "title": "Counts per category, including the missing value (ES|QL)",
      "type": "data_table"
    },
    "grid": {
      "h": 12,
      "w": 48,
      "x": 0,
      "y": 24
    },
    "id": "buckets-table-esql-missing",
    "inCollapsedSection": false,
    "type": "vis"
  }
}
