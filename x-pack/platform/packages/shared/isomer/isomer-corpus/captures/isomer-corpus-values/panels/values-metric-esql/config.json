{
  "dashboard_id": "isomer-corpus-values",
  "in_as_code": true,
  "panel": {
    "config": {
      "data_source": {
        "query": "FROM isomer-corpus-edge-cases | STATS signed = AVG(signed)",
        "type": "esql"
      },
      "ignore_global_filters": false,
      "metrics": [
        {
          "color": {
            "type": "auto"
          },
          "column": "signed",
          "type": "primary"
        }
      ],
      "sampling": 1,
      "styling": {
        "density": "default",
        "primary": {
          "labels": {
            "alignment": "left"
          },
          "position": "bottom",
          "value": {
            "alignment": "right",
            "sizing": "auto"
          }
        }
      },
      "title": "Signed average (ES|QL)",
      "type": "metric"
    },
    "grid": {
      "h": 6,
      "w": 12,
      "x": 0,
      "y": 30
    },
    "id": "values-metric-esql",
    "inCollapsedSection": false,
    "type": "vis"
  }
}
