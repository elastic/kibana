{
  "dashboard_id": "isomer-corpus-values",
  "in_as_code": true,
  "panel": {
    "config": {
      "axis": {
        "x": {
          "domain": {
            "rounding": false,
            "type": "fit"
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "ordinal",
          "ticks": {
            "visible": true
          },
          "title": {
            "visible": true
          }
        },
        "y": {
          "domain": {
            "rounding": true,
            "type": "full"
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "linear",
          "ticks": {
            "visible": true
          },
          "title": {
            "visible": true
          }
        }
      },
      "layers": [
        {
          "data_source": {
            "query": "FROM isomer-corpus-edge-cases | STATS total = SUM(huge) BY day = BUCKET(@timestamp, 1 day) | SORT day",
            "type": "esql"
          },
          "ignore_global_filters": false,
          "sampling": 1,
          "type": "area",
          "x": {
            "column": "day"
          },
          "y": [
            {
              "axis": "y",
              "color": {
                "type": "auto"
              },
              "column": "total"
            }
          ]
        }
      ],
      "legend": {
        "layout": {
          "truncate": {
            "max_lines": 1
          },
          "type": "grid"
        },
        "placement": "outside",
        "position": "right",
        "visibility": "hidden"
      },
      "styling": {
        "areas": {
          "fill": "gradient",
          "fill_opacity": 0.3
        },
        "interpolation": "linear",
        "overlays": {
          "current_time_marker": {
            "visible": false
          },
          "partial_buckets": {
            "visible": false
          }
        },
        "points": {
          "visibility": "auto"
        }
      },
      "title": "Huge values per day (ES|QL)",
      "type": "xy"
    },
    "grid": {
      "h": 12,
      "w": 24,
      "x": 0,
      "y": 18
    },
    "id": "values-xy-huge-esql",
    "inCollapsedSection": false,
    "type": "vis"
  }
}
