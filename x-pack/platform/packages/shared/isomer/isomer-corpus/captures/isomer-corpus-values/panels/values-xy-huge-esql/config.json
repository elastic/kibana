{
  "dashboard_id": "isomer-corpus-values",
  "in_as_code": true,
  "panel": {
    "id": "values-xy-huge-esql",
    "type": "vis",
    "grid": {
      "x": 0,
      "y": 18,
      "w": 24,
      "h": 12
    },
    "config": {
      "type": "xy",
      "title": "Huge values per day (ES|QL)",
      "legend": {
        "visibility": "hidden",
        "placement": "outside",
        "layout": {
          "type": "grid",
          "truncate": {
            "max_lines": 1
          }
        },
        "position": "right"
      },
      "axis": {
        "x": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "ordinal",
          "domain": {
            "type": "fit",
            "rounding": false
          }
        },
        "y": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "linear",
          "domain": {
            "type": "full",
            "rounding": true
          }
        }
      },
      "styling": {
        "overlays": {
          "partial_buckets": {
            "visible": false
          },
          "current_time_marker": {
            "visible": false
          }
        },
        "interpolation": "linear",
        "points": {
          "visibility": "auto"
        },
        "areas": {
          "fill_opacity": 0.3,
          "fill": "gradient"
        }
      },
      "layers": [
        {
          "sampling": 1,
          "ignore_global_filters": false,
          "data_source": {
            "type": "esql",
            "query": "FROM isomer-corpus-edge-cases | STATS total = SUM(huge) BY day = BUCKET(@timestamp, 1 day)"
          },
          "type": "area",
          "y": [
            {
              "column": "total",
              "axis": "y",
              "color": {
                "type": "auto"
              }
            }
          ],
          "x": {
            "column": "day"
          }
        }
      ]
    },
    "inCollapsedSection": false
  }
}
