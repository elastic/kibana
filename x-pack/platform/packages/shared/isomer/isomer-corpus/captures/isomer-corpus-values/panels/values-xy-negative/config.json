{
  "dashboard_id": "isomer-corpus-values",
  "in_as_code": true,
  "panel": {
    "id": "values-xy-negative",
    "type": "vis",
    "grid": {
      "x": 0,
      "y": 6,
      "w": 24,
      "h": 12
    },
    "config": {
      "type": "xy",
      "title": "Signed values per 6 hours (crosses zero)",
      "legend": {
        "visibility": "hidden",
        "placement": "outside",
        "layout": {
          "type": "grid",
          "truncate": {
            "max_lines": 1
          }
        },
        "position": "right"
      },
      "axis": {
        "x": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "domain": {
            "type": "fit",
            "rounding": false
          }
        },
        "y": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "linear",
          "domain": {
            "type": "full",
            "rounding": true
          }
        }
      },
      "styling": {
        "overlays": {
          "partial_buckets": {
            "visible": false
          },
          "current_time_marker": {
            "visible": false
          }
        },
        "bars": {
          "minimum_height": 1,
          "data_labels": {
            "visible": false
          }
        }
      },
      "layers": [
        {
          "sampling": 1,
          "ignore_global_filters": false,
          "data_source": {
            "type": "data_view_spec",
            "name": "isomer-corpus-edge-cases",
            "index_pattern": "isomer-corpus-edge-cases",
            "time_field": "@timestamp"
          },
          "type": "bar",
          "y": [
            {
              "field": "signed",
              "empty_as_null": false,
              "operation": "sum",
              "axis": "y",
              "color": {
                "type": "auto"
              }
            }
          ],
          "x": {
            "operation": "date_histogram",
            "field": "@timestamp",
            "suggested_interval": "6h",
            "use_original_time_range": false,
            "include_empty_rows": true,
            "drop_partial_intervals": false
          }
        }
      ]
    },
    "inCollapsedSection": false
  }
}
