{
  "dashboard_id": "edf84fe0-e1a0-11e7-b6d5-4dc382ef7f5b",
  "in_as_code": true,
  "panel": {
    "id": "15",
    "type": "vis",
    "grid": {
      "x": 0,
      "y": 7,
      "w": 24,
      "h": 7
    },
    "config": {
      "type": "xy",
      "title": "[Logs] Response Codes Over Time + Annotations",
      "legend": {
        "visibility": "visible",
        "placement": "outside",
        "layout": {
          "type": "grid",
          "truncate": {
            "max_lines": 1,
            "enabled": true
          }
        },
        "position": "bottom"
      },
      "axis": {
        "x": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "domain": {
            "type": "fit",
            "rounding": false
          }
        },
        "y": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "linear",
          "domain": {
            "type": "full",
            "rounding": true
          }
        }
      },
      "styling": {
        "overlays": {
          "partial_buckets": {
            "visible": false
          },
          "current_time_marker": {
            "visible": false
          }
        },
        "fitting": {
          "type": "none"
        },
        "interpolation": "linear",
        "points": {
          "visibility": "auto"
        },
        "areas": {
          "fill_opacity": 0.5,
          "fill": "solid"
        }
      },
      "layers": [
        {
          "sampling": 1,
          "ignore_global_filters": false,
          "data_source": {
            "type": "data_view_reference",
            "ref_id": "90943e30-9a47-11e8-b64d-95841ca0b247"
          },
          "type": "area_percentage",
          "breakdown_by": {
            "operation": "filters",
            "filters": [
              {
                "filter": {
                  "language": "kql",
                  "expression": "response.keyword >= 200 and response.keyword < 400"
                },
                "label": "HTTP 2xx and 3xx"
              },
              {
                "filter": {
                  "language": "kql",
                  "expression": "response.keyword >= 400 and response.keyword < 500"
                },
                "label": "HTTP 4xx"
              },
              {
                "filter": {
                  "language": "kql",
                  "expression": "response.keyword >= 500"
                },
                "label": "HTTP 5xx"
              }
            ],
            "color": {
              "mode": "categorical",
              "palette": "LEGACY_PALETTE_default",
              "mapping": []
            }
          },
          "y": [
            {
              "label": "Response Code Count",
              "empty_as_null": true,
              "operation": "count",
              "axis": "y",
              "color": {
                "type": "auto"
              }
            }
          ],
          "x": {
            "operation": "date_histogram",
            "field": "timestamp",
            "suggested_interval": "auto",
            "use_original_time_range": false,
            "include_empty_rows": true,
            "drop_partial_intervals": false
          }
        },
        {
          "ignore_global_filters": true,
          "data_source": {
            "type": "data_view_reference",
            "ref_id": "90943e30-9a47-11e8-b64d-95841ca0b247"
          },
          "type": "annotations",
          "events": [
            {
              "color": {
                "type": "static",
                "color": "#D33115"
              },
              "icon": "asterisk",
              "type": "query",
              "query": {
                "language": "lucene",
                "expression": "tags:error AND tags:security"
              },
              "time_field": "timestamp",
              "label": "Event",
              "extra_fields": [
                "geo.src"
              ]
            }
          ]
        }
      ],
      "hide_title": false
    },
    "inCollapsedSection": false
  }
}
