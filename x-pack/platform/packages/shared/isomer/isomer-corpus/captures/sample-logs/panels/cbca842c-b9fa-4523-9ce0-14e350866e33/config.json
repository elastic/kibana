{
  "dashboard_id": "edf84fe0-e1a0-11e7-b6d5-4dc382ef7f5b",
  "in_as_code": true,
  "panel": {
    "id": "cbca842c-b9fa-4523-9ce0-14e350866e33",
    "type": "vis",
    "grid": {
      "x": 24,
      "y": 47,
      "w": 24,
      "h": 13
    },
    "config": {
      "type": "xy",
      "title": "[Logs] Bytes distribution",
      "legend": {
        "visibility": "auto",
        "placement": "outside",
        "layout": {
          "type": "grid",
          "truncate": {
            "max_lines": 1
          }
        },
        "position": "right"
      },
      "axis": {
        "x": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "linear",
          "domain": {
            "type": "fit",
            "rounding": false
          }
        },
        "y": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "linear",
          "domain": {
            "type": "full",
            "rounding": true
          }
        }
      },
      "styling": {
        "overlays": {
          "partial_buckets": {
            "visible": false
          },
          "current_time_marker": {
            "visible": false
          }
        },
        "bars": {
          "minimum_height": 1,
          "data_labels": {
            "visible": false
          }
        }
      },
      "layers": [
        {
          "sampling": 1,
          "ignore_global_filters": false,
          "data_source": {
            "type": "esql",
            "query": "FROM kibana_sample_data_logs\n| INLINESTATS total_visits = COUNT()\n| STATS visits = COUNT() by bytes = bucket(bytes, 1000, 0, 100000), total_visits\n| EVAL percentage = (TO_DOUBLE(visits) / total_visits)\n| EVAL percentage = ROUND(percentage, 3)\n| DROP total_visits, visits"
          },
          "type": "bar_stacked",
          "y": [
            {
              "column": "percentage",
              "format": {
                "type": "percent",
                "decimals": 1,
                "compact": false
              },
              "axis": "y",
              "color": {
                "type": "auto"
              }
            }
          ],
          "x": {
            "column": "bytes"
          }
        }
      ]
    },
    "inCollapsedSection": false
  }
}
