{
  "dashboard_id": "isomer-corpus-long-titles",
  "in_as_code": true,
  "panel": {
    "config": {
      "data_source": {
        "index_pattern": "isomer-corpus-edge-cases",
        "name": "isomer-corpus-edge-cases",
        "time_field": "@timestamp",
        "type": "data_view_spec"
      },
      "group_by": [
        {
          "color": {
            "mapping": [],
            "mode": "categorical",
            "palette": "default"
          },
          "fields": [
            "long_label"
          ],
          "limit": 10,
          "operation": "terms",
          "rank_by": {
            "direction": "desc",
            "metric_index": 0,
            "type": "metric"
          }
        }
      ],
      "ignore_global_filters": false,
      "legend": {
        "nested": false,
        "position": "right",
        "truncate_after_lines": 1,
        "visibility": "auto"
      },
      "metrics": [
        {
          "color": {
            "type": "auto"
          },
          "empty_as_null": false,
          "operation": "count"
        }
      ],
      "sampling": 1,
      "styling": {
        "donut_hole": "m",
        "labels": {
          "position": "outside",
          "visible": true
        },
        "values": {
          "mode": "percentage",
          "percent_decimals": 2,
          "visible": true
        }
      },
      "title": "A panel title long enough to overflow the panel header at every grid width, so truncation, wrapping and tooltips are exercised by each renderer",
      "type": "pie"
    },
    "grid": {
      "h": 12,
      "w": 12,
      "x": 24,
      "y": 0
    },
    "id": "long-pie-legend",
    "inCollapsedSection": false,
    "type": "vis"
  }
}
