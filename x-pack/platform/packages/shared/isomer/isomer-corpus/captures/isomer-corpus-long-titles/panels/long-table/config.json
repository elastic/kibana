{
  "dashboard_id": "isomer-corpus-long-titles",
  "in_as_code": true,
  "panel": {
    "id": "long-table",
    "type": "vis",
    "grid": {
      "x": 0,
      "y": 12,
      "w": 48,
      "h": 10
    },
    "config": {
      "type": "data_table",
      "title": "A panel title long enough to overflow the panel header at every grid width, so truncation, wrapping and tooltips are exercised by each renderer",
      "sampling": 1,
      "ignore_global_filters": false,
      "data_source": {
        "type": "data_view_spec",
        "name": "isomer-corpus-edge-cases",
        "index_pattern": "isomer-corpus-edge-cases",
        "time_field": "@timestamp"
      },
      "metrics": [
        {
          "empty_as_null": false,
          "operation": "count",
          "visible": true,
          "color": {
            "type": "auto"
          },
          "alignment": "right"
        }
      ],
      "rows": [
        {
          "operation": "terms",
          "fields": [
            "long_label"
          ],
          "limit": 10,
          "rank_by": {
            "type": "metric",
            "metric_index": 0,
            "direction": "desc"
          },
          "visible": true,
          "alignment": "left",
          "color": {
            "type": "auto"
          },
          "click_filter": false
        }
      ]
    },
    "inCollapsedSection": false
  }
}
