{
  "dashboard_id": "isomer-corpus-long-titles",
  "in_as_code": true,
  "panel": {
    "config": {
      "axis": {
        "x": {
          "domain": {
            "rounding": false,
            "type": "fit"
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "ticks": {
            "visible": true
          },
          "title": {
            "visible": true
          }
        },
        "y": {
          "domain": {
            "rounding": true,
            "type": "full"
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "linear",
          "ticks": {
            "visible": true
          },
          "title": {
            "visible": true
          }
        }
      },
      "layers": [
        {
          "data_source": {
            "index_pattern": "isomer-corpus-edge-cases",
            "name": "isomer-corpus-edge-cases",
