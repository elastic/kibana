{
  "dashboard_id": "isomer-corpus-long-titles",
  "in_as_code": true,
  "panel": {
    "id": "long-xy-labels",
    "type": "vis",
    "grid": {
      "x": 0,
      "y": 0,
      "w": 24,
      "h": 12
    },
    "config": {
      "type": "xy",
      "title": "A panel title long enough to overflow the panel header at every grid width, so truncation, wrapping and tooltips are exercised by each renderer",
      "legend": {
        "visibility": "hidden",
        "placement": "outside",
        "layout": {
          "type": "grid",
          "truncate": {
            "max_lines": 1
          }
        },
        "position": "right"
      },
      "axis": {
        "x": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "domain": {
            "type": "fit",
            "rounding": false
          }
        },
        "y": {
          "title": {
            "visible": true
          },
          "ticks": {
            "visible": true
          },
          "grid": {
            "visible": true
          },
          "labels": {
            "orientation": "horizontal"
          },
          "scale": "linear",
          "domain": {
            "type": "full",
            "rounding": true
          }
        }
      },
      "styling": {
        "overlays": {
          "partial_buckets": {
            "visible": false
          },
          "current_time_marker": {
            "visible": false
          }
        },
        "bars": {
          "minimum_height": 1,
          "data_labels": {
            "visible": false
          }
        }
      },
      "layers": [
        {
          "sampling": 1,
          "ignore_global_filters": false,
          "data_source": {
            "type": "data_view_spec",
            "name": "isomer-corpus-edge-cases",
            "index_pattern": "isomer-corpus-edge-cases",
            "time_field": "@timestamp"
          },
          "type": "bar_horizontal",
          "y": [
            {
              "empty_as_null": false,
              "operation": "count",
              "axis": "y",
              "color": {
                "type": "auto"
              }
            }
          ],
          "x": {
            "operation": "terms",
            "fields": [
              "long_label"
            ],
            "limit": 10,
            "rank_by": {
              "type": "metric",
              "metric_index": 0,
              "direction": "desc"
            }
          }
        }
      ]
    },
    "inCollapsedSection": false
  }
}
