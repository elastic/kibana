{
  "dashboard": "sample-logs",
  "panel": "01d8e435-91c0-484f-a11e-856747050b0a",
  "config": {
    "type": "metric",
    "title": "count_4xx & count_rest & HTTP 4xx of (empty)",
    "sampling": 1,
    "ignore_global_filters": false,
    "data_source": {
      "type": "esql",
      "query": "FROM kibana_sample_data_logs\n| EVAL type = CASE(TO_INTEGER(response.keyword) >= 400 and TO_INTEGER(response.keyword) < 500, \"4xx\", \"Other\")\n| STATS count = COUNT(*) by type\n| EVAL count_4xx = CASE(type == \"4xx\", count), count_rest = CASE(type == \"Other\", count)\n| DROP count, type\n| STATS count_4xx = MAX(count_4xx), count_rest = MAX(count_rest)\n| EVAL percentage = ROUND(count_4xx / TO_DOUBLE(count_4xx + count_rest), 3)\n| RENAME percentage as `HTTP 4xx (%)`\n| DROP count_4xx, count_rest"
    },
    "styling": {
