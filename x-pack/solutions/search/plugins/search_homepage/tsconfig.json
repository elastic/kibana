{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
  },
  "include": [
    "__mocks__/**/*",
    "common/**/*",
    "public/**/*",
    "server/**/*",
    "test/scout/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/kibana-react-plugin",
    "@kbn/i18n-react",
    "@kbn/shared-ux-router",
    "@kbn/i18n",
    "@kbn/console-plugin",
    "@kbn/usage-collection-plugin",
    "@kbn/config-schema",
    "@kbn/analytics",
    "@kbn/search-navigation",
    "@kbn/search-shared-ui",
    "@kbn/scout-search",
    "@kbn/elasticsearch-home",
  ],
  "exclude": [
    "target/**/*"
  ]
}
