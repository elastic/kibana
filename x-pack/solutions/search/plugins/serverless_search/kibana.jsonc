{
  "type": "plugin",
  "id": "@kbn/serverless-search",
  "owner": [
    "@elastic/search-ml-ux"
  ],
  "group": "search",
  "visibility": "private",
  "description": "Serverless customizations for search.",
  "plugin": {
    "id": "serverlessSearch",
    "browser": true,
    "server": true,
    "configPath": [
      "xpack",
      "serverless",
      "search"
    ],
    "requiredPlugins": [
      "cloud",
      "console",
      "dataViews",
      "dashboard",
      "devTools",
      "discover",
      "features",
      "management",
      "navigation",
      "searchprofiler",
      "security",
      "serverless",
      "searchHomepage",
      "share",
      "visualizations",
    ],
    "optionalPlugins": [
      "agentBuilder",
      "indexManagement",
      "contentConnectors",
      "searchInferenceEndpoints",
      "searchPlayground",
      "workflowsManagement",
    ],
    "requiredBundles": [
      "kibanaReact"
    ]
  }
}
