{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node",
      "react",
      "@kbn/ambient-ui-types",
      "@emotion/react/types/css-prop"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "fixtures/*.json",
    ".storybook/**/*.ts"
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/dev-cli-runner",
    "@kbn/i18n",
    "@kbn/repo-info",
    "@kbn/storybook",
    "@kbn/test-jest-helpers",
    "@kbn/ui-callout"
  ]
}
