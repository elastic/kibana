{
  "type": "plugin",
  "id": "@kbn/nightshift-plugin",
  "owner": ["@elastic/nightshift-context-and-research-team", "@elastic/nightshift-sre-agent-team"],
  "group": "observability",
  "visibility": "private",
  "description": "Nightshift UI",
  "plugin": {
    "id": "nightshift",
    "browser": true,
    "server": false,
    "requiredPlugins": [
      "charts",
      "data",
      "dataViews",
      "lens",
      "observabilityShared",
      "share",
      "significantEvents",
      "unifiedSearch"
    ],
    "optionalPlugins": ["agentBuilder", "serverless", "spaces"],
    "requiredBundles": ["kibanaReact"]
  }
}
