{
  "type": "plugin",
  "id": "@kbn/nightshift-plugin",
  "owner": ["@elastic/nightshift"],
  "group": "observability",
  "visibility": "private",
  "description": "Nightshift UI",
  "plugin": {
    "id": "nightshift",
    "browser": true,
    "server": true,
    "requiredPlugins": [
      "charts",
      "data",
      "dataViews",
      "features",
      "inference",
      "lens",
      "licensing",
      "nightshiftSources",
      "observabilityShared",
      "share",
      "significantEvents",
      "unifiedSearch"
    ],
    "optionalPlugins": [
      "agentBuilder",
      "agenticInvestigations",
      "cps",
      "nightshiftInvestigations",
      "serverless",
      "spaces",
      "triggersActionsUi"
    ],
    "requiredBundles": ["esql", "kibanaReact", "nightshiftInvestigations", "stackConnectors"]
  }
}
