{
  "type": "plugin",
  "id": "@kbn/serverless-observability",
  "owner": ["@elastic/observability-ui"],
  "group": "observability",
  "visibility": "private",
  "description": "Serverless customizations for observability.",
  "plugin": {
    "id": "serverlessObservability",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "serverless", "observability"],
    "requiredPlugins": [
      "serverless",
      "observability",
      "observabilityShared",
      "management",
      "discover",
      "security",
      "navigation"
    ],
    "optionalPlugins": [
      "cases",
      "streams",
      "observabilityAIAssistant",
      "workflowsManagement",
      "profiling",
      "entityInventoryApp"
    ],
    // Solution-nav targets. Also an allowlist for dynamic contract resolution.
    "runtimePluginDependencies": [
      "agentBuilder",
      "apm",
      "contextEngine",
      "dashboard",
      "devTools",
      "digitalExperience",
      "fleet",
      "infra",
      "ml",
      "observabilityAlerting",
      "observabilityOnboarding",
      "slo",
      "streamsApp",
      "synthetics"
    ],
    "requiredBundles": ["significantEvents"]
  }
}
