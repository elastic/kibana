{
  "type": "plugin",
  "id": "@kbn/significant-events-app-plugin",
  "owner": "@elastic/nightshift",
  "description": "Significant Events UI",
  "group": "observability",
  "visibility": "private",
  "plugin": {
    "id": "significantEventsApp",
    "browser": true,
    "server": false,
    "requiredPlugins": [
      "charts",
      "data",
      "inference",
      "licensing",
      "nightshiftSources",
      "share",
      "significantEvents",
      "unifiedSearch",
    ],
    "optionalPlugins": ["agentBuilder", "cloud", "cps", "spaces"],
    "requiredBundles": ["esql", "kibanaReact", "stackConnectors"],
    "extraPublicDirs": ["common"],
  },
}
