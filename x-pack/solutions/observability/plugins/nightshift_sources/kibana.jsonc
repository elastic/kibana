{
  "type": "plugin",
  "id": "@kbn/nightshift-sources-plugin",
  "owner": "@elastic/nightshift-sre-agent-team",
  "group": "observability",
  "visibility": "private",
  "description": "Nightshift Sources — the space-scoped catalog of ES|QL sources every Nightshift engine consumes",
  "plugin": {
    "id": "nightshiftSources",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "nightshiftSources"],
    // Route privileges (read_nightshift, manage_nightshift) are registered by the `nightshift`
    // obs plugin's feature. It can't be a requiredPlugin (cycle via significantEvents), but it
    // must be loaded for the routes to be accessible — the serverless configs keep both in sync.
    "requiredPlugins": [],
    "optionalPlugins": ["features"],
    "requiredBundles": []
  }
}
