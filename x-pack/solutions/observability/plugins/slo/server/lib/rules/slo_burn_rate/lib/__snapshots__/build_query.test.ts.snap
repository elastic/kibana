    ],
  },
}
`;

exports[`buildEvaluationQuery() should return a valid query for occurrences 1`] = `
Object {
  "filter": Object {
    "bool": Object {
      "filter": Array [
        Object {
          "term": Object {
            "slo.id": "test-slo",
          },
        },
        Object {
          "term": Object {
            "slo.revision": 1,
          },
        },
        Object {
          "exists": Object {
            "field": "slo.instanceId",
          },
        },
        Object {
          "range": Object {
            "@timestamp": Object {
              "gte": "2022-12-28T23:57:00.000Z",
              "lt": "2022-12-31T23:57:00.000Z",
            },
          },
        },
      ],
    },
  },
  "params": Array [
    Object {
      "target": 0.999,
    },
    Object {
      "w0_short_from": "2022-12-31T23:52:00.000Z",
    },
    Object {
      "w0_short_to": "2022-12-31T23:57:00.000Z",
    },
    Object {
      "w0_long_from": "2022-12-31T22:57:00.000Z",
    },
    Object {
      "w0_long_to": "2022-12-31T23:57:00.000Z",
    },
    Object {
      "w0_threshold": 14.4,
    },
    Object {
      "w1_short_from": "2022-12-31T23:27:00.000Z",
    },
    Object {
      "w1_short_to": "2022-12-31T23:57:00.000Z",
    },
    Object {
      "w1_long_from": "2022-12-31T17:57:00.000Z",
    },
    Object {
      "w1_long_to": "2022-12-31T23:57:00.000Z",
    },
    Object {
      "w1_threshold": 6,
    },
    Object {
      "w2_short_from": "2022-12-31T21:57:00.000Z",
    },
    Object {
      "w2_short_to": "2022-12-31T23:57:00.000Z",
    },
    Object {
      "w2_long_from": "2022-12-30T23:57:00.000Z",
    },
    Object {
      "w2_long_to": "2022-12-31T23:57:00.000Z",
    },
    Object {
      "w2_threshold": 3,
    },
    Object {
      "w3_short_from": "2022-12-31T17:57:00.000Z",
    },
    Object {
      "w3_short_to": "2022-12-31T23:57:00.000Z",
    },
    Object {
      "w3_long_from": "2022-12-28T23:57:00.000Z",
    },
    Object {
      "w3_long_to": "2022-12-31T23:57:00.000Z",
    },
    Object {
      "w3_threshold": 1,
    },
  ],
  "query": "FROM .slo-observability.sli-v3*
| STATS w0_short_good = SUM(slo.numerator) WHERE @timestamp >= ?w0_short_from AND @timestamp < ?w0_short_to, w0_short_total = SUM(slo.denominator) WHERE @timestamp >= ?w0_short_from AND @timestamp < ?w0_short_to, w0_long_good = SUM(slo.numerator) WHERE @timestamp >= ?w0_long_from AND @timestamp < ?w0_long_to, w0_long_total = SUM(slo.denominator) WHERE @timestamp >= ?w0_long_from AND @timestamp < ?w0_long_to, w1_short_good = SUM(slo.numerator) WHERE @timestamp >= ?w1_short_from AND @timestamp < ?w1_short_to, w1_short_total = SUM(slo.denominator) WHERE @timestamp >= ?w1_short_from AND @timestamp < ?w1_short_to, w1_long_good = SUM(slo.numerator) WHERE @timestamp >= ?w1_long_from AND @timestamp < ?w1_long_to, w1_long_total = SUM(slo.denominator) WHERE @timestamp >= ?w1_long_from AND @timestamp < ?w1_long_to, w2_short_good = SUM(slo.numerator) WHERE @timestamp >= ?w2_short_from AND @timestamp < ?w2_short_to, w2_short_total = SUM(slo.denominator) WHERE @timestamp >= ?w2_short_from AND @timestamp < ?w2_short_to, w2_long_good = SUM(slo.numerator) WHERE @timestamp >= ?w2_long_from AND @timestamp < ?w2_long_to, w2_long_total = SUM(slo.denominator) WHERE @timestamp >= ?w2_long_from AND @timestamp < ?w2_long_to, w3_short_good = SUM(slo.numerator) WHERE @timestamp >= ?w3_short_from AND @timestamp < ?w3_short_to, w3_short_total = SUM(slo.denominator) WHERE @timestamp >= ?w3_short_from AND @timestamp < ?w3_short_to, w3_long_good = SUM(slo.numerator) WHERE @timestamp >= ?w3_long_from AND @timestamp < ?w3_long_to, w3_long_total = SUM(slo.denominator) WHERE @timestamp >= ?w3_long_from AND @timestamp < ?w3_long_to BY instance_id = slo.instanceId
| EVAL w0_short_burn_rate = CASE(w0_short_total > 0, (1 - TO_DOUBLE(w0_short_good) / w0_short_total) / (1 - ?target), 0.0), w0_long_burn_rate = CASE(w0_long_total > 0, (1 - TO_DOUBLE(w0_long_good) / w0_long_total) / (1 - ?target), 0.0), w1_short_burn_rate = CASE(w1_short_total > 0, (1 - TO_DOUBLE(w1_short_good) / w1_short_total) / (1 - ?target), 0.0), w1_long_burn_rate = CASE(w1_long_total > 0, (1 - TO_DOUBLE(w1_long_good) / w1_long_total) / (1 - ?target), 0.0), w2_short_burn_rate = CASE(w2_short_total > 0, (1 - TO_DOUBLE(w2_short_good) / w2_short_total) / (1 - ?target), 0.0), w2_long_burn_rate = CASE(w2_long_total > 0, (1 - TO_DOUBLE(w2_long_good) / w2_long_total) / (1 - ?target), 0.0), w3_short_burn_rate = CASE(w3_short_total > 0, (1 - TO_DOUBLE(w3_short_good) / w3_short_total) / (1 - ?target), 0.0), w3_long_burn_rate = CASE(w3_long_total > 0, (1 - TO_DOUBLE(w3_long_good) / w3_long_total) / (1 - ?target), 0.0)
| EVAL window_index = CASE(w0_short_burn_rate >= ?w0_threshold AND w0_long_burn_rate >= ?w0_threshold, 0, w1_short_burn_rate >= ?w1_threshold AND w1_long_burn_rate >= ?w1_threshold, 1, w2_short_burn_rate >= ?w2_threshold AND w2_long_burn_rate >= ?w2_threshold, 2, w3_short_burn_rate >= ?w3_threshold AND w3_long_burn_rate >= ?w3_threshold, 3)
| WHERE window_index IS NOT NULL
| EVAL short_window_burn_rate = CASE(window_index == 0, w0_short_burn_rate, window_index == 1, w1_short_burn_rate, window_index == 2, w2_short_burn_rate, window_index == 3, w3_short_burn_rate), long_window_burn_rate = CASE(window_index == 0, w0_long_burn_rate, window_index == 1, w1_long_burn_rate, window_index == 2, w2_long_burn_rate, window_index == 3, w3_long_burn_rate)
| EVAL evaluation_value = LEAST(short_window_burn_rate, long_window_burn_rate)
| SORT window_index ASC, evaluation_value DESC, instance_id ASC
| KEEP instance_id, window_index, short_window_burn_rate, long_window_burn_rate
| LIMIT 1001",
}
`;

