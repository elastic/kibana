      "w3_long_to": "2022-12-31T23:56:00.000Z",
    },
    Object {
      "w3_long_slices": 2160,
    },
    Object {
      "w3_threshold": 1,
    },
  ],
  "query": "FROM .slo-observability.sli-v3*
| STATS w0_short_good = SUM(slo.isGoodSlice) WHERE @timestamp >= ?w0_short_from AND @timestamp < ?w0_short_to, w0_short_total = COUNT(slo.isGoodSlice) WHERE @timestamp >= ?w0_short_from AND @timestamp < ?w0_short_to, w0_long_good = SUM(slo.isGoodSlice) WHERE @timestamp >= ?w0_long_from AND @timestamp < ?w0_long_to, w0_long_total = COUNT(slo.isGoodSlice) WHERE @timestamp >= ?w0_long_from AND @timestamp < ?w0_long_to, w1_short_good = SUM(slo.isGoodSlice) WHERE @timestamp >= ?w1_short_from AND @timestamp < ?w1_short_to, w1_short_total = COUNT(slo.isGoodSlice) WHERE @timestamp >= ?w1_short_from AND @timestamp < ?w1_short_to, w1_long_good = SUM(slo.isGoodSlice) WHERE @timestamp >= ?w1_long_from AND @timestamp < ?w1_long_to, w1_long_total = COUNT(slo.isGoodSlice) WHERE @timestamp >= ?w1_long_from AND @timestamp < ?w1_long_to, w2_short_good = SUM(slo.isGoodSlice) WHERE @timestamp >= ?w2_short_from AND @timestamp < ?w2_short_to, w2_short_total = COUNT(slo.isGoodSlice) WHERE @timestamp >= ?w2_short_from AND @timestamp < ?w2_short_to, w2_long_good = SUM(slo.isGoodSlice) WHERE @timestamp >= ?w2_long_from AND @timestamp < ?w2_long_to, w2_long_total = COUNT(slo.isGoodSlice) WHERE @timestamp >= ?w2_long_from AND @timestamp < ?w2_long_to, w3_short_good = SUM(slo.isGoodSlice) WHERE @timestamp >= ?w3_short_from AND @timestamp < ?w3_short_to, w3_short_total = COUNT(slo.isGoodSlice) WHERE @timestamp >= ?w3_short_from AND @timestamp < ?w3_short_to, w3_long_good = SUM(slo.isGoodSlice) WHERE @timestamp >= ?w3_long_from AND @timestamp < ?w3_long_to, w3_long_total = COUNT(slo.isGoodSlice) WHERE @timestamp >= ?w3_long_from AND @timestamp < ?w3_long_to BY instance_id = slo.instanceId
| EVAL w0_short_burn_rate = CASE(w0_short_total > 0, (TO_DOUBLE(w0_short_total - w0_short_good) / ?w0_short_slices) / (1 - ?target), 0.0), w0_long_burn_rate = CASE(w0_long_total > 0, (TO_DOUBLE(w0_long_total - w0_long_good) / ?w0_long_slices) / (1 - ?target), 0.0), w1_short_burn_rate = CASE(w1_short_total > 0, (TO_DOUBLE(w1_short_total - w1_short_good) / ?w1_short_slices) / (1 - ?target), 0.0), w1_long_burn_rate = CASE(w1_long_total > 0, (TO_DOUBLE(w1_long_total - w1_long_good) / ?w1_long_slices) / (1 - ?target), 0.0), w2_short_burn_rate = CASE(w2_short_total > 0, (TO_DOUBLE(w2_short_total - w2_short_good) / ?w2_short_slices) / (1 - ?target), 0.0), w2_long_burn_rate = CASE(w2_long_total > 0, (TO_DOUBLE(w2_long_total - w2_long_good) / ?w2_long_slices) / (1 - ?target), 0.0), w3_short_burn_rate = CASE(w3_short_total > 0, (TO_DOUBLE(w3_short_total - w3_short_good) / ?w3_short_slices) / (1 - ?target), 0.0), w3_long_burn_rate = CASE(w3_long_total > 0, (TO_DOUBLE(w3_long_total - w3_long_good) / ?w3_long_slices) / (1 - ?target), 0.0)
| EVAL window_index = CASE(w0_short_burn_rate >= ?w0_threshold AND w0_long_burn_rate >= ?w0_threshold, 0, w1_short_burn_rate >= ?w1_threshold AND w1_long_burn_rate >= ?w1_threshold, 1, w2_short_burn_rate >= ?w2_threshold AND w2_long_burn_rate >= ?w2_threshold, 2, w3_short_burn_rate >= ?w3_threshold AND w3_long_burn_rate >= ?w3_threshold, 3)
| WHERE window_index IS NOT NULL
| EVAL short_window_burn_rate = CASE(window_index == 0, w0_short_burn_rate, window_index == 1, w1_short_burn_rate, window_index == 2, w2_short_burn_rate, window_index == 3, w3_short_burn_rate), long_window_burn_rate = CASE(window_index == 0, w0_long_burn_rate, window_index == 1, w1_long_burn_rate, window_index == 2, w2_long_burn_rate, window_index == 3, w3_long_burn_rate)
| EVAL evaluation_value = LEAST(short_window_burn_rate, long_window_burn_rate)
| SORT window_index ASC, evaluation_value DESC, instance_id ASC
| KEEP instance_id, window_index, short_window_burn_rate, long_window_burn_rate
| LIMIT 1001",
}
`;
