exports[`getSLIRoutingPipelineTemplate routes with a cutover guard 1`] = `
Object {
  "_meta": Object {
    "description": "SLO SLI index routing",
    "managed": true,
    "managed_by": "observability",
    "routing": Object {
      "after": "M",
      "before": "d",
      "cutover": 1796083200000,
    },
    "template_version": 3.6,
    "version": 3.6,
  },
  "description": "Routes SLO rollup documents to time-based SLI indices",
  "id": ".slo-observability.sli.routing-v3.6",
  "processors": Array [
    Object {
      "date": Object {
        "description": "Normalize the timestamp for the cutover guard",
        "field": "@timestamp",
        "formats": Array [
          "UNIX_MS",
          "ISO8601",
          "yyyy-MM-dd'T'HH:mm:ss.SSSXX",
        ],
        "output_format": "yyyy-MM-dd'T'HH:mm:ss.SSSXXX",
        "target_field": "slo_routing.timestamp",
      },
    },
    Object {
      "script": Object {
        "description": "Pick the index rounding, honoring the cutover guard",
        "lang": "painless",
        "params": Object {
          "after": "M",
          "before": "d",
          "cutover": 1796083200000,
        },
        "source": "long ms = ZonedDateTime.parse(ctx.slo_routing.timestamp).toInstant().toEpochMilli(); ctx.slo_routing.rounding = (params.cutover != null && ms < params.cutover) ? params.before : params.after;",
      },
    },
    Object {
      "date_index_name": Object {
        "date_formats": Array [
          "UNIX_MS",
          "ISO8601",
          "yyyy-MM-dd'T'HH:mm:ss.SSSXX",
        ],
        "date_rounding": "{{{slo_routing.rounding}}}",
        "field": "@timestamp",
        "index_name_prefix": ".slo-observability.sli-v3.6.",
      },
    },
    Object {
      "remove": Object {
        "field": "slo_routing",
        "ignore_missing": true,
      },
    },
  ],
}
`;

