{
  "type": "plugin",
  "id": "@kbn/significant-events-plugin",
  "owner": "@elastic/nightshift",
  "description": "Significant Events",
  "group": "observability",
  "visibility": "private",
  "plugin": {
    "id": "significantEvents",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "significantEvents"],
    "requiredPlugins": [
      "actions",
      "alerting",
      "alertingVTwo",
      "encryptedSavedObjects",
      "inference",
      "licensing",
      "nightshiftSources",
      "security",
      "fieldsMetadata",
    ],
    "optionalPlugins": [
      "agentBuilder",
      "agentBuilderSml",
      "cloud",
      "cps",
      "nightshiftInvestigations",
      "serverless",
      "spaces",
      "workflowsExtensions",
      "workflowsManagement",
    ],
    "requiredBundles": [],
    "extraPublicDirs": ["common"],
  },
}
