exports[`optimizer input for investigator rounds payment 503s from an unavailable fraud-check dependency gives the Cortex optimizer the same input 1`] = `
Object {
  "assistantMessage": "payment 503s come from fraud-check being unavailable since 14:10; traces index listing failed.",
  "toolCalls": Array [
    Object {
      "params": Object {
        "command": "esql \\"FROM logs-* | WHERE service.name == \\\\\\"payment\\\\\\" | LIMIT 20\\"",
      },
      "results": Array [
        Object {
          "data": Object {
            "exit_code": 0,
            "stdout": "payment 503 upstream fraud-check unavailable",
          },
          "type": "other",
        },
      ],
      "tool_call_id": "p-2",
      "tool_id": "nightshift_sandbox_bash",
    },
    Object {
      "params": Object {
        "content": "payment 503s start 14:10",
        "file_path": "/workspace/notes.md",
      },
      "results": Array [
        Object {
          "data": Object {
            "ok": true,
          },
          "type": "other",
        },
      ],
      "tool_call_id": "p-4",
      "tool_id": "nightshift_sandbox_write_file",
    },
    Object {
      "params": Object {
        "command": "curl -s \\"$CONNECTOR_CONFIG_URL/_cat/indices/traces-*?v\\"",
      },
      "results": Array [
        Object {
          "data": Object {
            "message": "connection reset by peer",
          },
          "type": "error",
        },
      ],
      "tool_call_id": "p-5",
      "tool_id": "nightshift_sandbox_bash",
    },
  ],
  "userMessage": "Why is payment returning 503?",
}
`;

