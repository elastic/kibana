{
  "type": "plugin",
  "id": "@kbn/nightshift-investigations-plugin",
  "owner": [
    "@elastic/nightshift-context-and-research-team",
    "@elastic/nightshift-sre-agent-team",
    "@elastic/nightshift-investigations-team"
  ],
  "group": "observability",
  "visibility": "private",
  "description": "Nightshift Investigations — domain API for starting and reading investigations",
  "plugin": {
    "id": "nightshiftInvestigations",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "nightshift_investigations"],
    "requiredPlugins": ["share"],
    "optionalPlugins": [
      "actions",
      "agentBuilder",
      "agenticInvestigations",
      "contextEngine",
      "encryptedSavedObjects",
      "inference",
      "proposals",
      "ruleRegistry",
      "sandbox",
      "security",
      "spaces",
      "workflowsExtensions",
      "workflowsManagement",
    ],
    "requiredBundles": [],
    "extraPublicDirs": ["common"],
  },
}
