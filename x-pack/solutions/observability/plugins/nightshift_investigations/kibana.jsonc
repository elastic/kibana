{
  "type": "plugin",
  "id": "@kbn/nightshift-investigations-plugin",
  "owner": ["@elastic/nightshift"],
  "group": "observability",
  "visibility": "private",
  "description": "Nightshift Investigations — domain API for starting and reading investigations",
  "plugin": {
    "id": "nightshiftInvestigations",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "nightshift_investigations"],
    "requiredPlugins": ["share", "taskManager"],
    "optionalPlugins": [
      "actions",
      "agentBuilder",
      "contextEngine",
      "encryptedSavedObjects",
      "inference",
      "ruleRegistry",
      "sandbox",
      "security",
      "spaces",
      "workflowsExtensions",
      "workflowsManagement",
    ],
    "requiredBundles": [],
    "extraPublicDirs": ["common"],
  },
}
