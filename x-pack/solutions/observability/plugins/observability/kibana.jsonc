{
  "type": "plugin",
  "id": "@kbn/observability-plugin",
  "owner": ["@elastic/observability-ui"],
  "group": "observability",
  "visibility": "private",
  "plugin": {
    "id": "observability",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "observability"],
    "requiredPlugins": [
      "alerting",
      "charts",
      "contentManagement",
      "controls",
      "data",
      "dataViews",
      "dataViewEditor",
      "embeddable",
      "fieldFormats",
      "uiActions",
      "features",
      "files",
      "inspector",
      "lens",
      "observabilityShared",
      "ruleRegistry",
      "triggersActionsUi",
      "security",
      "share",
      "unifiedSearch",
      "visualizations",
      "dashboard",
      "expressions",
      "logsDataAccess",
      "licensing",
      "navigation",
      "fieldsMetadata",
      "esql",
      "savedObjectsTagging",
      "streams",
      "kql",
    ],
    "optionalPlugins": [
      "alertingVTwo",
      "observabilityAgentBuilder",
      "agentBuilder",
      "aiops",
      "cases",
      "discover",
      "exploratoryView",
      "home",
      "globalSearch",
      "usageCollection",
      "cloud",
      "spaces",
      "serverless",
      "observabilityAIAssistant",
      "investigate",
      "cps",
      "ingestHub",
      "significantEvents",
      "nightshiftInvestigations",
      "entityInventoryApp",
    ],
    // Solution-nav targets. Also an allowlist for dynamic contract resolution.
    "runtimePluginDependencies": [
      "apm",
      "contextEngine",
      "devTools",
      "digitalExperience",
      "fleet",
      "graph",
      "infra",
      "management",
      "maps",
      "ml",
      "monitoring",
      "observabilityAlerting",
      "observabilityOnboarding",
      "profiling",
      "slo",
      "streamsApp",
      "synthetics",
      "uptime",
      "ux",
      "workflowsManagement",
    ],
    "requiredBundles": [
      "aiops",
      "cases",
      "data",
      "discover",
      "fleet",
      "logsShared",
      "kibanaReact",
      "kibanaUtils",
      "significantEvents",
      "stackAlerts",
      "observabilityAgentBuilder",
    ],
    "extraPublicDirs": ["common"],
  },
}
