  "presenceFilter": "((CASE(MV_MIN(TO_STRING(kubernetes.node.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(kubernetes.node.name))), 1, 1)), MV_MIN(TO_STRING(kubernetes.node.name))) IS NOT NULL))",
}
