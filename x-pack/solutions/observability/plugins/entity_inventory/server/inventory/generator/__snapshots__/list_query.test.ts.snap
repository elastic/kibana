// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`buildListQuery inventory_host with time-series indices builds the list query of plan 0 under TS 1`] = `
Object {
  "esql": "SET unmapped_fields=\\"nullify\\";
TS metrics-system.*
| WHERE \`@timestamp\` >= ?from AND \`@timestamp\` < ?to
    AND (TO_STRING(host.id) IS NOT NULL AND TO_STRING(host.id) != \\"\\" OR TO_STRING(host.name) IS NOT NULL AND TO_STRING(host.name) != \\"\\")
| STATS \`os\` = LAST(\`host.os.name\`, \`@timestamp\`) WHERE \`host.os.name\` IS NOT NULL,
    \`last_seen\` = MAX(\`@timestamp\`)
    BY \`host.id\`, \`host.name\`
| EVAL host_id_present = TO_STRING(host.id) IS NOT NULL AND TO_STRING(host.id) != \\"\\",
 host_name_present = TO_STRING(host.name) IS NOT NULL AND TO_STRING(host.name) != \\"\\",
 host_id_present_or_null = CASE(host_id_present, TO_STRING(host.id)),
 host_name_present_or_null = CASE(host_name_present, TO_STRING(host.name)),
 entity.id = CONCAT(\\"inventory_host:\\", COALESCE(host_id_present_or_null, host_name_present_or_null))
| KEEP \`entity.id\`, \`host.id\`, \`host.name\`, \`os\`, \`last_seen\`
| SORT \`last_seen\` DESC NULLS LAST, \`entity.id\` ASC
| LIMIT 10000",
  "params": Array [
    Object {
      "from": "2026-10-19T10:00:00.000Z",
    },
    Object {
      "to": "2026-10-19T11:00:00.000Z",
    },
  ],
}
`;

