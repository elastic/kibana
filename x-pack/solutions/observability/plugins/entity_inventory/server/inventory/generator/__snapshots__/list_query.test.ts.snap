exports[`buildListQuery keeps entity.id once for inventory_generic, with its raw value copied before the id evaluation 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM metrics-kubeletstatsreceiver.otel-default METADATA _index_mode
| WHERE \`_index_mode\` != \\"time_series\\"
    AND \`@timestamp\` >= ?from AND \`@timestamp\` < ?to
    AND ((CASE(MV_MIN(TO_STRING(entity.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(entity.id))), 1, 1)), MV_MIN(TO_STRING(entity.id))) IS NOT NULL))
| STATS \`cluster\` = LAST(\`orchestrator.cluster.name\`, \`@timestamp\`) WHERE \`orchestrator.cluster.name\` IS NOT NULL,
    \`os\` = LAST(\`host.os.name\`, \`@timestamp\`) WHERE \`host.os.name\` IS NOT NULL,
    \`os.type\` = LAST(\`host.os.type\`, \`@timestamp\`) WHERE \`host.os.type\` IS NOT NULL,
    \`last_seen\` = MAX(\`@timestamp\`)
    BY \`entity.id\`
| EVAL \`raw:entity.id\` = \`entity.id\`, entity.id = CONCAT(\\"inventory_generic:\\", CASE(MV_MIN(TO_STRING(entity.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(entity.id))), 1, 1)), MV_MIN(TO_STRING(entity.id))))
| KEEP \`entity.id\`, \`cluster\`, \`os\`, \`os.type\`, \`last_seen\`, \`raw:entity.id\`
| SORT \`last_seen\` DESC NULLS LAST, \`entity.id\` ASC
| LIMIT 10000"
`;

exports[`buildListQuery keeps entity.id once for inventory_ranked_generic, with its raw value copied before the id evaluation 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM metrics-system.* METADATA _index_mode
| WHERE \`_index_mode\` != \\"time_series\\"
    AND \`@timestamp\` >= ?from AND \`@timestamp\` < ?to
    AND (CASE(MV_MIN(TO_STRING(entity.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(entity.id))), 1, 1)), MV_MIN(TO_STRING(entity.id))) IS NOT NULL OR CASE(MV_MIN(TO_STRING(host.hostname)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.hostname))), 1, 1)), MV_MIN(TO_STRING(host.hostname))) IS NOT NULL)
| STATS \`os\` = LAST(\`host.os.name\`, \`@timestamp\`) WHERE \`host.os.name\` IS NOT NULL,
    \`last_seen\` = MAX(\`@timestamp\`)
    BY \`entity.id\`, \`host.hostname\`
| EVAL \`raw:entity.id\` = \`entity.id\`, entity_id_present = CASE(MV_MIN(TO_STRING(entity.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(entity.id))), 1, 1)), MV_MIN(TO_STRING(entity.id))) IS NOT NULL,
 host_hostname_present = CASE(MV_MIN(TO_STRING(host.hostname)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.hostname))), 1, 1)), MV_MIN(TO_STRING(host.hostname))) IS NOT NULL,
 entity_id_present_or_null = CASE(entity_id_present, CASE(MV_MIN(TO_STRING(entity.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(entity.id))), 1, 1)), MV_MIN(TO_STRING(entity.id)))),
 host_hostname_present_or_null = CASE(host_hostname_present, CASE(MV_MIN(TO_STRING(host.hostname)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.hostname))), 1, 1)), MV_MIN(TO_STRING(host.hostname)))),
 entity.id = CONCAT(\\"inventory_ranked_generic:\\", COALESCE(entity_id_present_or_null, host_hostname_present_or_null))
| KEEP \`entity.id\`, \`host.hostname\`, \`os\`, \`last_seen\`, \`raw:entity.id\`
| SORT \`last_seen\` DESC NULLS LAST, \`entity.id\` ASC
| LIMIT 10000"
`;
