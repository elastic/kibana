exports[`buildListQuery k8s.node under FROM builds the list query of plan 0 1`] = `
Object {
  "esql": "SET unmapped_fields=\\"nullify\\";
FROM metrics-kubeletstatsreceiver.otel-default
| WHERE \`@timestamp\` >= ?from AND \`@timestamp\` < ?to
    AND ((TO_STRING(kubernetes.node.name) IS NOT NULL AND TO_STRING(kubernetes.node.name) != \\"\\"))
| STATS \`cluster\` = LAST(\`orchestrator.cluster.name\`, \`@timestamp\`) WHERE \`orchestrator.cluster.name\` IS NOT NULL,
    \`os\` = LAST(\`host.os.name\`, \`@timestamp\`) WHERE \`host.os.name\` IS NOT NULL,
    \`os.type\` = LAST(\`host.os.type\`, \`@timestamp\`) WHERE \`host.os.type\` IS NOT NULL,
    \`last_seen\` = MAX(\`@timestamp\`)
    BY \`kubernetes.node.name\`
| EVAL entity.id = CONCAT(\\"k8s.node:\\", TO_STRING(kubernetes.node.name))
| KEEP \`entity.id\`, \`kubernetes.node.name\`, \`cluster\`, \`os\`, \`os.type\`, \`last_seen\`
| SORT \`last_seen\` DESC NULLS LAST
| LIMIT 10000",
  "params": Array [
    Object {
      "from": "2026-10-19T10:00:00.000Z",
    },
    Object {
