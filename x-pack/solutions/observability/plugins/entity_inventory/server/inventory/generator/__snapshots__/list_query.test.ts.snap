// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`buildListQuery inventory_host under FROM builds the list query of plan 0 1`] = `
Object {
  "esql": "SET unmapped_fields=\\"nullify\\";
FROM metrics-system.*
| WHERE \`@timestamp\` >= ?from AND \`@timestamp\` < ?to
    AND (CASE(MV_MIN(TO_STRING(host.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.id))), 1, 1)), MV_MIN(TO_STRING(host.id))) IS NOT NULL OR CASE(MV_MIN(TO_STRING(host.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.name))), 1, 1)), MV_MIN(TO_STRING(host.name))) IS NOT NULL)
| STATS \`os\` = LAST(\`host.os.name\`, \`@timestamp\`) WHERE \`host.os.name\` IS NOT NULL,
    \`last_seen\` = MAX(\`@timestamp\`)
    BY \`host.id\`, \`host.name\`
| EVAL host_id_present = CASE(MV_MIN(TO_STRING(host.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.id))), 1, 1)), MV_MIN(TO_STRING(host.id))) IS NOT NULL,
 host_name_present = CASE(MV_MIN(TO_STRING(host.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.name))), 1, 1)), MV_MIN(TO_STRING(host.name))) IS NOT NULL,
 host_id_present_or_null = CASE(host_id_present, CASE(MV_MIN(TO_STRING(host.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.id))), 1, 1)), MV_MIN(TO_STRING(host.id)))),
 host_name_present_or_null = CASE(host_name_present, CASE(MV_MIN(TO_STRING(host.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.name))), 1, 1)), MV_MIN(TO_STRING(host.name)))),
 entity.id = CONCAT(\\"inventory_host:\\", COALESCE(host_id_present_or_null, host_name_present_or_null))
| KEEP \`entity.id\`, \`host.id\`, \`host.name\`, \`os\`, \`last_seen\`
| SORT \`last_seen\` DESC NULLS LAST
| LIMIT 10000",
  "params": Array [
    Object {
      "from": "2026-10-19T10:00:00.000Z",
    },
    Object {
      "to": "2026-10-19T11:00:00.000Z",
    },
  ],
}
`;

