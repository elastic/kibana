{
  "type": "plugin",
  "id": "@kbn/entity-inventory-app-plugin",
  "owner": ["@elastic/obs-signals-metrics-team"],
  "group": "observability",
  "visibility": "private",
  "description": "UI plugin for the entity inventory. Disabled by default via xpack.entityInventoryApp.enabled.",
  "plugin": {
    "id": "entityInventoryApp",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "entityInventoryApp"],
    "requiredPlugins": ["observabilityShared", "share"],
    "optionalPlugins": [],
    "requiredBundles": ["kibanaReact"]
  }
}
