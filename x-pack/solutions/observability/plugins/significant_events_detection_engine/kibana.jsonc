{
  "type": "plugin",
  "id": "@kbn/significant-events-detection-engine-plugin",
  "owner": "@elastic/nightshift",
  "group": "observability",
  "visibility": "private",
  "description": "Significant Events detection engine: detection strategies on Alerting v2 rules, discovery with an Agent Builder agent, scheduled by a managed workflow",
  "plugin": {
    "id": "significantEventsDetectionEngine",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "significantEventsDetectionEngine"],
    // Route privileges (read_nightshift, manage_nightshift) are registered by the `nightshift`
    // plugin's feature, as for every Nightshift engine.
    "requiredPlugins": ["alertingVTwo", "inference", "nightshiftSources", "significantEvents"],
    "optionalPlugins": ["agentBuilder", "workflowsExtensions", "workflowsManagement"],
    "requiredBundles": []
  }
}
