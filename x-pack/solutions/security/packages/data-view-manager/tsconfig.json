{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "@kbn/ambient-ui-types",
      "jest",
      "node",
      "react"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/data-views-plugin",
    "@kbn/timelines-plugin",
    "@kbn/response-ops-alerts-fields-browser",
    "@kbn/core",
    "@kbn/spaces-plugin",
    "@kbn/kibana-utils-plugin"
  ]
}
