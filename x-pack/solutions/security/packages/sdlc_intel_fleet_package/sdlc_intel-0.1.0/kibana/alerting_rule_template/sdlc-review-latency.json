{
  "id": "vp-review-latency",
  "type": "alerting_rule_template",
  "attributes": {
    "name": "SDLC: PR review latency > 5 days",
    "tags": [
      "SDLC Intelligence",
      "pipeline",
      "health",
      "sync",
      "freshness"
    ],
    "ruleTypeId": ".es-query",
    "schedule": {
      "interval": "1h"
    },
    "params": {
      "searchType": "esqlQuery",
      "esqlQuery": {
        "esql": "FROM github-intel-pull-requests | WHERE github.state == \"OPEN\" | EVAL age_days = DATE_DIFF(\"days\", github.updated_at, NOW()) | WHERE age_days > 5 | KEEP entity.number, repository.full_name, age_days | LIMIT 10"
      },
      "timeField": "@timestamp",
      "timeWindowSize": 86400,
      "timeWindowUnit": "s",
      "size": 0,
      "thresholdComparator": ">",
      "threshold": [
        0
      ],
      "excludeHitsFromPreviousRun": false,
      "aggType": "count",
      "groupBy": "all"
    },
    "alertDelay": {
      "active": 1
    },
    "description": "Fires when an open pull request has not been updated (review latency) for more than 5 days."
  },
  "coreMigrationVersion": "8.8.0",
  "typeMigrationVersion": "10.1.0",
  "references": [
    {
      "id": "{{alert_slack_connector_id}}",
      "name": "alert-slack-connector",
      "type": "action"
    }
  ],
  "name": "SDLC: PR review latency > 5 days"
}