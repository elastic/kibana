{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/workflows",
    "@kbn/workflows-extensions",
    "@kbn/zod",
    "@kbn/zod-helpers",
    "@kbn/i18n",
    "@kbn/deeplinks-security",
  ]
}
