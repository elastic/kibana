{
  "type": "plugin",
  "id": "@kbn/security-solution-ess",
  "owner": [
    "@elastic/security-solution"
  ],
  "group": "security",
  "visibility": "private",
  "description": "ESS customizations for Security Solution.",
  "plugin": {
    "id": "securitySolutionEss",
    "browser": true,
    "server": true,
    "configPath": [
      "xpack",
      "securitySolutionEss"
    ],
    "requiredPlugins": [
      "securitySolution",
      "management",
      "navigation",
      "licensing",
      "cloud"
    ],
    "optionalPlugins": [],
    // Solution-nav targets. Also an allowlist for dynamic contract resolution.
    "runtimePluginDependencies": [
      "agentBuilder",
      "canvas",
      "contextEngine",
      "devTools",
      "discover",
      "fleet",
      "graph",
      "ingestHub",
      "maps",
      "ml",
      "monitoring",
      "osquery",
      "streamsApp",
      "workflowsManagement"
    ],
    "requiredBundles": [
      "kibanaReact"
    ]
  }
}
