{
  "type": "plugin",
  "id": "@kbn/discoveries-plugin",
  "owner": [
    "@elastic/security-threat-hunting"
  ],
  "group": "security",
  "visibility": "private",
  "description": "Discoveries plugin for Attack Discovery workflows integration",
  "plugin": {
    "id": "discoveries",
    "browser": true,
    "server": true,
    "configPath": [
      "xpack",
      "discoveries"
    ],
    "requiredPlugins": [
      "actions",
      "alerting",
      "eventLog",
      "security",
      "workflowsExtensions"
    ],
    "optionalPlugins": [
      "agentBuilder",
      "elasticAssistant",
      "inference",
      "ruleRegistry",
      "searchInferenceEndpoints",
      "spaces",
      "workflowsManagement"
    ],
    "requiredBundles": [],
    "tasks": {
      "requiredPlugins": ["actions", "eventLog", "security", "workflowsExtensions"],
      "optionalPlugins": ["agentBuilder", "inference", "searchInferenceEndpoints", "spaces", "workflowsManagement"]
    }
  }
}




