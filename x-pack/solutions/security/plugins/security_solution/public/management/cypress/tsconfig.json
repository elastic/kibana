{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "include": [
    "**/*",
  ],
  "exclude": [
    "target/**/*"
  ],
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "cypress",
      "node"
    ],
  },
  "kbn_references": [
    // The Cypress tests reach into plugin internals via relative imports. The plugin project has to be
    // referenced by path since this directory belongs to the same package as the plugin itself.
    { "path": "../../../tsconfig.json", "force": true },
    "@kbn/security-plugin",
    "@kbn/securitysolution-list-constants",
    "@kbn/fleet-plugin",
    "@kbn/securitysolution-io-ts-list-types",
    "@kbn/cypress-config",
    "@kbn/test-subj-selector",
    "@kbn/cases-plugin",
    "@kbn/kbn-client",
    "@kbn/test",
    "@kbn/repo-info",
    "@kbn/tooling-log",
    "@kbn/elastic-assistant-common",
    "@kbn/actions-plugin",
  ]
}
