exports[`entities grid query builders sort by risk_score_change builds the sort and count queries with filters and a cursor: count 1`] = `
"FROM risk-score.risk-score-default
| WHERE \`@timestamp\` <= NOW() - 7 day
| WHERE COALESCE(host.risk.id_field, user.risk.id_field, service.risk.id_field) == \\"entity.id\\"
| EVAL \`entity.id\` = COALESCE(host.risk.id_value, user.risk.id_value, service.risk.id_value), score = COALESCE(host.risk.calculated_score_norm, user.risk.calculated_score_norm, service.risk.calculated_score_norm)
| STATS reference_score = LAST(score, \`@timestamp\`) BY \`entity.id\`
| WHERE \`entity.id\` IN (FROM entities-latest-default | WHERE KQL(\\"\\"\\"entity.name: *gateway* or user.name: alice\\"\\"\\") | KEEP \`entity.id\`)
| LOOKUP JOIN .entities.v2.latest.default-00001 ON \`entity.id\`
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\") AND entity.risk.calculated_score_norm IS NOT NULL
| WHERE asset.criticality IN (\\"high_impact\\", \\"extreme_impact\\")
| EVAL risk_score_change = entity.risk.calculated_score_norm - reference_score
| KEEP entity.id, entity.name, entity.EngineMetadata.Type, entity.risk.calculated_score_norm, entity.relationships.resolution.resolved_to, asset.criticality, entity.source, entity.attributes.watchlists, entity.lifecycle.first_seen, \`@timestamp\`, user.name, host.id, user.email, user.id, user.domain, host.name, host.hostname, service.name, entity.namespace, host.os.name, risk_score_change
| STATS total = COUNT(*)"
`;

