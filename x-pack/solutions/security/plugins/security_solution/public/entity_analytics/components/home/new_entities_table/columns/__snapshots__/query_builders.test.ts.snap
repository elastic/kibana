exports[`entities grid query builders enrich queries enrichGroupSize builds its query from the page rows 1`] = `
Array [
  "FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE entity.relationships.resolution.resolved_to IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\") OR entity.id IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\")
| EVAL group_key = COALESCE(entity.relationships.resolution.resolved_to, entity.id)
| WHERE group_key IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\")
| STATS group_size = COUNT(*) BY group_key",
]
`;

exports[`entities grid query builders enrich queries enrichRiskScoreChange builds its query from the page rows 1`] = `
Array [
  "FROM risk-score.risk-score-default
| WHERE \`@timestamp\` <= NOW() - 7 day
| WHERE host.risk.id_value IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\") OR user.risk.id_value IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\") OR service.risk.id_value IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\")
| WHERE COALESCE(host.risk.id_field, user.risk.id_field, service.risk.id_field) == \\"entity.id\\"
| EVAL entity_id = COALESCE(host.risk.id_value, user.risk.id_value, service.risk.id_value), score = COALESCE(host.risk.calculated_score_norm, user.risk.calculated_score_norm, service.risk.calculated_score_norm)
| WHERE entity_id IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\")
| STATS reference_score = LAST(score, \`@timestamp\`) BY entity_id",
]
`;

exports[`entities grid query builders sort by @timestamp builds the sort and count queries with filters and a cursor: count 1`] = `
"FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE KQL(\\"\\"\\"entity.name: *gateway* or user.name: alice\\"\\"\\") AND asset.criticality IN (\\"high_impact\\", \\"extreme_impact\\")
| STATS total = COUNT(*)"
`;

exports[`entities grid query builders sort by @timestamp builds the sort and count queries with filters and a cursor: sort 1`] = `
"FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE KQL(\\"\\"\\"entity.name: *gateway* or user.name: alice\\"\\"\\") AND asset.criticality IN (\\"high_impact\\", \\"extreme_impact\\")
| KEEP entity.id, entity.name, entity.EngineMetadata.Type, entity.risk.calculated_score_norm, entity.relationships.resolution.resolved_to, asset.criticality, entity.source, entity.attributes.watchlists, entity.lifecycle.first_seen, \`@timestamp\`, user.name, host.id, user.email, user.id, user.domain, host.name, host.hostname, service.name, entity.namespace, host.os.name
| WHERE (@timestamp < 42) OR (@timestamp == 42 AND entity.id > \\"host:h-1\\") OR @timestamp IS NULL
| SORT @timestamp ASC NULLS LAST, entity.id ASC
| LIMIT 26"
`;

