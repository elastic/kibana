exports[`entities grid query builders sort by @timestamp builds the sort query with filters 1`] = `
"FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE KQL(\\"\\"\\"entity.name: *gateway* or user.name: alice\\"\\"\\")
| WHERE asset.criticality IN (\\"high_impact\\", \\"extreme_impact\\")
| SORT @timestamp ASC NULLS LAST, entity.id ASC
| LIMIT 26
| KEEP entity.id, entity.name, entity.EngineMetadata.Type, entity.risk.calculated_score_norm, entity.relationships.resolution.resolved_to, asset.criticality, entity.source, entity.attributes.watchlists, entity.lifecycle.first_seen, \`@timestamp\`, user.name, host.id, user.email, user.id, user.domain, event.module, data_stream.dataset, host.name, host.hostname, service.name, entity.namespace, host.os.name"
`;

exports[`entities grid query builders sort by alert_count builds the sort query 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM .alerts-security.alerts-default
| WHERE \`@timestamp\` >= NOW() - 7 days AND (kibana.alert.workflow_status IS NULL OR kibana.alert.workflow_status != \\"closed\\")
| FORK (
    WHERE \`kibana.alert.entity.id\` IS NOT NULL
    | EVAL _ea_entity_id = \`kibana.alert.entity.id\`
    | KEEP \`@timestamp\`, \`kibana.alert.severity\`, _ea_entity_id
  )
  (
    WHERE \`kibana.alert.entity.id\` IS NULL
    | EVAL _src_entity_source0 = MV_FIRST(TO_STRING(event.module)),
     _src_entity_source1 = MV_FIRST(TO_STRING(event.dataset)),
     _src_entity_source2 = MV_FIRST(TO_STRING(data_stream.dataset)),
     _src_entity_source = COALESCE(CASE(_src_entity_source0 IS NOT NULL AND _src_entity_source0 != \\"\\", _src_entity_source0), CASE(_src_entity_source1 IS NOT NULL AND _src_entity_source1 != \\"\\", _src_entity_source1), CASE(_src_entity_source2 IS NOT NULL AND _src_entity_source2 != \\"\\", _src_entity_source2)),
     entity.source = CASE(_src_entity_source IS NULL OR _src_entity_source == \\"\\", NULL, _src_entity_source)
    | EVAL _src_entity_namespace0 = MV_FIRST(TO_STRING(event.module)),
     _src_entity_namespace1 = MV_FIRST(SPLIT(MV_FIRST(TO_STRING(data_stream.dataset)), \\".\\")),
     _src_entity_namespace = COALESCE(CASE(_src_entity_namespace0 IS NOT NULL AND _src_entity_namespace0 != \\"\\", _src_entity_namespace0), CASE(_src_entity_namespace1 IS NOT NULL AND _src_entity_namespace1 != \\"\\", _src_entity_namespace1)),
     _eval_entity_namespace_arm0 = (TO_STRING(user.name) IS NOT NULL AND TO_STRING(user.name) != \\"\\" AND TO_STRING(host.id) IS NOT NULL AND TO_STRING(host.id) != \\"\\" AND NOT (TO_STRING(user.name) IN (\\"root\\", \\"bin\\", \\"daemon\\", \\"sys\\", \\"nobody\\", \\"jenkins\\", \\"ansible\\", \\"deploy\\", \\"terraform\\", \\"gitlab-runner\\", \\"postgres\\", \\"mysql\\", \\"redis\\", \\"elasticsearch\\", \\"kafka\\", \\"admin\\", \\"operator\\", \\"service\\"))),
     _eval_entity_namespace_arm1 = (MV_CONTAINS(TO_STRING(event.kind), \\"asset\\") AND MV_CONTAINS(TO_STRING(event.module), \\"asset_discovery\\")),
     entity.namespace = COALESCE(CASE(COALESCE(_eval_entity_namespace_arm0, FALSE), \\"local\\"), CASE(COALESCE(_eval_entity_namespace_arm1, FALSE), CASE(MV_FIRST(TO_STRING(cloud.provider)) == \\"aws\\", \\"aws\\", MV_FIRST(TO_STRING(cloud.provider)) == \\"gcp\\", \\"gcp\\", MV_FIRST(TO_STRING(cloud.provider)) == \\"azure\\", \\"entra_id\\")), CASE(COALESCE(_src_entity_namespace IN (\\"okta\\", \\"entityanalytics_okta\\"), FALSE), \\"okta\\"), CASE(COALESCE(_src_entity_namespace IN (\\"azure\\", \\"entityanalytics_entra_id\\"), FALSE), \\"entra_id\\"), CASE(COALESCE(_src_entity_namespace IN (\\"o365\\", \\"o365_metrics\\"), FALSE), \\"microsoft_365\\"), CASE(COALESCE(_src_entity_namespace IN (\\"entityanalytics_ad\\"), FALSE), \\"active_directory\\"), CASE(_src_entity_namespace IS NULL OR _src_entity_namespace == \\"\\", \\"unknown\\"), _src_entity_namespace),
     user_name_present = TO_STRING(user.name) IS NOT NULL AND TO_STRING(user.name) != \\"\\",
     host_id_present = TO_STRING(host.id) IS NOT NULL AND TO_STRING(host.id) != \\"\\",
     entity_namespace_present = TO_STRING(entity.namespace) IS NOT NULL AND TO_STRING(entity.namespace) != \\"\\",
     user_entity_id_present = TO_STRING(user.entity.id) IS NOT NULL AND TO_STRING(user.entity.id) != \\"\\",
     user_email_present = TO_STRING(user.email) IS NOT NULL AND TO_STRING(user.email) != \\"\\",
     user_id_present = TO_STRING(user.id) IS NOT NULL AND TO_STRING(user.id) != \\"\\",
     user_domain_present = TO_STRING(user.domain) IS NOT NULL AND TO_STRING(user.domain) != \\"\\",
     user_name_present_or_null = CASE(user_name_present, TO_STRING(user.name)),
     host_id_present_or_null = CASE(host_id_present, TO_STRING(host.id)),
     entity_namespace_present_or_null = CASE(entity_namespace_present, TO_STRING(entity.namespace)),
     user_entity_id_present_or_null = CASE(user_entity_id_present, TO_STRING(user.entity.id)),
     user_email_present_or_null = CASE(user_email_present, TO_STRING(user.email)),
     user_id_present_or_null = CASE(user_id_present, TO_STRING(user.id)),
     user_domain_present_or_null = CASE(user_domain_present, TO_STRING(user.domain)),
     _euid_branch_0_formula = CONCAT(user_name_present_or_null, \\"@\\", host_id_present_or_null, \\"@\\", entity_namespace_present_or_null),
     _euid_branch_0_cond = (TO_STRING(entity.namespace) == \\"local\\"),
     _euid_branch_1_formula = COALESCE(CONCAT(user_entity_id_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_email_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_id_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", user_domain_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", entity_namespace_present_or_null)),
     _euid_branch_1_cond = (TO_STRING(cloud.provider) == \\"aws\\"),
     _euid_branch_2_formula = COALESCE(CONCAT(user_email_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_id_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", user_domain_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", entity_namespace_present_or_null)),
     user_euid = CONCAT(\\"user:\\", CASE(_euid_branch_0_cond, _euid_branch_0_formula,
    _euid_branch_1_cond, _euid_branch_1_formula,
    TRUE, _euid_branch_2_formula, NULL))
    | EVAL _src_entity_source0 = MV_FIRST(TO_STRING(event.module)),
     _src_entity_source1 = MV_FIRST(TO_STRING(event.dataset)),
     _src_entity_source2 = MV_FIRST(TO_STRING(data_stream.dataset)),
     _src_entity_source = COALESCE(CASE(_src_entity_source0 IS NOT NULL AND _src_entity_source0 != \\"\\", _src_entity_source0), CASE(_src_entity_source1 IS NOT NULL AND _src_entity_source1 != \\"\\", _src_entity_source1), CASE(_src_entity_source2 IS NOT NULL AND _src_entity_source2 != \\"\\", _src_entity_source2)),
     entity.source = CASE(_src_entity_source IS NULL OR _src_entity_source == \\"\\", NULL, _src_entity_source)
    | EVAL host_id_present = TO_STRING(host.id) IS NOT NULL AND TO_STRING(host.id) != \\"\\",
     host_name_present = TO_STRING(host.name) IS NOT NULL AND TO_STRING(host.name) != \\"\\",
     host_hostname_present = TO_STRING(host.hostname) IS NOT NULL AND TO_STRING(host.hostname) != \\"\\",
     host_id_present_or_null = CASE(host_id_present, TO_STRING(host.id)),
     host_name_present_or_null = CASE(host_name_present, TO_STRING(host.name)),
     host_hostname_present_or_null = CASE(host_hostname_present, TO_STRING(host.hostname)),
     host_euid = CONCAT(\\"host:\\", COALESCE(host_id_present_or_null, host_name_present_or_null, host_hostname_present_or_null))
    | EVAL _src_entity_source0 = MV_FIRST(TO_STRING(event.module)),
     _src_entity_source1 = MV_FIRST(TO_STRING(event.dataset)),
     _src_entity_source2 = MV_FIRST(TO_STRING(data_stream.dataset)),
     _src_entity_source = COALESCE(CASE(_src_entity_source0 IS NOT NULL AND _src_entity_source0 != \\"\\", _src_entity_source0), CASE(_src_entity_source1 IS NOT NULL AND _src_entity_source1 != \\"\\", _src_entity_source1), CASE(_src_entity_source2 IS NOT NULL AND _src_entity_source2 != \\"\\", _src_entity_source2)),
     entity.source = CASE(_src_entity_source IS NULL OR _src_entity_source == \\"\\", NULL, _src_entity_source)
    | EVAL service_euid = CONCAT(\\"service:\\", TO_STRING(service.name))
    | EVAL _ea_entity_id = MV_DEDUPE(MV_APPEND(MV_APPEND(
      COALESCE(user_euid, host_euid, service_euid),
      COALESCE(host_euid, service_euid, user_euid)),
      COALESCE(service_euid, user_euid, host_euid)))
    | KEEP \`@timestamp\`, \`kibana.alert.severity\`, _ea_entity_id
  )
| MV_EXPAND _ea_entity_id
| WHERE _ea_entity_id IS NOT NULL
| RENAME _ea_entity_id AS \`entity.id\`
| STATS last_seen_alert = MAX(\`@timestamp\`), alert_count = COUNT(*), alert_critical = COUNT(*) WHERE \`kibana.alert.severity\` == \\"critical\\", alert_high = COUNT(*) WHERE \`kibana.alert.severity\` == \\"high\\", alert_medium = COUNT(*) WHERE \`kibana.alert.severity\` == \\"medium\\", alert_low = COUNT(*) WHERE \`kibana.alert.severity\` == \\"low\\" BY \`entity.id\`
| LOOKUP JOIN .entities.v2.latest.default-00001 ON \`entity.id\`
| EVAL \`entity.id\` = COALESCE(entity.relationships.resolution.resolved_to, \`entity.id\`)
| STATS last_seen_alert = MAX(last_seen_alert), alert_count = SUM(alert_count), alert_critical = SUM(alert_critical), alert_high = SUM(alert_high), alert_medium = SUM(alert_medium), alert_low = SUM(alert_low) BY \`entity.id\`
| LOOKUP JOIN .entities.v2.latest.default-00001 ON \`entity.id\`
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE entity.relationships.resolution.resolved_to IS NULL
| SORT alert_count DESC NULLS LAST, entity.id ASC
| LIMIT 26
| EVAL entity.risk.calculated_score_norm = COALESCE(entity.relationships.resolution.risk.calculated_score_norm, entity.risk.calculated_score_norm)
| KEEP entity.id, entity.name, entity.EngineMetadata.Type, entity.risk.calculated_score_norm, entity.relationships.resolution.resolved_to, asset.criticality, entity.source, entity.attributes.watchlists, entity.lifecycle.first_seen, \`@timestamp\`, user.name, host.id, user.email, user.id, user.domain, event.module, data_stream.dataset, host.name, host.hostname, service.name, entity.namespace, alert_count, last_seen_alert, alert_critical, alert_high, alert_medium, alert_low

FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE entity.relationships.resolution.resolved_to IS NULL
| SORT entity.id ASC
| LIMIT 26
| EVAL last_seen_alert = null, alert_count = null, alert_critical = null, alert_high = null, alert_medium = null, alert_low = null
| EVAL entity.risk.calculated_score_norm = COALESCE(entity.relationships.resolution.risk.calculated_score_norm, entity.risk.calculated_score_norm)
| KEEP entity.id, entity.name, entity.EngineMetadata.Type, entity.risk.calculated_score_norm, entity.relationships.resolution.resolved_to, asset.criticality, entity.source, entity.attributes.watchlists, entity.lifecycle.first_seen, \`@timestamp\`, user.name, host.id, user.email, user.id, user.domain, event.module, data_stream.dataset, host.name, host.hostname, service.name, entity.namespace, alert_count, last_seen_alert, alert_critical, alert_high, alert_medium, alert_low"
`;

