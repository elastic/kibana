exports[`entities grid query builders enrich queries risk_score_change builds its query from the page rows 1`] = `
Array [
  "FROM risk-score.risk-score-default
| WHERE \`@timestamp\` >= NOW() - 7 days - 2 hours AND \`@timestamp\` <= NOW() - 7 days
| WHERE host.risk.id_value IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\") OR user.risk.id_value IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\") OR service.risk.id_value IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\")
| WHERE COALESCE(host.risk.id_field, user.risk.id_field, service.risk.id_field) == \\"entity.id\\"
| EVAL entity_id = COALESCE(host.risk.id_value, user.risk.id_value, service.risk.id_value), score = COALESCE(host.risk.calculated_score_norm, user.risk.calculated_score_norm, service.risk.calculated_score_norm)
| WHERE entity_id IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\")
| EVAL is_group = CASE(COALESCE(host.risk.score_type, user.risk.score_type, service.risk.score_type) == \\"resolution\\", 1, 0)
| STATS last_value = LAST(score, @timestamp) BY entity_id, is_group
| EVAL group_part = CASE(is_group == 1, last_value, null), own_part = CASE(is_group == 0, last_value, null)
| STATS group_value = MAX(group_part), own_value = MAX(own_part) BY entity_id
| EVAL reference_score = COALESCE(group_value, own_value)
| KEEP entity_id, reference_score",
]
`;

exports[`entities grid query builders sort by @timestamp builds the sort query 1`] = `
"FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\") AND entity.relationships.resolution.resolved_to IS NOT NULL
| EVAL rank = CASE(asset.criticality == \\"extreme_impact\\", 4, asset.criticality == \\"high_impact\\", 3, asset.criticality == \\"medium_impact\\", 2, asset.criticality == \\"low_impact\\", 1)
| STATS alias_rank = MAX(rank), alias_sources = VALUES(entity.source), alias_watchlists = VALUES(entity.attributes.watchlists), alias_first_seen = MIN(entity.lifecycle.first_seen), alias_last_seen = MAX(\`@timestamp\`) BY group_key = entity.relationships.resolution.resolved_to
| RENAME group_key AS \`entity.id\`
| LOOKUP JOIN .entities.v2.latest.default-00001 ON \`entity.id\`
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\") AND entity.relationships.resolution.resolved_to IS NULL
| EVAL own_rank = CASE(asset.criticality == \\"extreme_impact\\", 4, asset.criticality == \\"high_impact\\", 3, asset.criticality == \\"medium_impact\\", 2, asset.criticality == \\"low_impact\\", 1)
| EVAL group_rank = GREATEST(COALESCE(own_rank, alias_rank), COALESCE(alias_rank, own_rank))
| EVAL asset.criticality = CASE(group_rank == 4, \\"extreme_impact\\", group_rank == 3, \\"high_impact\\", group_rank == 2, \\"medium_impact\\", group_rank == 1, \\"low_impact\\"), entity.source = MV_DEDUPE(COALESCE(MV_APPEND(entity.source, alias_sources), entity.source, alias_sources)), entity.attributes.watchlists = MV_DEDUPE(COALESCE(MV_APPEND(entity.attributes.watchlists, alias_watchlists), entity.attributes.watchlists, alias_watchlists)), entity.lifecycle.first_seen = LEAST(COALESCE(entity.lifecycle.first_seen, alias_first_seen), COALESCE(alias_first_seen, entity.lifecycle.first_seen)), \`@timestamp\` = GREATEST(COALESCE(\`@timestamp\`, alias_last_seen), COALESCE(alias_last_seen, \`@timestamp\`))
| EVAL entity.risk.calculated_score_norm = COALESCE(entity.relationships.resolution.risk.calculated_score_norm, entity.risk.calculated_score_norm)
| KEEP entity.id, entity.name, entity.EngineMetadata.Type, entity.risk.calculated_score_norm, entity.relationships.resolution.resolved_to, asset.criticality, entity.source, entity.attributes.watchlists, entity.lifecycle.first_seen, \`@timestamp\`, user.name, host.id, user.email, user.id, user.domain, event.module, data_stream.dataset, host.name, host.hostname, service.name, entity.namespace
| LIMIT 9975

FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE entity.relationships.resolution.resolved_to IS NULL
| SORT @timestamp DESC NULLS LAST, entity.id ASC
| LIMIT 26
| EVAL entity.risk.calculated_score_norm = COALESCE(entity.relationships.resolution.risk.calculated_score_norm, entity.risk.calculated_score_norm)
| KEEP entity.id, entity.name, entity.EngineMetadata.Type, entity.risk.calculated_score_norm, entity.relationships.resolution.resolved_to, asset.criticality, entity.source, entity.attributes.watchlists, entity.lifecycle.first_seen, \`@timestamp\`, user.name, host.id, user.email, user.id, user.domain, event.module, data_stream.dataset, host.name, host.hostname, service.name, entity.namespace"
`;

