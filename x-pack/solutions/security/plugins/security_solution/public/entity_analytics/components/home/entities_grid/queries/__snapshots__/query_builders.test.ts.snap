exports[`entities grid query builders count builds the count query with entity filters and no search 1`] = `
"FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE entity.relationships.resolution.resolved_to IS NULL
| WHERE asset.criticality IN (\\"high_impact\\", \\"extreme_impact\\")
| STATS total = COUNT(*)"
`;

exports[`entities grid query builders count builds the count query with filters 1`] = `
"FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE KQL(\\"\\"\\"entity.name: *gateway* or user.name: alice\\"\\"\\")
| WHERE asset.criticality IN (\\"high_impact\\", \\"extreme_impact\\")
| STATS total = COUNT(*)"
`;

exports[`entities grid query builders count builds the count query with no filters 1`] = `
"FROM entities-latest-default
