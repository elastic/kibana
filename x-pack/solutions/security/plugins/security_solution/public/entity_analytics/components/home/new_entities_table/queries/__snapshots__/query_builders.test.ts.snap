    | KEEP _ea_entity_id, _in_view
  )
| MV_EXPAND _ea_entity_id
| WHERE _ea_entity_id IS NOT NULL
| RENAME _ea_entity_id AS \`entity.id\`
| STATS last_seen_alert = MAX(\`@timestamp\`) WHERE _in_view IS NULL, alert_count = COUNT(*) WHERE _in_view IS NULL, alert_critical = COUNT(*) WHERE _in_view IS NULL AND \`kibana.alert.severity\` == \\"critical\\", alert_high = COUNT(*) WHERE _in_view IS NULL AND \`kibana.alert.severity\` == \\"high\\", alert_medium = COUNT(*) WHERE _in_view IS NULL AND \`kibana.alert.severity\` == \\"medium\\", alert_low = COUNT(*) WHERE _in_view IS NULL AND \`kibana.alert.severity\` == \\"low\\", _in_view = MAX(_in_view) BY \`entity.id\`
| WHERE _in_view == 1
| WHERE last_seen_alert IS NULL AND entity.id > \\"host:h-1\\"
| SORT last_seen_alert DESC NULLS LAST, entity.id ASC
