     user_id_present_or_null = CASE(user_id_present, TO_STRING(user.id)),
     user_domain_present_or_null = CASE(user_domain_present, TO_STRING(user.domain)),
     _euid_branch_0_formula = CONCAT(user_name_present_or_null, \\"@\\", host_id_present_or_null, \\"@\\", entity_namespace_present_or_null),
     _euid_branch_0_cond = (TO_STRING(entity.namespace) == \\"local\\"),
     _euid_branch_1_formula_arm0 = CONCAT(user_email_present_or_null, \\"@\\", entity_namespace_present_or_null),
     _euid_branch_1_formula_arm1 = CONCAT(user_id_present_or_null, \\"@\\", entity_namespace_present_or_null),
     _euid_branch_1_formula_arm2 = CONCAT(user_name_present_or_null, \\"@\\", user_domain_present_or_null, \\"@\\", entity_namespace_present_or_null),
     _euid_branch_1_formula_arm3 = CONCAT(user_name_present_or_null, \\"@\\", entity_namespace_present_or_null),
     _euid_branch_1_formula = COALESCE(_euid_branch_1_formula_arm0, _euid_branch_1_formula_arm1, _euid_branch_1_formula_arm2, _euid_branch_1_formula_arm3),
     _euid_branch_0_pick = CASE(_euid_branch_0_cond, _euid_branch_0_formula, _euid_branch_1_formula),
