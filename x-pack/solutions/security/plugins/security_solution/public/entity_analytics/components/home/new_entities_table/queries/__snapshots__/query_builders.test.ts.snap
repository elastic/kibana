exports[`entities grid query builders sort by group_size builds the sort and count queries with entity filters and no search: sort 1`] = `
"FROM (
  FROM entities-latest-default
  | WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\") AND entity.relationships.resolution.resolved_to IS NOT NULL
  | STATS alias_count = COUNT(*) BY group_key = entity.relationships.resolution.resolved_to
  | RENAME group_key AS \`entity.id\`
  | LOOKUP JOIN .entities.v2.latest.default-00001 ON \`entity.id\`
  | WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
  | WHERE asset.criticality IN (\\"high_impact\\", \\"extreme_impact\\")
  | EVAL group_size = alias_count + CASE(entity.relationships.resolution.resolved_to IS NULL, 1, 0)
  | KEEP \`entity.id\`, group_size
), (
  FROM entities-latest-default
  | WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\") AND entity.relationships.resolution.resolved_to IS NULL
  | WHERE asset.criticality IN (\\"high_impact\\", \\"extreme_impact\\")
  | EVAL group_size = TO_LONG(1)
  | SORT \`entity.id\` ASC
  | LIMIT 10026
  | KEEP \`entity.id\`, group_size
)
| STATS group_size = MAX(group_size) BY \`entity.id\`
| SORT group_size DESC NULLS LAST, entity.id ASC
| LIMIT 26
| LOOKUP JOIN .entities.v2.latest.default-00001 ON \`entity.id\`
| KEEP entity.id, entity.name, entity.EngineMetadata.Type, entity.risk.calculated_score_norm, entity.relationships.resolution.resolved_to, asset.criticality, entity.source, entity.attributes.watchlists, entity.lifecycle.first_seen, \`@timestamp\`, user.name, host.id, user.email, user.id, user.domain, event.module, data_stream.dataset, host.name, host.hostname, service.name, entity.namespace, group_size
| SORT group_size DESC NULLS LAST, entity.id ASC
| LIMIT 26"
`;

exports[`entities grid query builders sort by group_size builds the sort and count queries with filters and a cursor: count 1`] = `
"FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE KQL(\\"\\"\\"entity.name: *gateway* or user.name: alice\\"\\"\\")
| WHERE asset.criticality IN (\\"high_impact\\", \\"extreme_impact\\")
| STATS total = COUNT(*)"
`;

exports[`entities grid query builders sort by group_size builds the sort and count queries with filters and a cursor: sort 1`] = `
"FROM (
FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| EVAL group_key = COALESCE(entity.relationships.resolution.resolved_to, entity.id)
| STATS group_size = COUNT(*) BY group_key
| RENAME group_key AS \`entity.id\`
), (
