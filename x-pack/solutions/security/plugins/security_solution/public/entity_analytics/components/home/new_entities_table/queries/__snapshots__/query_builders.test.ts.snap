     host_hostname_present_or_null = CASE(host_hostname_present, TO_STRING(host.hostname)),
     _host_euid_arm0 = host_id_present_or_null,
     _host_euid_arm1 = host_name_present_or_null,
     _host_euid_arm2 = host_hostname_present_or_null,
     host_euid = CONCAT(\\"host:\\", COALESCE(_host_euid_arm0, _host_euid_arm1, _host_euid_arm2))
    | EVAL _src_entity_source0 = MV_FIRST(TO_STRING(event.module)),
