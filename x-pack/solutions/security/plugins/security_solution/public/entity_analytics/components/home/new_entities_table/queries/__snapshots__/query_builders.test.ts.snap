exports[`entities grid query builders sort by risk_score_change builds the sort and count queries with entity filters and no search: sort 1`] = `
"FROM (
FROM risk-score.risk-score-default
| WHERE \`@timestamp\` >= NOW() - 7 days - 2 hours AND \`@timestamp\` <= NOW() - 7 days
| WHERE COALESCE(host.risk.id_field, user.risk.id_field, service.risk.id_field) == \\"entity.id\\"
| EVAL \`entity.id\` = COALESCE(host.risk.id_value, user.risk.id_value, service.risk.id_value), score = COALESCE(host.risk.calculated_score_norm, user.risk.calculated_score_norm, service.risk.calculated_score_norm)
| STATS reference_score = LAST(score, \`@timestamp\`) BY \`entity.id\`
), (
FROM entities-latest-default
| WHERE entity.EngineMetadata.Type IN (\\"user\\", \\"host\\", \\"service\\")
| WHERE entity.relationships.resolution.resolved_to IS NULL
| WHERE asset.criticality IN (\\"high_impact\\", \\"extreme_impact\\")
| EVAL _in_view = 1
| KEEP \`entity.id\`, _in_view, entity.risk.calculated_score_norm
)
| STATS reference_score = MAX(reference_score), current_score = MAX(entity.risk.calculated_score_norm), _in_view = MAX(_in_view) BY \`entity.id\`
| WHERE _in_view == 1
| EVAL risk_score_change = current_score - reference_score
| SORT risk_score_change DESC NULLS LAST, entity.id ASC
| LIMIT 26
| LOOKUP JOIN .entities.v2.latest.default-00001 ON \`entity.id\`
| KEEP entity.id, entity.name, entity.EngineMetadata.Type, entity.risk.calculated_score_norm, entity.relationships.resolution.resolved_to, asset.criticality, entity.source, entity.attributes.watchlists, entity.lifecycle.first_seen, \`@timestamp\`, user.name, host.id, user.email, user.id, user.domain, event.module, data_stream.dataset, host.name, host.hostname, service.name, entity.namespace, risk_score_change
| SORT risk_score_change DESC NULLS LAST, entity.id ASC
| LIMIT 26"
`;

