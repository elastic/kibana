exports[`entities grid query builders enrich queries alert_count builds its query from the page rows 1`] = `
Array [
  "FROM .alerts-security.alerts-default
| WHERE \`@timestamp\` >= NOW() - 7 days
| WHERE kibana.alert.workflow_status IS NULL OR kibana.alert.workflow_status != \\"closed\\"
| FORK (
    WHERE \`kibana.alert.entity.id\` IS NOT NULL
    | WHERE \`kibana.alert.entity.id\` IN (\\"host:h-1\\", \\"host:web-2\\", \\"user:alice@h-1@local\\", \\"user:bob@corp.com@okta\\", \\"service:payments\\")
    | EVAL _ea_entity_id = \`kibana.alert.entity.id\`
    | KEEP \`@timestamp\`, \`kibana.alert.severity\`, _ea_entity_id
  )
  (
    WHERE \`kibana.alert.entity.id\` IS NULL AND (user.name IN (\\"alice\\", \\"bob\\") OR host.id IN (\\"h-1\\") OR user.email IN (\\"bob@corp.com\\") OR host.name IN (\\"web-1\\", \\"web-2\\") OR service.name IN (\\"payments\\")) AND (((host.id == \\"h-1\\")) OR ((host.name == \\"web-2\\") AND (TO_STRING(host.id) IS NULL OR TO_STRING(host.id) == \\"\\")) OR ((user.name == \\"alice\\") AND (host.id == \\"h-1\\") AND (TO_STRING(user.name) IS NOT NULL AND TO_STRING(user.name) != \\"\\" AND TO_STRING(host.id) IS NOT NULL AND TO_STRING(host.id) != \\"\\" AND NOT (TO_STRING(user.name) IN (\\"root\\", \\"bin\\", \\"daemon\\", \\"sys\\", \\"nobody\\", \\"jenkins\\", \\"ansible\\", \\"deploy\\", \\"terraform\\", \\"gitlab-runner\\", \\"postgres\\", \\"mysql\\", \\"redis\\", \\"elasticsearch\\", \\"kafka\\", \\"admin\\", \\"operator\\", \\"service\\")))) OR ((user.email == \\"bob@corp.com\\") AND ((TO_STRING(event.module) IS NULL OR TO_STRING(event.module) == \\"\\") AND (TO_STRING(data_stream.dataset) IS NULL OR TO_STRING(data_stream.dataset) == \\"\\"))) OR (service.name == \\"payments\\"))
    | EVAL _src_entity_source0 = MV_FIRST(TO_STRING(event.module)),
     _src_entity_source1 = MV_FIRST(TO_STRING(event.dataset)),
     _src_entity_source2 = MV_FIRST(TO_STRING(data_stream.dataset)),
     _src_entity_source0_value = CASE(_src_entity_source0 IS NOT NULL AND _src_entity_source0 != \\"\\", _src_entity_source0),
