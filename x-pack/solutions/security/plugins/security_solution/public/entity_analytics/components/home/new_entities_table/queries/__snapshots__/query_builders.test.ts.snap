    | EVAL _src_entity_namespace0 = MV_FIRST(TO_STRING(event.module)),
     _src_entity_namespace1 = MV_FIRST(SPLIT(MV_FIRST(TO_STRING(data_stream.dataset)), \\".\\")),
     _src_entity_namespace0_value = CASE(_src_entity_namespace0 IS NOT NULL AND _src_entity_namespace0 != \\"\\", _src_entity_namespace0),
     _src_entity_namespace1_value = CASE(_src_entity_namespace1 IS NOT NULL AND _src_entity_namespace1 != \\"\\", _src_entity_namespace1),
     _src_entity_namespace = COALESCE(_src_entity_namespace0_value, _src_entity_namespace1_value),
     _eval_entity_namespace_arm0 = (TO_STRING(user.name) IS NOT NULL AND TO_STRING(user.name) != \\"\\" AND TO_STRING(host.id) IS NOT NULL AND TO_STRING(host.id) != \\"\\" AND NOT (TO_STRING(user.name) IN (\\"root\\", \\"bin\\", \\"daemon\\", \\"sys\\", \\"nobody\\", \\"jenkins\\", \\"ansible\\", \\"deploy\\", \\"terraform\\", \\"gitlab-runner\\", \\"postgres\\", \\"mysql\\", \\"redis\\", \\"elasticsearch\\", \\"kafka\\", \\"admin\\", \\"operator\\", \\"service\\"))),
     _eval_entity_namespace_then0 = CASE(_eval_entity_namespace_arm0, \\"local\\"),
     _eval_entity_namespace_arm1 = (MV_CONTAINS(TO_STRING(event.kind), \\"asset\\") AND MV_CONTAINS(TO_STRING(event.module), \\"asset_discovery\\")),
     _eval_entity_namespace_map1_value = MV_FIRST(TO_STRING(cloud.provider)),
     _eval_entity_namespace_map1_0 = CASE(_eval_entity_namespace_map1_value == \\"aws\\", \\"aws\\"),
     _eval_entity_namespace_map1_1 = CASE(_eval_entity_namespace_map1_value == \\"gcp\\", \\"gcp\\"),
     _eval_entity_namespace_map1_2 = CASE(_eval_entity_namespace_map1_value == \\"azure\\", \\"entra_id\\"),
     _eval_entity_namespace_map1 = COALESCE(_eval_entity_namespace_map1_0, _eval_entity_namespace_map1_1, _eval_entity_namespace_map1_2),
     _eval_entity_namespace_then1 = CASE(_eval_entity_namespace_arm1, _eval_entity_namespace_map1),
     _eval_entity_namespace_then2 = CASE(_src_entity_namespace IN (\\"okta\\", \\"entityanalytics_okta\\"), \\"okta\\"),
     _eval_entity_namespace_then3 = CASE(_src_entity_namespace IN (\\"azure\\", \\"entityanalytics_entra_id\\"), \\"entra_id\\"),
     _eval_entity_namespace_then4 = CASE(_src_entity_namespace IN (\\"o365\\", \\"o365_metrics\\"), \\"microsoft_365\\"),
     _eval_entity_namespace_then5 = CASE(_src_entity_namespace IN (\\"entityanalytics_ad\\"), \\"active_directory\\"),
     _eval_entity_namespace_fallback = CASE(_src_entity_namespace IS NULL OR _src_entity_namespace == \\"\\", \\"unknown\\"),
     entity.namespace = COALESCE(_eval_entity_namespace_then0, _eval_entity_namespace_then1, _eval_entity_namespace_then2, _eval_entity_namespace_then3, _eval_entity_namespace_then4, _eval_entity_namespace_then5, _eval_entity_namespace_fallback, _src_entity_namespace),
