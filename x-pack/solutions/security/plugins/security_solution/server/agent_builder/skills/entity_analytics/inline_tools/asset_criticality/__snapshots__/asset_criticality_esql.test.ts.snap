// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`assetCriticalityDynamicInlineToolHandler should modify additional context when entity store v2 is enabled 1`] = `
"
        This is a set of rules that you must follow strictly:
        * The criticality value is stored in the field 'criticality_level'.,
        * When searching the asset criticality of an entity of type 'host', you must **ALWAYS** use exact and entire filter: \\"'WHERE (CASE(MV_MIN(TO_STRING(host.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.id))), 1, 1)), MV_MIN(TO_STRING(host.id))) IS NOT NULL OR CASE(MV_MIN(TO_STRING(host.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.name))), 1, 1)), MV_MIN(TO_STRING(host.name))) IS NOT NULL OR CASE(MV_MIN(TO_STRING(host.hostname)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.hostname))), 1, 1)), MV_MIN(TO_STRING(host.hostname))) IS NOT NULL)'\\""
`;

exports[`assetCriticalityDynamicInlineToolHandler should return asset criticality message with ESQL query when asset criticality index exists 1`] = `
"
        This is a set of rules that you must follow strictly:
        * The criticality value is stored in the field 'criticality_level'.,
        * When searching the asset criticality of an entity of type 'host', you must **ALWAYS** use exact and entire filter: \\"'WHERE host.name IS NOT NULL'\\""
`;

exports[`assetCriticalityDynamicInlineToolHandler should return generic security solution message when asset criticality index does not exist 1`] = `"Asset criticality index does not exist for this space."`;
