// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`OWNS_INTEGRATION_RELATIONSHIP_CONFIGS entityanalytics_entra_id (log-based) targets-per-actor ES|QL is locked 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM logs-entityanalytics_entra_id.device-__namespace__
| WHERE host.id IS NOT NULL
    AND (device.registered_owners.mail IS NOT NULL OR device.registered_owners.id IS NOT NULL OR device.registered_owners.user_principal_name IS NOT NULL)
| EVAL targetEntityId = CONCAT(\\"host:\\", TO_STRING(host.id))
| EVAL mailAndId = CASE(device.registered_owners.mail IS NULL, device.registered_owners.id, device.registered_owners.id IS NULL, device.registered_owners.mail, MV_APPEND(device.registered_owners.mail, device.registered_owners.id))
| EVAL ownerKey = CASE(mailAndId IS NULL, device.registered_owners.user_principal_name, device.registered_owners.user_principal_name IS NULL, mailAndId, MV_APPEND(mailAndId, device.registered_owners.user_principal_name))
| MV_EXPAND ownerKey
| EVAL actorUserId = CONCAT(\\"user:\\", ownerKey, \\"@entra_id\\")
| WHERE COALESCE(actorUserId, \\"\\") != \\"\\"
    AND actorUserId != \\"user:@entra_id\\"
    AND actorUserId RLIKE \\".+:.+@.+\\"
| STATS owns = VALUES(targetEntityId) BY actorUserId
| LIMIT 3500"
`;

