 user_domain_present = CASE(MV_MIN(TO_STRING(user.domain)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.domain))), 1, 1)), MV_MIN(TO_STRING(user.domain))) IS NOT NULL,
 user_name_present_or_null = CASE(user_name_present, CASE(MV_MIN(TO_STRING(user.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.name))), 1, 1)), MV_MIN(TO_STRING(user.name)))),
 host_id_present_or_null = CASE(host_id_present, CASE(MV_MIN(TO_STRING(host.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.id))), 1, 1)), MV_MIN(TO_STRING(host.id)))),
 entity_namespace_present_or_null = CASE(entity_namespace_present, CASE(MV_MIN(TO_STRING(entity.namespace)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(entity.namespace))), 1, 1)), MV_MIN(TO_STRING(entity.namespace)))),
 user_entity_id_present_or_null = CASE(user_entity_id_present, CASE(MV_MIN(TO_STRING(user.entity.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.entity.id))), 1, 1)), MV_MIN(TO_STRING(user.entity.id)))),
 user_email_present_or_null = CASE(user_email_present, CASE(MV_MIN(TO_STRING(user.email)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.email))), 1, 1)), MV_MIN(TO_STRING(user.email)))),
 user_id_present_or_null = CASE(user_id_present, CASE(MV_MIN(TO_STRING(user.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.id))), 1, 1)), MV_MIN(TO_STRING(user.id)))),
 user_domain_present_or_null = CASE(user_domain_present, CASE(MV_MIN(TO_STRING(user.domain)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.domain))), 1, 1)), MV_MIN(TO_STRING(user.domain)))),
 _euid_branch_0_formula = CONCAT(user_name_present_or_null, \\"@\\", host_id_present_or_null, \\"@\\", entity_namespace_present_or_null),
 _euid_branch_0_cond = (CASE(MV_MIN(TO_STRING(entity.namespace)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(entity.namespace))), 1, 1)), MV_MIN(TO_STRING(entity.namespace))) == \\"local\\"),
 _euid_branch_1_formula = COALESCE(CONCAT(user_entity_id_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_email_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_id_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", user_domain_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", entity_namespace_present_or_null)),
 _euid_branch_1_cond = (CASE(MV_MIN(TO_STRING(cloud.provider)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(cloud.provider))), 1, 1)), MV_MIN(TO_STRING(cloud.provider))) == \\"aws\\"),
 _euid_branch_2_formula = COALESCE(CONCAT(user_email_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_id_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", user_domain_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", entity_namespace_present_or_null)),
