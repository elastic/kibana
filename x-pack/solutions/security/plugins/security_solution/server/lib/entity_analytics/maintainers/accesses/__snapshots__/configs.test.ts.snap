 host_name_present_or_null = CASE(host_name_present, CASE(MV_MIN(TO_STRING(host.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.name))), 1, 1)), MV_MIN(TO_STRING(host.name)))),
 host_hostname_present_or_null = CASE(host_hostname_present, CASE(MV_MIN(TO_STRING(host.hostname)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.hostname))), 1, 1)), MV_MIN(TO_STRING(host.hostname)))),
 targetEntityId = CONCAT(\\"host:\\", COALESCE(host_id_present_or_null, host_name_present_or_null, host_hostname_present_or_null))
| MV_EXPAND targetEntityId
| WHERE COALESCE(targetEntityId, \\"\\") != \\"\\"
| STATS access_count = COUNT(*) BY actorUserId, targetEntityId
| EVAL access_type = CASE(
    access_count >= 4, \\"accesses_frequently\\",
    \\"accesses_infrequently\\"
  )
| STATS targets = VALUES(targetEntityId) BY access_type, actorUserId
| STATS
    accesses_frequently = VALUES(targets) WHERE access_type == \\"accesses_frequently\\",
    accesses_infrequently = VALUES(targets) WHERE access_type == \\"accesses_infrequently\\"
