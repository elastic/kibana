 user_domain_present = CASE(MV_MIN(TO_STRING(user.domain)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.domain))), 1, 1)), MV_MIN(TO_STRING(user.domain))) IS NOT NULL,
 user_name_present_or_null = CASE(user_name_present, CASE(MV_MIN(TO_STRING(user.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.name))), 1, 1)), MV_MIN(TO_STRING(user.name)))),
 host_id_present_or_null = CASE(host_id_present, CASE(MV_MIN(TO_STRING(host.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.id))), 1, 1)), MV_MIN(TO_STRING(host.id)))),
 entity_namespace_present_or_null = CASE(entity_namespace_present, CASE(MV_MIN(TO_STRING(entity.namespace)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(entity.namespace))), 1, 1)), MV_MIN(TO_STRING(entity.namespace)))),
 user_entity_id_present_or_null = CASE(user_entity_id_present, CASE(MV_MIN(TO_STRING(user.entity.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.entity.id))), 1, 1)), MV_MIN(TO_STRING(user.entity.id)))),
 user_email_present_or_null = CASE(user_email_present, CASE(MV_MIN(TO_STRING(user.email)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.email))), 1, 1)), MV_MIN(TO_STRING(user.email)))),
 user_id_present_or_null = CASE(user_id_present, CASE(MV_MIN(TO_STRING(user.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.id))), 1, 1)), MV_MIN(TO_STRING(user.id)))),
 user_domain_present_or_null = CASE(user_domain_present, CASE(MV_MIN(TO_STRING(user.domain)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(user.domain))), 1, 1)), MV_MIN(TO_STRING(user.domain)))),
 _euid_branch_0_formula = CONCAT(user_name_present_or_null, \\"@\\", host_id_present_or_null, \\"@\\", entity_namespace_present_or_null),
 _euid_branch_0_cond = (CASE(MV_MIN(TO_STRING(entity.namespace)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(entity.namespace))), 1, 1)), MV_MIN(TO_STRING(entity.namespace))) == \\"local\\"),
 _euid_branch_1_formula = COALESCE(CONCAT(user_entity_id_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_email_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_id_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", user_domain_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", entity_namespace_present_or_null)),
 _euid_branch_1_cond = (CASE(MV_MIN(TO_STRING(cloud.provider)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(cloud.provider))), 1, 1)), MV_MIN(TO_STRING(cloud.provider))) == \\"aws\\"),
 _euid_branch_2_formula = COALESCE(CONCAT(user_email_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_id_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", user_domain_present_or_null, \\"@\\", entity_namespace_present_or_null), CONCAT(user_name_present_or_null, \\"@\\", entity_namespace_present_or_null)),
 actorUserId = CONCAT(\\"user:\\", CASE(_euid_branch_0_cond, _euid_branch_0_formula,
_euid_branch_1_cond, _euid_branch_1_formula,
TRUE, _euid_branch_2_formula, NULL))
| WHERE COALESCE(actorUserId, \\"\\") != \\"\\"
| EVAL host_id_present = CASE(MV_MIN(TO_STRING(host.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.id))), 1, 1)), MV_MIN(TO_STRING(host.id))) IS NOT NULL,
 host_name_present = CASE(MV_MIN(TO_STRING(host.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.name))), 1, 1)), MV_MIN(TO_STRING(host.name))) IS NOT NULL,
 host_hostname_present = CASE(MV_MIN(TO_STRING(host.hostname)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.hostname))), 1, 1)), MV_MIN(TO_STRING(host.hostname))) IS NOT NULL,
 host_id_present_or_null = CASE(host_id_present, CASE(MV_MIN(TO_STRING(host.id)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.id))), 1, 1)), MV_MIN(TO_STRING(host.id)))),
 host_name_present_or_null = CASE(host_name_present, CASE(MV_MIN(TO_STRING(host.name)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.name))), 1, 1)), MV_MIN(TO_STRING(host.name)))),
 host_hostname_present_or_null = CASE(host_hostname_present, CASE(MV_MIN(TO_STRING(host.hostname)) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(TO_STRING(host.hostname))), 1, 1)), MV_MIN(TO_STRING(host.hostname)))),
 targetEntityId = CONCAT(\\"host:\\", COALESCE(host_id_present_or_null, host_name_present_or_null, host_hostname_present_or_null))
| MV_EXPAND targetEntityId
| WHERE COALESCE(targetEntityId, \\"\\") != \\"\\"
| STATS access_count = COUNT(*) BY actorUserId, targetEntityId
| EVAL access_type = CASE(
    access_count >= 4, \\"accesses_frequently\\",
    \\"accesses_infrequently\\"
  )
| STATS targets = VALUES(targetEntityId) BY access_type, actorUserId
| STATS
    accesses_frequently = VALUES(targets) WHERE access_type == \\"accesses_frequently\\",
    accesses_infrequently = VALUES(targets) WHERE access_type == \\"accesses_infrequently\\"
  BY actorUserId
| LIMIT 3500"
`;

exports[`ACCESSES_INTEGRATION_RELATIONSHIP_CONFIGS golden snapshots system_auth: targets-per-actor ES|QL is locked 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM logs-system.auth-__namespace__
| WHERE (MV_CONTAINS(TO_STRING(event.category), \\"authentication\\") OR MV_CONTAINS(TO_STRING(event.category), \\"session\\"))
    AND event.action == \\"ssh_login\\"
    AND event.outcome == \\"success\\"
    AND ((\`user.name\` IS NOT NULL AND CASE(MV_MIN(\`user.name\`) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(\`user.name\`)), 1, 1)), MV_MIN(\`user.name\`)) IS NOT NULL) AND (\`host.id\` IS NOT NULL AND CASE(MV_MIN(\`host.id\`) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(\`host.id\`)), 1, 1)), MV_MIN(\`host.id\`)) IS NOT NULL))
| EVAL actorUserId = CONCAT(\\"user:\\", CASE(MV_MIN(\`user.name\`) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(\`user.name\`)), 1, 1)), MV_MIN(\`user.name\`)), \\"@\\", CASE(MV_MIN(\`host.id\`) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(\`host.id\`)), 1, 1)), MV_MIN(\`host.id\`)), \\"@local\\")
| WHERE COALESCE(actorUserId, \\"\\") != \\"\\"
| EVAL targetEntityId = CONCAT(\\"host:\\", TO_STRING(\`host.id\`))
| MV_EXPAND targetEntityId
| WHERE COALESCE(targetEntityId, \\"\\") != \\"\\"
| STATS access_count = COUNT(*) BY actorUserId, targetEntityId
| EVAL access_type = CASE(
    access_count >= 4, \\"accesses_frequently\\",
    \\"accesses_infrequently\\"
  )
| STATS targets = VALUES(targetEntityId) BY access_type, actorUserId
| STATS
    accesses_frequently = VALUES(targets) WHERE access_type == \\"accesses_frequently\\",
    accesses_infrequently = VALUES(targets) WHERE access_type == \\"accesses_infrequently\\"
  BY actorUserId
| LIMIT 3500"
`;

exports[`ACCESSES_INTEGRATION_RELATIONSHIP_CONFIGS golden snapshots system_security: targets-per-actor ES|QL is locked 1`] = `
"SET unmapped_fields=\\"nullify\\";
FROM logs-system.security-__namespace__
| WHERE event.action IN (\\"logged-in\\", \\"logged-in-explicit\\")
    AND event.code IN (\\"4624\\", \\"4648\\")
    AND winlog.logon.type IN (\\"Interactive\\", \\"RemoteInteractive\\", \\"CachedInteractive\\")
    AND event.outcome == \\"success\\"
    AND NOT user.name IN (\\"SYSTEM\\", \\"LOCAL SERVICE\\", \\"NETWORK SERVICE\\", \\"ANONYMOUS LOGON\\")
    AND ((\`user.name\` IS NOT NULL AND CASE(MV_MIN(\`user.name\`) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(\`user.name\`)), 1, 1)), MV_MIN(\`user.name\`)) IS NOT NULL) AND (\`host.id\` IS NOT NULL AND CASE(MV_MIN(\`host.id\`) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(\`host.id\`)), 1, 1)), MV_MIN(\`host.id\`)) IS NOT NULL))
| EVAL actorUserId = CONCAT(\\"user:\\", CASE(MV_MIN(\`user.name\`) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(\`user.name\`)), 1, 1)), MV_MIN(\`user.name\`)), \\"@\\", CASE(MV_MIN(\`host.id\`) == \\"\\", MV_FIRST(MV_SLICE(MV_SORT(MV_DEDUPE(\`host.id\`)), 1, 1)), MV_MIN(\`host.id\`)), \\"@local\\")
| WHERE COALESCE(actorUserId, \\"\\") != \\"\\"
| EVAL targetEntityId = CONCAT(\\"host:\\", TO_STRING(\`host.id\`))
| MV_EXPAND targetEntityId
| WHERE COALESCE(targetEntityId, \\"\\") != \\"\\"
| STATS access_count = COUNT(*) BY actorUserId, targetEntityId
| EVAL access_type = CASE(
    access_count >= 4, \\"accesses_frequently\\",
    \\"accesses_infrequently\\"
  )
| STATS targets = VALUES(targetEntityId) BY access_type, actorUserId
| STATS
    accesses_frequently = VALUES(targets) WHERE access_type == \\"accesses_frequently\\",
    accesses_infrequently = VALUES(targets) WHERE access_type == \\"accesses_infrequently\\"
  BY actorUserId
| LIMIT 3500"
`;
