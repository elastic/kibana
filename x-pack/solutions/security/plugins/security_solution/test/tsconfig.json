{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    // `jest` is ambient for the whole tree because the fixture unit tests
    // (test/scout_alertzero/**/*.test.ts, run by jest.config.js there) live inside this
    // tsconfig's include glob; a nested tsconfig cannot exclude them from the parent.
    // Scout specs import their own test bindings (eslint scout_expect_import enforces
    // expect imports), so the widened globals don't mask a missing import there.
    "types": ["jest", "node"]
  },
  "include": ["**/*"],
  "exclude": ["target/**/*"],
  "kbn_references": [
    // Scout tests reach into plugin internals via relative imports. The plugin project has to be
    // referenced by path since this directory belongs to the same package as the plugin itself.
    { "path": "../tsconfig.json", "force": true },
    "@kbn/scout-security",
    "@kbn/ai-assistant-common",
    "@kbn/cases-components",
    "@kbn/cases-plugin",
    "@kbn/core-spaces-common",
    "@kbn/elastic-assistant-common",
    "@kbn/entity-store",
    "@kbn/es",
    "@kbn/fleet-plugin",
    "@kbn/ftr-llm-proxy",
    "@kbn/kbn-client",
    "@kbn/management-settings-ids",
    "@kbn/repo-info",
    "@kbn/rule-data-utils",
    "@kbn/security-mitre-attack-common",
    "@kbn/security-solution-features",
    "@kbn/securitysolution-exceptions-common",
    "@kbn/securitysolution-io-ts-list-types",
    "@kbn/securitysolution-list-constants",
    "@kbn/test-es-server",
    "@kbn/tooling-log",
    "@kbn/workflows",
    "@kbn/agent-builder-common",
    "@kbn/core",
    "@kbn/alertzero-common",
    "@kbn/proposals-common",
    "@kbn/evals-suite-attack-discovery-agent-builder",
    "@kbn/deeplinks-security",
    "@kbn/inference-common",
    "@kbn/std"
  ]
}
