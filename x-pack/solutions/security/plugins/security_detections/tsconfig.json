{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "common/**/*",
    "public/**/*",
    "server/**/*",
    // have to declare *.json explicitly due to https://github.com/microsoft/TypeScript/issues/25636
    "server/**/*.json",
    "test/scout_detections_v2/**/*",
    "test/scout_detections_v2_flag_off/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/core-http-server",
    "@kbn/config-schema",
    "@kbn/alerting-v2-plugin",
    "@kbn/alerting-v2-rule-builders",
    "@kbn/alerting-v2-schemas",
    "@kbn/alerting-v2-constants",
    "@kbn/security-detection-rule-schema",
    "@kbn/zod",
    "@kbn/zod-helpers",
    "@kbn/logging-mocks",
    "@kbn/scout-security",
    "@kbn/management-plugin",
    "@kbn/i18n",
    "@kbn/i18n-react",
    "@kbn/react-query"
  ],
  "exclude": ["target/**/*"]
}
