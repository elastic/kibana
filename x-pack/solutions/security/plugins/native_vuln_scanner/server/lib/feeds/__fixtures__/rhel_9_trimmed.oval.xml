  <title>RHSA-2023:2654: nodejs:18 security, bug fix, and enhancement update (Moderate)</title>
  <affected family="unix">
   <platform>Red Hat Enterprise Linux 9</platform>
  </affected>
  <reference ref_id="RHSA-2023:2654" ref_url="https://access.redhat.com/errata/RHSA-2023:2654" source="RHSA"/>
