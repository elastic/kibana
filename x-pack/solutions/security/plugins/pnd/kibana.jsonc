{
  "type": "plugin",
  "id": "@kbn/pnd-plugin",
  "owner": ["@elastic/security-solution"],
  "group": "security",
  "visibility": "private",
  "description": "PND Security Watch investigation queue and catalog",
  "plugin": {
    "id": "pnd",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "pnd"],
    "requiredPlugins": ["agentBuilder", "features", "workflowsExtensions", "workflowsManagement"],
    "optionalPlugins": ["spaces"],
    "requiredBundles": ["kibanaReact"]
  }
}
