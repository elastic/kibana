{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "index.ts",
    "common/**/*.ts",
    "public/**/*.ts",
    "public/**/*.tsx",
    "server/**/*.ts",
    "test/scout/**/*",
    "../../../../../typings/**/*",
  ],
  "exclude": [
    "target/**/*"
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/serverless",
    "@kbn/config-schema",
    "@kbn/core-security-server",
    "@kbn/content-management-favorites-common",
    "@kbn/content-management-favorites-public",
    "@kbn/core-user-profile-browser-mocks",
    "@kbn/serverless-vectordb-settings",
    "@kbn/i18n-react",
    "@kbn/kibana-react-plugin",
    "@kbn/share-plugin",
    "@kbn/console-plugin",
    "@kbn/core-chrome-browser",
    "@kbn/cloud-plugin",
    "@kbn/shared-components",
    "@kbn/shared-ux-router",
    "@kbn/agent-builder-plugin",
    "@kbn/agent-builder-server",
    "@kbn/search-agent",
    "@kbn/vectordb-onboarding",
    "@kbn/react-query",
    "@kbn/i18n",
    "@kbn/core-application-browser",
    "@kbn/deeplinks-management",
    "@kbn/ai-assistant-common",
    "@kbn/management-settings-ids",
    "@kbn/alerting-v2-utils",
    "@kbn/deeplinks-workflows",
    "@kbn/data-views-plugin",
    "@kbn/navigation-plugin",
    "@kbn/announcement-banner",
    "@kbn/shared-ux-ai-components",
    "@kbn/custom-icons",
    "@kbn/deeplinks-vectordb",
    "@kbn/core-security-common",
    "@kbn/core-http-browser-mocks",
    "@kbn/features-plugin",
    "@kbn/scout",
    "@kbn/deeplinks-analytics",
    "@kbn/index-management-shared-types",
    "@kbn/discover-plugin",
  ]
