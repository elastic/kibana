{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "index.ts",
    "public/**/*.ts",
    "public/**/*.tsx",
    "server/**/*.ts",
    "../../../typings/**/*"
  ],
  "exclude": [
    "target/**/*",
  ],
  "kbn_references": [
    "@kbn/core",
    "@kbn/data-plugin",
    "@kbn/lens-plugin",
    "@kbn/lens-common",
    "@kbn/lens-embeddable-utils",
    "@kbn/developer-examples-plugin",
    "@kbn/esql-utils",
    "@kbn/expressions-plugin",
    "@kbn/react-kibana-context-render",
    "@kbn/ui-callout",
  ]
}
