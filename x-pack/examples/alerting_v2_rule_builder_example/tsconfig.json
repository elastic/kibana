{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types"
  },
  "include": [
    "index.ts",
    "common/**/*.ts",
    "public/**/*.ts",
    "public/**/*.tsx",
    "server/**/*.ts",
    "../../../typings/**/*"
  ],
  "exclude": ["target/**/*"],
  "kbn_references": [
    "@kbn/core",
    "@kbn/i18n",
    "@kbn/zod",
    "@kbn/esql",
    "@kbn/alerting-v2-plugin",
    "@kbn/alerting-v2-rule-builders",
    "@kbn/alerting-v2-rule-form"
  ]
}
