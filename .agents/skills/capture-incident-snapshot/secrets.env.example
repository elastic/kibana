# capture-incident-snapshot — credentials
# =============================================================================
# Copy this file to `secrets.env` (gitignored) and fill in the values, then
# source it before running the skill:
#
#   source .agents/skills/capture-incident-snapshot/secrets.env
#
# Never commit real keys. Slack access is NOT here — it is the Slack MCP (OAuth),
# connected via Cursor's MCP auth, not an env var.
# =============================================================================

# --- Overview cluster: where the incident LOGS live (remote reindex source) --
# Scoped, read-only API key. For the capture-incident remote reindex it must
# have BOTH cluster:["monitor"] AND read on the log index pattern (see the
# capture-incident README for the exact _security/api_key body).
export OVERVIEW_ES_URL="https://<host>.<region>.aws.found.io:443"
export OVERVIEW_ES_API_KEY="<base64 Overview api key>"

# --- Incident-data cluster: rootly_incidents metadata (title/summary/RCA URL) -
# Different cluster from Overview. Read access to rootly_incidents.
export ROOTLY_ES_URL="https://<host>.<region>.gcp.cloud.es.io:443"
export ROOTLY_ES_API_KEY="<base64 rootly api key>"

# --- Local Kibana: the kibana-api skill target ------------------------------
export KIBANA_URL="http://localhost:5601"
export KIBANA_AUTH="elastic:changeme"

# --- Local Elasticsearch snapshot target ------------------------------------
# Used as capture-incident --es-url when the snapshot is captured.
export LOCAL_ES_URL="http://elastic:changeme@localhost:9200"

# --- GCS service-account credentials ----------------------------------------
# ABSOLUTE path — loaded into the local ES keystore at ES startup via
# --secure-files gcs.client.default.credentials_file=$GCS_CREDENTIALS_FILE
export GCS_CREDENTIALS_FILE="/absolute/path/to/gcs-credentials.json"

