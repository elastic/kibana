#!/bin/bash
set -e

echo "Checking system dependencies..."

# Node.js via nvm
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
else
  echo "Error: nvm is not installed. Install it from https://github.com/nvm-sh/nvm"
  exit 1
fi

REQUIRED_NODE="$(cat .node-version)"
CURRENT_NODE="$(node --version 2>/dev/null | sed 's/^v//' || echo "none")"

if [ "$CURRENT_NODE" != "$REQUIRED_NODE" ]; then
  echo "Installing Node.js $REQUIRED_NODE via nvm..."
  nvm install "$REQUIRED_NODE"
fi
nvm use "$REQUIRED_NODE"
echo "Node $(node --version) OK"

# Yarn
if ! command -v yarn &>/dev/null; then
  echo "Installing yarn..."
  npm install -g yarn
fi
echo "Yarn $(yarn --version) OK"

echo "System dependencies verified."

echo "Running initial Kibana bootstrap (this may take a few minutes)..."
yarn kbn bootstrap
echo "Bootstrap complete."
