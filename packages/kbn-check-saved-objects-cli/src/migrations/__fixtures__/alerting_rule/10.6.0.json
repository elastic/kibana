{
  "10.5.0": [
    {
      "kind": "alert",
      "metadata": {
        "name": "composed rule recovering on a condition",
        "description": "a test alerting v2 rule",
        "tags": [
          "test"
        ],
        "version": 1
      },
      "time_field": "@timestamp",
      "schedule": {
        "every": "1m",
        "lookback": "5m"
      },
      "recovery_strategy": "query",
      "no_data_strategy": "last_known_status",
      "query": {
        "format": "composed",
        "base": "FROM metrics-* | STATS avg_cpu = AVG(system.cpu.total.norm.pct) BY host.name",
        "breach": {
          "segment": "WHERE avg_cpu > 0.85"
        },
        "recovery": {
          "segment": "WHERE avg_cpu < 0.60"
        }
      },
      "state_transition": {
        "pending_count": 3,
        "pending_timeframe": "5m",
        "pending_operator": "AND",
        "recovering_count": 2,
        "recovering_timeframe": "10m",
        "recovering_operator": "OR"
      },
      "grouping": {
        "fields": [
          "host.name"
        ]
      },
      "enabled": true,
      "createdBy": "elastic",
      "updatedBy": "elastic",
      "createdAt": "2025-01-01T00:00:00.000Z",
      "updatedAt": "2025-01-01T00:00:00.000Z"
    },
