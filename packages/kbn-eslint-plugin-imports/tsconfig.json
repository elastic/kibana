{
  "extends": "@kbn/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "target/types",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "oxlint_plugin.js",
    "src/**/*.mjs"
  ],
  "kbn_references": [
    "@kbn/import-resolver",
    "@kbn/repo-source-classifier",
    "@kbn/repo-info",
    "@kbn/repo-packages",
    "@kbn/projects-solutions-groups",
    "@kbn/swc-register",
  ],
  "exclude": [
    "target/**/*",
  ]
}
