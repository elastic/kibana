import { z, lazySchema } from '@kbn/zod/v4';
import type { ConnectorSpec } from '../../connector_spec';

/**
 * GitHub team that owns this connector. Read by `generate_connector_registries.ts` to keep
 * `.github/CODEOWNERS` in sync — do not remove.
 */
export const OWNER = '<%= connector.owner %>';

export const <%= connector.className %>: ConnectorSpec = {
  metadata: {
    id: '<%= connector.id %>',
    displayName: '<%= connector.displayName %>',
    description: '',
    minimumLicense: 'basic',
    supportedFeatureIds: ['workflows', 'agentBuilder'],
  },
  schema: lazySchema(() => z.object({})),
  actions: {},
  test: {
    // enabled must be explicitly set to true, otherwise the "Test connector"
    // button stays disabled in the UI even though a handler is defined.
    enabled: true,
    handler: async () => ({ ok: true }),
  },
};


