exports[`pull_request fragments pull_request/agent_builder_smoke_tests 1`] = `
{
  "steps": [
    {
      "depends_on": [
        "build",
      ],
      "group": "Agent Builder Smoke Tests",
      "key": "agent-builder-smoke-tests",
      "steps": [
        {
          "agents": {
            "machineType": "n2-standard-2",
            "preemptible": true,
            "spotZones": "us-central1-f,us-central1-c,us-central1-b,us-central1-a",
          },
          "artifact_paths": [
            "target/eis_models.json",
          ],
          "command": ".buildkite/scripts/steps/test/discover_eis_models.sh",
          "env": {
            "FTR_EIS_CCM": "1",
          },
          "key": "discover-eis-models",
          "label": "🔍 Discover EIS Models",
          "retry": {
            "automatic": [
              {
                "exit_status": -1,
                "limit": 3,
              },
              {
                "exit_status": "*",
                "limit": 1,
              },
            ],
          },
          "timeout_in_minutes": 10,
        },
        {
          "agents": {
            "machineType": "n2-standard-4",
            "preemptible": true,
            "spotZones": "us-central1-f,us-central1-c,us-central1-a",
          },
          "artifact_paths": [
            "target/llm_smoke_judgements.jsonl",
          ],
          "command": "mkdir -p target
buildkite-agent artifact download 'target/eis_models.json' . --step discover-eis-models || echo '{"models":[]}' > target/eis_models.json
.buildkite/scripts/steps/test/scout/configs.sh
.buildkite/scripts/steps/test/annotate_llm_smoke_judgements.sh
",
          "depends_on": "discover-eis-models",
          "env": {
            "FTR_EIS_CCM": "1",
            "FTR_GEN_AI": "1",
            "SCOUT_CONFIG": "x-pack/platform/plugins/shared/agent_builder/test/scout_agent_builder_smoke/api/playwright.config.ts",
            "SCOUT_CONFIG_GROUP_TYPE": "scout-agent-builder-smoke-tests",
            "SCOUT_SERVER_RUN_FLAGS": "--arch stateful --domain classic",
          },
          "key": "scout-agent-builder-smoke-tests",
          "label": "Agent Builder Scout Smoke Tests",
          "parallelism": 1,
          "retry": {
            "automatic": [
              {
                "exit_status": -1,
                "limit": 3,
              },
              {
                "exit_status": "*",
                "limit": 1,
              },
            ],
          },
          "timeout_in_minutes": 50,
        },
      ],
    },
  ],
}
`;

